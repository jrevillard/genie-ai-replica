# Hugo build output
/public/
/resources/_gen/
/.hugo_build.lock

# Doc content copied at build time by scripts/sync-docs.sh.
# Source of truth is the repo-root docs/; this dir is regenerated, never committed.
# Ignore all copied files but KEEP the authored section landing (_index.md) committed.
/content/en/docs/*
!/content/en/docs/_index.md

# Generated by hugo mod on first build (tracked separately via go.mod / go.sum)
# Leave go.mod and go.sum committed; ignore only the module cache.
/_vendor/

# Node tooling installed by Docsy's PostCSS pipeline on first build
/node_modules/
/package.json
/package-lock.json
/hugo_stats.json

# OS / editor noise
.DS_Store
*.swp
