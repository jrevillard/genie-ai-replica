# Minimal boot set for the dev compose stack (components/docker-compose.yaml):
#   cp document-repository/.env.example document-repository/.env   # then fill CHANGE_ME
# Full production reference: deploy/ansible/templates/env.j2 (Ansible-rendered).

# ArangoDB (URL/db-name defaults in code point elsewhere — set both)
ARANGO_URL=http://arango-vector-db:8529
ARANGO_DB_NAME=genie-ai
ARANGO_USERNAME=root
ARANGO_PASSWORD=CHANGE_ME

# Keycloak (JWKS verification; dev compose runs no keycloak — a local/dev realm
# is the natural target. Point at the PRODUCTION realm only if you mean it:
# approval flows and client secrets then hit prod.)
KEYCLOAK_URL=CHANGE_ME                 # e.g. https://agriconnect.site/auth — prod, deliberately
KC_REALM=agrivisory
KC_CLIENT_ID=itu-agrivisory-client

# HTTP
PORT=3001

# Uploads (compose mounts the doc_repo_uploads volume at /app/uploads)
UPLOAD_DIR=/app/uploads

# ClamAV (dev compose service name is 'clamav'; code default host is 127.0.0.1 — wrong here)
VIRUS_SCANNING=true
CLAMSCAN_ACTIVE=true
CLAMSCAN_HOST=clamav
CLAMSCAN_PORT=3310

# Dataprep (ingest/retract target — code default is an external IP, override it.
# The dev stack runs NO dataprep service: set the deployed box's URL, or expect
# ingest/retract calls to fail locally.)
DATAPREP_HOST=CHANGE_ME
DATAPREP_PORT=6007
