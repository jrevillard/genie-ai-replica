# Inventory with real host IPs
inventory/*.ini
inventory/*.yml
!inventory.example

# Vault unencrypted files (never commit unencrypted secrets)
*.vault.unencrypted

# Vault password files
.vault-pass-*

# SSL certificates (secrets)
files/certificates/**/*.crt
files/certificates/**/*.key
!files/certificates/README.md

# Ansible retry files
*.retry

# OS files
.DS_Store
