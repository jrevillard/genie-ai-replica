    "Are you sure you want to leave? Any unsaved changes will be lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد أنك تريد المغادرة؟ ستفقد أي تغييرات غير محفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du gehen möchtest? Ungespeicherte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to leave? Any unsaved changes will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que deseas salir? Los cambios no guardados se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir quitter ? Les modifications non enregistrées seront perdues."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda yakin ingin pergi? Perubahan yang belum disimpan akan hilang."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja sair? Quaisquer alterações não salvas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите уйти? Несохраненные изменения будут потеряны."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una uhakika unataka kuondoka? Mabadiliko yoyote ambayo hayajahifadhiwa yatapotea."
