{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI Chatbot"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Configuration for quick help buttons in the chat interface",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable or disable quick help buttons",
                  "default": true
                },
                "buttons": {
                  "type": "array",
                  "description": "List of quick help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button",
                        "pattern": "^[a-zA-Z0-9_-]+$"
                      },
                      "title": {
                        "type": "string",
                        "description": "Display title for the button (or translation key)",
                        "minLength": 1
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file"
                            ],
                            "description": "Type of icon source (only file-based SVG supported)",
                            "default": "file"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file relative to public/config",
                            "minLength": 1,
                            "pattern": "^/config/quickhelp/[^/]+\\.svg$"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Top-level category ID associated with the button (null for no category)",
                        "minLength": 1
                      },
                      "prompt": {
                        "type": "string",
                        "description": "Initial prompt sent when the button is clicked (or translation key)",
                        "minLength": 1
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color for the button",
                            "pattern": "^#([0-9a-fA-F]{3}){1,2}$|^rgb\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\)$"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Background color on hover",
                            "pattern": "^#([0-9a-fA-F]{3}){1,2}$|^rgb\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\)$"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color for the button",
                            "pattern": "^#([0-9a-fA-F]{3}){1,2}$|^rgb\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\)$"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "prompt",
                      "styles"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "enabled",
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Huduma AI",
    "icon": {
      "type": "file",
      "value": "/config/huduma-icon.svg"
    }
  },
  "theme": {
    "primaryColor": "#4E97D1",
    "secondaryColor": "#2C5F8A",
    "backgroundColor": "#f5f7fa",
    "textColor": "#333333",
    "navbar": {
      "gradientStart": "#4E97D1",
      "gradientEnd": "#2C5F8A",
      "textColor": "#ffffff"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to Huduma AI, your public service assistant!",
      "botName": "Huduma",
      "quickHelp": {
        "enabled": true,
        "buttons": [
          {
