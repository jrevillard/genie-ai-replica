# GPU Configuration for NVIDIA RTX 6000 Ada (48GB VRAM)
# Usage: docker compose --env-file .env --env-file env.rtx6000 up
#
# Corrected against the deployed GPU node, which runs ibm-granite/granite-4.1-8b
# on a 48GB RTX 6000 Ada. The previous values here described a 24GB card
# (VLLM_MAX_MODEL_LEN=4096, VLLM_MAX_NUM_SEQS=1024) and were both wrong for it:
# the window was ~16x smaller than the hardware allows, and 1024 concurrent
# sequences would exhaust the KV cache outright.

# ========= Main LLM (vllm) — 48GB, granite-4.1-8b =========
# VRAM budget at 0.55 utilization of 48GB (~26.4GB usable):
#   weights at half precision            ~16 GB
#   KV cache for 65536 tokens            ~8 GB   (8B model, ~0.125 MB/token)
#   headroom for activations + batching   ~2 GB
#
# Raising the window past 65536 does NOT fit here: 131072 tokens would need
# ~16GB of KV cache against ~10GB available, and vLLM fails at startup rather
# than degrading. If you move to a larger card, raise VLLM_MAX_MODEL_LEN there
# and the Contextual Retrieval document budget follows the window the endpoint
# actually serves (discovered at runtime), so dataprep picks it up on its own.
# The OKF concept-document ceiling is a literal, though: raise it by hand.
VLLM_GPU_UTILIZATION=0.55
VLLM_MAX_MODEL_LEN=65536
# 16 is what the node runs under concurrent labelling load. The KV cache is the
# binding constraint, not compute: more sequences means a smaller window.
VLLM_MAX_NUM_SEQS=16

# ========= Translation LLM (vllm-translation-guardrail) =========
# Shares the same GPU with the main model, so it gets a smaller share.
VLLM_TRANSLATION_GPU_UTILIZATION=0.4
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_MAX_NUM_SEQS=32

# ========= Concept document ceiling =========
# Left unset on purpose: okf-server defaults it to 250000 (~the budget
# dataprep derives from the 65536-token window above for the Contextual
# Retrieval document context). Neither side derives it from an env copy any
# more — dataprep discovers the served window at runtime — so the ceiling
# stays a literal that has to be kept in step BY HAND when the window
# changes. That hand-stepping is how the corpus ended up with 57% of its
# documents silently truncated.
# OKF_MAX_CONCEPT_DOC_CHARS=250000