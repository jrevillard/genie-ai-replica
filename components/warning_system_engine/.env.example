# ArangoDB connection (shared with weather-mcp-service)
ARANGO_URL=http://arango-vector-db:8529
ARANGO_DB_NAME=genie-ai
ARANGO_USER=root
ARANGO_PASSWORD=test

# ── Copernicus CDS (long-term pipeline) ─────────────────────────────────────
# Register at https://cds.climate.copernicus.eu to get your API key.
# Leave blank to run short-term only; long-term pipeline is silently skipped.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=""           # format: <uid>:<api-key>  or new-format: <api-key>

# How many months ahead to fetch from Copernicus (max 6, default 5)
COPERNICUS_MONTHS_AHEAD=5

# ── Notification channels ────────────────────────────────────────────────────
# All optional — channels are skipped gracefully if key is absent.
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
EMERGENCY_CONTACT_NUMBERS=
EMERGENCY_TWIML_URL=
BROADCAST_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
