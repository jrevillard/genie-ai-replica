{
  "name": "chatbot-analytics-backend",
  "version": "1.0.0",
  "description": "Backend services for chatbot analytics with ArangoDB",
  "main": "index.js",
  "scripts": {
    "setup-db": "node setup-db.js",
    "init-categories": "node init-service-categories.js",
    "setup-all": "node setup-all.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:contract": "jest --testPathPattern='__tests__/routes/'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "^winston$": "<rootDir>/node_modules/winston",
      "^winston-daily-rotate-file$": "<rootDir>/node_modules/winston-daily-rotate-file",
      "^@opentelemetry/api$": "<rootDir>/node_modules/@opentelemetry/api"
    },
    "collectCoverageFrom": [
      "routes/**/*.js",
      "services/**/*.js",
      "middleware/**/*.js",
      "controllers/**/*.js",
      "config/**/*.js",
      "../../shared/lib/logger.js",
      "!**/node_modules/**",
      "!**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 35,
        "branches": 30,
        "functions": 35,
        "lines": 35
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "jest-backend.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}",
          "ancestorSeparator": " › ",
          "usePathForSuiteName": true
        }
      ]
    ]
  },
  "dependencies": {
    "@google-cloud/translate": "^9.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@xenova/transformers": "^2.17.2",
    "arangojs": "^8.8.1",
    "async-retry": "^1.3.3",
    "axios": "^1.10.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-winston": "^4.2.0",
    "form-data": "^4.0.2",
    "fs": "^0.0.1-security",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.0.0",
    "inquirer": "^12.9.2",
    "ioredis": "^5.8.2",
    "joi": "^17.9.2",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "onnxruntime-web": "^1.23.0",
    "path": "^0.12.7",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "uuid": "^9.0.0",
    "validator": "^13.15.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "jest": "^29.5.0",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3"
  }
}
