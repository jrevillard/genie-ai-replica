# ─────────────────────────────────────────────────────────────────────────────
# Amina Care — Meta channel credentials
# ─────────────────────────────────────────────────────────────────────────────
#
# Append the lines below to haystack-stack/.env so the haystack-chatqna
# container picks them up via its `env_file: .env` directive. The
# meta_bridge.py module reads them with os.getenv(...) at request time.
#
# Any channel whose *_ACCESS_TOKEN (or PAGE_ACCESS_TOKEN) is empty is
# skipped silently — the rest of the stack keeps working. That means you
# can enable WhatsApp first, Messenger later, without code changes.
#
# Signature verification is skipped when *_APP_SECRET is empty, which is
# useful for the UNICC showcase / dev-mode demos. For production you MUST
# set the app secrets so Meta-signed webhooks are validated.
# ─────────────────────────────────────────────────────────────────────────────

# ── WhatsApp Business Cloud API ─────────────────────────────────────────────
# From developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=amina_health_2026
WHATSAPP_APP_SECRET=

# ── Facebook Messenger Platform ─────────────────────────────────────────────
# From developers.facebook.com → Your App → Messenger → Settings → Access Tokens
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=amina_health_2026
MESSENGER_APP_SECRET=

# ── Graph API version (shared) ──────────────────────────────────────────────
# Only set if you need to pin to an older version. Default = v19.0.
META_GRAPH_VERSION=v19.0

# ─────────────────────────────────────────────────────────────────────────────
# Frontend "Talk to us" widget handles (VITE_ vars, consumed by index.html)
# Put these in components/frontend/.env.local or whichever Vite env file you use
# ─────────────────────────────────────────────────────────────────────────────

# WhatsApp business number in E.164 WITHOUT the leading "+"
# e.g. "220999xxxxx" for Gambia, "919xxxxxxxxx" for India
VITE_AMINA_WHATSAPP_NUMBER=

# Facebook Page username — used to build https://m.me/<handle>
VITE_AMINA_MESSENGER_HANDLE=

# Telegram bot username — used to build https://t.me/<handle>
VITE_AMINA_TELEGRAM_HANDLE=AminaCareBot
