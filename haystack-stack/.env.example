# ============================================
# AMINA Environment Configuration — TEAM template
# ============================================
#
# UNICC TESTERS / EVALUATORS:
#   You do NOT need this file. Just run from the repo root:
#     PowerShell: .\start.ps1
#     Bash:       ./start.sh
#   Demo defaults (in haystack-stack/.env.defaults) are used
#   automatically.
#
# TEAM DEVELOPERS (real API keys):
#   1. cp haystack-stack/.env.example haystack-stack/.env
#   2. Fill in real values below
#   3. Run .\start.ps1 from the repo root
#   4. NEVER commit your .env file (gitignored + pre-commit hook)
#
# ============================================

# === API service ports ===
API_HOST=0.0.0.0
API_PORT=8000
DATAPREP_PORT=8001

# === LLM (required for full functionality) ===
GOOGLE_API_KEY=CHANGE_ME_OR_LEAVE_DISABLED
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_DISABLED
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=

# === ArcadeDB ===
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DB=genie
ARCADEDB_USER=root
ARCADEDB_PASSWORD=CHANGE_ME
ARCADEDB_ROOT_PASSWORD=CHANGE_ME

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Auth ===
AMINA_ENV=development
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_STRING_AT_LEAST_32_BYTES
JWT_EXPIRY_HOURS=168
OTP_DEV_MODE=true

# === Admin (the API hashes neither today — change defaults) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# === Voice (local containers — no external creds) ===
WHISPER_URL=http://voice-stt:8080
TTS_URL=http://voice-tts:5500
MMS_TTS_URL=http://voice-tts-mnk:5500

# === Translator backend ===
USE_GEMMA_TRANSLATOR=false
GEMMA_BASE_URL=http://vllm-translation-guardrail:9031/v1
GEMMA_MODEL=google/gemma-3-4b-it
GEMMA_API_KEY=not-needed

# === Channels (optional — leave 'disabled' if not in use) ===
TELEGRAM_BOT_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
META_APP_SECRET=CHANGE_ME_OR_LEAVE_DISABLED
META_VERIFY_TOKEN=amina_health_2026
META_PAGE_ACCESS_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
META_APP_ID=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_ACCOUNT_SID=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_AUTH_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_PHONE_NUMBER=CHANGE_ME_OR_LEAVE_DISABLED

# === DHIS2 (optional) ===
DHIS2_BASE_URL=CHANGE_ME_OR_LEAVE_DISABLED
DHIS2_USERNAME=CHANGE_ME_OR_LEAVE_DISABLED
DHIS2_PASSWORD=CHANGE_ME_OR_LEAVE_DISABLED

# === Superset ===
SUPERSET_SECRET_KEY=CHANGE_ME
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# === Production-blocked dev bypass flags (must be false in prod) ===
CHATQNA_ADMIN_MV_OPEN=false
CARE_TRUST_BODY_ROLE=false
DHIS2_DEV_ADMIN_BYPASS=false

# === Feature flags ===
AMINA_AGENTIC_MODE=assist
AMINA_AGENTIC_FAIL_OPEN=true
AMINA_TRANSLATION_V4_ENABLED=false
AMINA_CAREGIVER_PRIVACY_REQUIRED=false

DEMO_MODE=false
