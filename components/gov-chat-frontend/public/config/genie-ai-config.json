{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with dual-prompt mechanism for quick help buttons",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations with dual-prompt mechanism",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "i18n key for text user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "i18n key for detailed prompt sent to LLM"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "action",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "GENIE.AI",
    "icon": {
      "type": "file",
      "value": "/config/genie-ai-icon-light.svg"
    }
  },
  "theme": {
    "primaryColor": "#4682B4",
    "secondaryColor": "#5F9EA0",
    "backgroundColor": "#D3E0EA",
    "textColor": "#1C2526",
    "navbar": {
      "gradientStart": "#4682B4",
      "gradientEnd": "#5F9EA0",
      "textColor": "#F0F8FF"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome! I'm MEWA, your agricultural early warning assistant for Bangladesh. How can I help you today?",
      "botName": "GENIE.AI",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "action": {
              "visibleText": "quickhelp.justChatUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. Be friendly, helpful, and knowledgeable about Bangladesh agriculture, weather patterns, crop management, pest risks, and early warning systems. Your primary strength is helping farmers and citizens understand weather conditions and their impact on agricultural activities. Always refer to the application as 'MEWA'."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "identity-civil",
            "title": "quickhelp.applyForID",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/identity-civil.svg"
            },
            "category": "1",
            "action": {
              "visibleText": "quickhelp.applyForIDUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking about weather forecasts. Help them understand the current and upcoming weather conditions for their district and how it may affect their farming activities. If they mention a district name, focus on that area."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "taxes-revenue",
            "title": "quickhelp.payTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/taxes-revenue.svg"
            },
            "category": "2",
            "action": {
              "visibleText": "quickhelp.payTaxesUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking about extreme weather or flood alerts. Provide clear, actionable information about severe weather events such as floods, cyclones, heavy rainfall, or storms. Advise on protective actions for crops and personal safety."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "business-trade",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-trade.svg"
            },
            "category": "4",
            "action": {
              "visibleText": "quickhelp.startBusinessUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking about crop management advice. Provide practical guidance on crop selection, planting schedules, fertilization, irrigation, and pest management based on the current season and regional weather patterns in Bangladesh."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "healthcare-social",
            "title": "quickhelp.findHealthcare",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/healthcare-social.svg"
            },
            "category": "3",
            "action": {
              "visibleText": "quickhelp.findHealthcareUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking about crop alert thresholds. Explain the specific meteorological and soil conditions that trigger warnings for major Bangladesh crops such as rice, wheat, jute, and vegetables. Describe what protective actions farmers should take when thresholds are exceeded."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "education-learning",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": "5",
            "action": {
              "visibleText": "quickhelp.educationServicesUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking about geospatial risk profiles. Explain flood-prone zones, cyclone-risk corridors, drought-susceptible areas, and how geographic location affects agricultural risk in Bangladesh districts."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "transportation-mobility",
            "title": "quickhelp.transportLicenses",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/transportation-mobility.svg"
            },
            "category": "6",
            "action": {
              "visibleText": "quickhelp.transportLicensesUserPrompt",
              "hiddenPrompt": "You are MEWA, an agricultural early warning assistant for Bangladesh. The user is asking for general agricultural reference information. Provide factual, practical information about Bangladesh agriculture, including crop calendars, common pests and diseases, soil types, and best practices for smallholder farmers."
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          }
        ]
      }
    }
  },
  "custom": {}
}
