# Hugo build output
/public/
/resources/_gen/
/.hugo_build.lock

# Docs are curated + committed directly under content/en/docs/ (no build-time copy).

# Generated by hugo mod on first build (tracked separately via go.mod / go.sum)
# Leave go.mod and go.sum committed; ignore only the module cache.
/_vendor/

# Node tooling installed by Docsy's PostCSS pipeline on first build
/node_modules/
/package.json
/package-lock.json
/hugo_stats.json

# OS / editor noise
.DS_Store
*.swp
