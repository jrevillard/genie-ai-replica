# AMINA v2 fine-tuned model — served by vLLM on the A40 GPU,
# exposed via Tailscale Funnel (stable hostname, free, survives reboots).
# Toggle USE_FINETUNED_MODEL=true to switch the agent from gpt-4o-mini
# to the fine-tuned model. Leave commented to keep production on gpt-4o-mini.
# Groq — free API key from console.groq.com
GROQ_API_KEY=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
MISTRAL_API_KEY=

# Admin + Gov materialized-view dashboards — dev-only open mode.
# Lets the new /admin/console and /gov dashboards render without
# requiring a signed admin JWT. SET TO false BEFORE DEPLOYING.
CHATQNA_ADMIN_MV_OPEN=true

# Care-routes dev escape hatch — lets the floating RoleSwitcher actually
# work for supply/care-path writes in local dev. With this true, the
# backend trusts the body's `role` claim and ignores the JWT's role.
# SET TO false BEFORE DEPLOYING — any patient could otherwise self-
# promote to admin by sending {"role":"admin"} in the body.
CARE_TRUST_BODY_ROLE=true

# DHIS2 admin gate dev bypass — lets Test connection / Dry run / Push /
# Refresh in the IntegrationsWorkspace + Dhis2SyncPanel work without
# admin login in local dev. With this true, every /api/v1/dhis2/*
# endpoint accepts unauthenticated requests as if they were admin.
# SET TO false BEFORE DEPLOYING — DHIS2 talks to a real external MoH
# system and exposes write/push endpoints; admin auth is intentional.
DHIS2_DEV_ADMIN_BYPASS=true

AMINA_MODEL_URL=https://roads-converter-fragrance-tract.trycloudflare.com/v1
AMINA_MODEL_NAME=models/amina-v2-final
USE_FINETUNED_MODEL=true

