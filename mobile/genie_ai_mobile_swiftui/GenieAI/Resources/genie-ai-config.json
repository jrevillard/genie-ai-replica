{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with a darker light blue theme inspired by ITU website banner",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#5B9FD6"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#7DBFB8"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#5B9FD6"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#7DBFB8"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button panel configurations",
              "properties": {
                "layout": {
                  "type": "object",
                  "description": "Grid system for buttons",
                  "properties": {
                    "columns": {
                      "type": "integer",
                      "default": 2
                    },
                    "gapX": {
                      "type": "string",
                      "default": "10px"
                    },
                    "gapY": {
                      "type": "string",
                      "default": "10px"
                    },
                    "childAspectRatio": {
                      "type": "number",
                      "default": 3.5
                    }
                  }
                },
                "defaults": {
                  "type": "object",
                  "description": "Base styles inherited by all buttons",
                  "properties": {
                    "height": {
                      "type": "string"
                    },
                    "fontSize": {
                      "type": "string"
                    },
                    "borderRadius": {
                      "type": "string"
                    },
                    "showShadow": {
                      "type": "boolean"
                    },
                    "shadow": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "color": {
                          "type": "string"
                        },
                        "blur": {
                          "type": "string"
                        },
                        "opacity": {
                          "type": "number"
                        }
                      }
                    },
                    "showBorder": {
                      "type": "boolean"
                    }
                  }
                },
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier"
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Optional category grouping"
                      },
                      "action": {
                        "type": "object",
                        "description": "The 2-prompt mechanism",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "What user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "What LLM sees"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      },
                      "appearance": {
                        "type": "object",
                        "description": "Visual configuration",
                        "properties": {
                          "label": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "color": {
                                "type": "string"
                              }
                            }
                          },
                          "icon": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "color": {
                                "type": "string"
                              }
                            }
                          },
                          "style": {
                            "type": "object",
                            "properties": {
                              "background": {
                                "type": "object",
                                "properties": {
                                  "gradient": {
                                    "type": "object",
                                    "properties": {
                                      "start": {
                                        "type": "string"
                                      },
                                      "end": {
                                        "type": "string"
                                      },
                                      "direction": {
                                        "type": "string",
                                        "enum": [
                                          "horizontal",
                                          "vertical",
                                          "diagonal"
                                        ]
                                      }
                                    }
                                  }
                                }
                              },
                              "border": {
                                "type": "object",
                                "properties": {
                                  "enabled": {
                                    "type": "boolean"
                                  }
                                }
                              },
                              "shadow": {
                                "type": "object",
                                "properties": {
                                  "enabled": {
                                    "type": "boolean"
                                  }
                                }
                              }
                            }
                          },
                          "darkMode": {
                            "type": "object",
                            "description": "Overrides for dark mode",
                            "properties": {
                              "label": {
                                "type": "object"
                              },
                              "icon": {
                                "type": "object"
                              },
                              "style": {
                                "type": "object"
                              }
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "id",
                      "action"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Genie AI",
    "icon": {
      "type": "file",
      "value": "/config/genie-ai-icon-light.svg"
    }
  },
  "theme": {
    "primaryColor": "#5B9FD6",
    "secondaryColor": "#7DBFB8",
    "backgroundColor": "#D3E0EA",
    "textColor": "#1C2526",
    "navbar": {
      "gradientStart": "#5B9FD6",
      "gradientEnd": "#7DBFB8",
      "textColor": "#F0F8FF"
    }
  },
