              "outlineColor": "#a5f3fc"
            }
          },
          {
            "id": "employment-labor",
            "title": "quickhelp.findJobs",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/employment-labor.svg"
            },
            "category": "4",
            "prompt": "quickhelp.findJobsPrompt",
            "styles": {
              "backgroundColor": "#fdf2f8",
              "hoverColor": "#fce7f3",
              "outlineColor": "#f9a8d4"
            }
          }
        ]
      }
    }
  },
  "custom": {}
}