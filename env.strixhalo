# GPU Configuration for AMD Strix Halo (Radeon 8060S iGPU, gfx1151, unified memory)
# Usage:
#   docker compose --env-file env.strixhalo \
#     -f docker-compose.yaml -f docker-compose.rocm.yaml \
#     --profile opea --profile gpu-models up -d
#
# Values measured on the reference machine (Ryzen AI MAX+ 395, 91 GB unified
# RAM, GTT aperture 45.8 GiB) — see docs/superpowers/specs/
# 2026-11-11-rocm-gpu-tier-spike-results.md for the measurements behind
# every number. The GTT is carved from system RAM: the GPU-tier claims
# below coexist with other workloads on the host.

# ========= Image pins (ROCm path) =========
# Main + translation LLM: ROCm 10.1 build of vLLM 0.29.x — version parity
# with the NVIDIA pin (vllm/vllm-openai:v0.29.0). Verified serving both
# models with guided JSON in the spike.
VLLM_ROCM_IMAGE=rocm/vllm:rocm10.1.0_ubuntu24.04_py3.14-pytorch_2.13.0_vllm-0.29.0
# TEI: the ROCm image fails on gfx1151 (Instinct-only kernels) — CPU image
# per the spike decision. bge-scale models on 32 cores are ample and claim
# no GTT.
TEI_ROCM_EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3
TEI_ROCM_RERANKING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3

# ========= Main LLM (vllm) — 32 GB coexistence ceiling =========
# Sized for a SHARED host: total GPU-tier claims + ~4.75 GB desktop GTT
# baseline + ~1.85 GB runtime overhead must stay under 32 GB (operator
# decision 2026-11-11). 0.42 claims 19.2 GiB (~16.5 weights + ~2.7 KV →
# a 16384 window). Larger windows need a mostly-dedicated host: 0.55 /
# 49152 fits a 45.8 GiB aperture with neighbors stopped (~39 GB peak).
VLLM_GPU_UTILIZATION=0.42
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=16
VLLM_DTYPE=half

# ========= Translation LLM (vllm-translation-guardrail) =========
# gemma-3-4b-it (~8 GiB bf16 weights): 0.19 is the floor that fits the
# weights plus an 8192 KV window. Verified in the coexistence probe.
VLLM_TRANSLATION_GPU_UTILIZATION=0.19
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_MAX_NUM_SEQS=16
VLLM_TRANSLATION_DTYPE=auto

# ========= Docling =========
# Dataprep's docling runs CPU-side on the ROCm path (no docling ROCm
# support; the CUDA probe in dataprep would otherwise warn and fall back).
DOCLING_DEVICE=cpu

# ========= Host ports for a shared machine =========
# The reference machine already hosts other stacks on 80/443/8529 — the
# ROCm venues publish on free ports (audit in the spike-results doc).
# NGINX_HTTP_PORT/NGINX_HTTPS_PORT/ARANGO_PORT serve the single-server
# main-stack venue; GPU_HTTP(S)_PORT serve the split GPU-node venue
# (docker-compose.gpu.yaml + its ROCm overlay). Drop or adjust on a
# dedicated ROCm host.
NGINX_HTTP_PORT=8180
NGINX_HTTPS_PORT=8443
ARANGO_PORT=18529
GPU_HTTPS_PORT=18443
GPU_HTTP_PORT=8181

# ========= Model IDs =========
# The split GPU-node stack defaults to a different LLM than the main
# stack; pin both to the sizing models measured in the spike.
VLLM_LLM_MODEL_ID=ibm-granite/granite-4.1-8b
VLLM_TRANSLATION_MODEL_ID=google/gemma-3-4b-it

# ========= Device group GIDs (distro-specific) =========
# `getent group render video` on the GPU host. Defaults match the
# reference Ubuntu host (render=990, video=44).
RENDER_GID=990
VIDEO_GID=44
