              "outlineColor": "#0288D1"
            }
          },
          {
            "id": "harvest-storage",
            "title": "quickhelp.harvestStorage",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/harvest-storage.svg"
            },
            "category": "11",
            "action": {
              "visibleText": "quickhelp.harvestStorageUserPrompt",
              "hiddenPrompt": "quickhelp.harvestStoragePrompt"
            },
            "styles": {
