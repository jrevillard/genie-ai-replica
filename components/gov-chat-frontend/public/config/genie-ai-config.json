              "visibleText": "quickhelp.growFruitsVeggiesUserPrompt",
              "hiddenPrompt": "quickhelp.growFruitsVeggiesPrompt"
            },
            "styles": {
              "backgroundColor": "#FFFFFF",
              "hoverColor": "#F1F8E9",
              "outlineColor": "#558B2F"
            }
          },
          {
            "id": "manage-poultry-pigs",
            "title": "quickhelp.managePoultryPigs",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/manage-poultry-pigs.svg"
            },
            "category": "5",
            "action": {
              "visibleText": "quickhelp.managePoultryPigsUserPrompt",
              "hiddenPrompt": "quickhelp.managePoultryPigsPrompt"
            },
            "styles": {
              "backgroundColor": "#FFFFFF",
              "hoverColor": "#EFEBE9",
              "outlineColor": "#8D6E63"
            }
          },
          {
            "id": "fertilizer-soil-advice",
            "title": "quickhelp.fertilizerSoilAdvice",
            "icon": {
              "type": "file",
