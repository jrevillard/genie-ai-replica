# =============================================================================
# SECTION 6: BACKEND SERVICE CONFIGURATION
# =============================================================================
# Override for production deployment.

# CORS allowed origins (which domains can access the API)
# Used by: backend (response headers)
# Default: http://localhost:3000,http://localhost:8090,http://127.0.0.1:8090,https://localhost,http://localhost
# Production: https://your-domain.com,https://*.your-domain.com
# CORS_ALLOWED_ORIGINS=

# Content Security Policy for backend and nginx
# Used by: backend (response headers), nginx (via CSP_CONNECT_SRC env var)
# Note: nginx uses CSP_CONNECT_SRC (set in .env), not CORS_ALLOWED_ORIGINS.
# Local development example: 'self' http://localhost:3000 http://localhost:8090 http://127.0.0.1:8090 ws://localhost:3000 ws://localhost:8090
# NOTE: 'self' must include the single quotes (they are CSP directive syntax, not shell quoting)
# Production: 'self' https://your-domain.com wss://your-domain.com
# Runtime default (if unset): same as local development example above
# IMPORTANT: Also set VUE_APP_CSP_CONNECT_SRC (section 5) to the same value.
# They serve the same purpose but at different stages (build-time vs runtime).
# CSP_CONNECT_SRC=

# Log level for backend and document-repository services
# Used by: backend (shared-lib/logger.js), document-repository (appConfig.js)
# Values: error, warn, info, debug
# Default: info
# LOG_LEVEL=debug

# Stream the target-language translation during chat streaming (issue #829) instead
# of streaming English and flipping to the UI language at the end. 1 = stream-translate
# complete sentence/paragraph units as they arrive; 0 (default) = current behavior.
# STREAMING_TRANSLATION_ENABLED=0

# Multi-turn vector-space blending (issue #833). Blends the query embedding
# with the previous N turns' embedding (V = α·EQ + (1-α)·EH) at the retriever's
# dense leg, so pronoun-heavy follow-ups ("can you elaborate on this?") retrieve
# the prior turn's subject. Default OFF (no-op). Adds ONE embedding call per
# multi-turn query. Query-time feature; unrelated to ingest-time
# CONTEXTUAL_RETRIEVAL_ENABLED. Only the dense leg is blended; the BM25/hybrid
# leg (RETRIEVER_HYBRID_RETRIEVAL_ENABLED) still uses the isolated query text.
# MULTI_TURN_BLEND_ENABLED=false
# MULTI_TURN_BLEND_ALPHA=0.7         # query weight α; 1.0 = query-only, 0.0 = history-only
# MULTI_TURN_HISTORY_TURNS=1         # number of prior turns blended (1 = previous turn only)

# Application session lifetime for automatic purging (MILLISECONDS, NOT seconds or minutes).
# Controls how long an inactive analytics session is kept before automatic cleanup.
# Used by: backend (session-service.js)
# Default: 1800000 (30 minutes in milliseconds)
# IMPORTANT: Value is in MILLISECONDS. Common values:
#   15 minutes = 900000
#   30 minutes = 1800000 (default)
#   1 hour     = 3600000
# Alignment with Keycloak: set this value to match or slightly exceed Keycloak's
# SSO Session Max or Access Token Lifespan to ensure sessions are purged after
# the user's authentication expires.
# SESSION_EXPIRATION_TIME=

# =============================================================================
# SECTION 7: API GATEWAY CONFIGURATION
# =============================================================================
# Nginx reverse proxy configuration for cloud-native deployment.

# NGINX public domain (used for HTTPS redirect, Host header, CORS origin)
# Default: localhost
# Production: your-domain.com
# Used by: nginx (reverse proxy)
# NGINX_PUBLIC_DOMAIN=

# NGINX HTTP port (host port for HTTP redirect)
# Default: 80
# NGINX_HTTP_PORT=

# NGINX HTTPS port (host port for HTTPS access)
# Default: 443
# NGINX_HTTPS_PORT=

# Internal Docker service names (override ONLY if using custom service names)
# NGINX_FRONTEND_HOST=frontend
# NGINX_FRONTEND_PORT=8090
# KONG_PROXY_HOST=kong

# Kong proxy ports are NOT exposed to the host by default.
# All external traffic routes through nginx (80/443).
# To expose Kong directly for debugging, uncomment in docker-compose.yaml.

# Kong trusted IPs for X-Forwarded-* header passthrough
# Kong must trust nginx (on the Docker network) to pass through X-Forwarded-Proto,
# X-Forwarded-Host, X-Forwarded-Port, and X-Forwarded-Prefix headers set by nginx.
# Without this, Kong overwrites them with its own (http/port 8000).
# Default: 172.16.0.0/12 (covers Docker bridge subnets 172.16–172.31)
# Restrict to your Docker network subnet for production.
# KONG_TRUSTED_IPS=

# Let's Encrypt certificate management (optional)
# Set CERTBOT_EMAIL to enable automatic SSL certificate provisioning via Let's Encrypt.
# Activation requires: CERTBOT_EMAIL + deployment flag (--profile letsencrypt / CERTBOT_REPLICAS)
# CERTBOT_EMAIL=your-email@example.com
# CERTBOT_REPLICAS=0
# CERTBOT_STAGING=false

# Kong DNS stale TTL in seconds (default: 5)
# Lower values reduce 502 errors after backend container recreate
# Range: 1-3600. Set to 1 for immediate re-resolution (higher CPU).
# Use "docker exec <kong-container> kong reload" for immediate DNS flush.
# KONG_DNS_STALE_TTL=

# =============================================================================
# SECTION 8: LLM PROMPTS & FLAGS (OPTIONAL)
# =============================================================================
# Default prompts and flags are built into the Python code.
# Override here ONLY for deployment-specific customization.
#
# **Prompts** (text instructions for AI):
#   - CHATQNA_SYSTEM_PROMPT: Main system prompt for chat behavior
#   - CHATQNA_ABSTENTION_INSTRUCTIONS: Instructions for when to refuse answering
#   - LABEL_SELECTOR_SYSTEM_PROMPT: Prompt for automatic document labeling
#
# **Flags** (behavior toggles):
#   - CHATQNA_ENFORCE_ABSTENTION: Whether to enforce abstention (default: true)
