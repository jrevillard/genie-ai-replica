# ============================================
# AMINA Demo Environment — SAFE to commit
# ============================================
# This file IS committed to git. It contains demo-safe values
# that let the entire stack boot for evaluation/UNICC testing.
# No real API keys — uses local models and mock services where
# possible.
#
# To use real API keys, copy .env.example to .env and fill in
# your values. .env (gitignored) overrides .env.defaults at boot.
# The start.ps1 / start.sh scripts handle the fallback automatically.
# ============================================

# === API service ports ===
API_HOST=0.0.0.0
API_PORT=8000
DATAPREP_PORT=8001

# === LLM Configuration ===
# Demo mode placeholders — code paths gated on DEMO_MODE=true should
# avoid network calls to these providers. Where they're called the
# request will fail and the agent's existing fallback chain kicks in.
GOOGLE_API_KEY=demo-mode-no-key-needed
OPENAI_API_KEY=demo-mode-no-key-needed
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=

USE_FINETUNED_MODEL=false

# === ArcadeDB ===
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DB=genie
ARCADEDB_USER=root
ARCADEDB_PASSWORD=amina_demo_2026
ARCADEDB_ROOT_PASSWORD=amina_demo_2026

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Embedding ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Voice (local containers, no external creds) ===
WHISPER_URL=http://voice-stt:8080
TTS_URL=http://voice-tts:5500
MMS_TTS_URL=http://voice-tts-mnk:5500
TTS_MNK_URL=http://voice-tts-mnk:5500

# === Translator backend ===
USE_GEMMA_TRANSLATOR=false
GEMMA_BASE_URL=http://vllm-translation-guardrail:9031/v1
GEMMA_MODEL=google/gemma-3-4b-it
GEMMA_API_KEY=not-needed

# === Auth (DEMO ONLY — JWT_SECRET regenerated each restart in dev) ===
# Production boots refuse to start with these values; AMINA_ENV is
# left unset (== "development") so the dev-friendly defaults apply.
AMINA_ENV=development
JWT_SECRET=amina-demo-jwt-secret-not-for-production
JWT_EXPIRY_HOURS=168
OTP_DEV_MODE=true

# === Admin (matches src/api/admin_routes.py dev defaults) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=amina2026

# === Agent Platform ===
AMINA_AGENTIC_MODE=assist
AMINA_AGENTIC_FAIL_OPEN=true
# Phase-2: native function-calling via OpenAI/Gemini tools API instead
# of v1 JSON-string parsing. Fails open to v1 if the provider class
# can't be sniffed (planner.py:325 try/except).
AMINA_AGENTIC_NATIVE_TOOLS=true

# === Translation feature flags ===
# Demo defaults turn v4 ON because the NLLB sidecar (started by
# start.ps1 / start.sh via docker-compose.nllb.yml) does NOT need any
# external API keys -- it runs locally. With v4 on, demo testers get
# real Mandinka via NLLB even when OPENAI_API_KEY / GOOGLE_API_KEY
# are placeholders.
# Pipeline gracefully falls back to v3.5 (LLM-only) if the sidecar
# is unreachable, and to v1 if the v4 pipeline returns SERVE_ENGLISH.
AMINA_TRANSLATION_V4_ENABLED=true

# === Translation v4.2 (NLLB sidecar) ===
# NLLB runs as a Docker sidecar container (~7.6 GB image).
# First pull takes 5-10 min on typical broadband; cached after that.
# Pre-pull the night before for a faster demo:
#   docker compose -f haystack-stack/docker-compose.nllb.yml pull nllb-translate
NLLB_API_URL=http://nllb-translate:7860
NLLB_ENABLED=true
NLLB_TIMEOUT_MS=10000
BAMBARA_ADAPTER_ENABLED=true
V4_BACK_TRANSLATION_PREFER_NLLB=true
V4_TELEMETRY_ARCADEDB=true

# === Caregiver Privacy ===
# Demo runs with the privacy gate OFF so testers can see all flows
# without the consent friction. Production turns this true.
AMINA_CAREGIVER_PRIVACY_REQUIRED=false

# === Observatory ===
OBSERVATORY_AUTH_MODE=phone_otp
OBSERVATORY_DATA_MODE=synthetic

# === Channels (disabled in demo — no external keys leaked) ===
TELEGRAM_BOT_TOKEN=disabled
META_APP_SECRET=disabled
META_VERIFY_TOKEN=amina_health_2026
META_PAGE_ACCESS_TOKEN=disabled
META_APP_ID=disabled
TWILIO_ACCOUNT_SID=disabled
TWILIO_AUTH_TOKEN=disabled
TWILIO_PHONE_NUMBER=disabled

# === Channel webhook signature verification (SEC-003) ===
# IMPORTANT: In production, these MUST be set to real values in your .env file.
# Without them, webhook signature verification is DISABLED.
#   TWILIO_VALIDATE_SIGNATURE=true
#   WHATSAPP_APP_SECRET=<real secret from Meta dashboard>
#   MESSENGER_APP_SECRET=<real secret from Meta dashboard>

TWILIO_VALIDATE_SIGNATURE=false
WHATSAPP_APP_SECRET=
MESSENGER_APP_SECRET=

# === DHIS2 (disabled in demo) ===
DHIS2_BASE_URL=disabled
DHIS2_USERNAME=disabled
DHIS2_PASSWORD=disabled

# === Superset (demo passwords — change when promoting to prod) ===
SUPERSET_SECRET_KEY=amina_demo_superset_secret
SUPERSET_ADMIN_PASSWORD=admin

# === Production-blocked dev bypass flags (must be false here) ===
# These three are gated by _bool_env(prod_must_be_false=True) in
# src/config.py. Setting any of them true while AMINA_ENV=production
# refuses boot. Demo is dev-mode so they stay false either way.
CHATQNA_ADMIN_MV_OPEN=false
CARE_TRUST_BODY_ROLE=false
DHIS2_DEV_ADMIN_BYPASS=false

# === Demo flag ===
DEMO_MODE=true
