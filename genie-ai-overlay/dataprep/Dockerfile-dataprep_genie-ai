# ======== Stage 1: The OPEA Base ========
# This stage clones the external OPEA repository at a specific version.
ARG OPEA_REPO_URL="https://github.com/opea-project/GenAIComps.git"
ARG OPEA_VERSION="v1.3" # This tag can be changed to upgrade OPEA
FROM alpine/git:v2.52.0 AS opea_base

ARG OPEA_REPO_URL
ARG OPEA_VERSION

WORKDIR /src
# Clone only the specified branch/tag, with no history for speed
RUN git clone --depth 1 --branch ${OPEA_VERSION} ${OPEA_REPO_URL} .

# ======== Final Stage: Assembly ========
# Use the official NVIDIA CUDA image for Ubuntu 22.04 to enable GPU access.
# This uses the correct 'cudnn8' tag.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# ARG for Hugging Face token is NO LONGER NEEDED.
WORKDIR /app

# Step A: Install System Dependencies
# Install Python 3.10, pip, and all required system libraries for OPEA dataprep.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --fix-missing \
    # Install Python 3.10 (which is on Ubuntu 22.04) and pip
    python3.10 \
    python3-pip \
    # Install OPEA system dependencies
    build-essential \
    default-jre \
    libcairo2 \
    libgl1 \
    libjemalloc-dev \
    libpq-dev \
    libreoffice \
    poppler-utils \
    tesseract-ocr \
    wget \
    curl \
    unzip \
    ca-certificates && \
    # Create symlinks to make python3.10 the default 'python' and 'python3'
    # and pip3 the default 'pip'
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add /app (for 'comps'), the dataprep 'src' (for entrypoint),
# and 'proto' (for api_protocol) to PYTHONPATH
ENV PYTHONPATH="${PYTHONPATH}:/app:/app/comps/dataprep/src:/app/comps/dataprep/src/integrations:/app/comps/cores/proto"

# Step B: Copy the entire OPEA 'comps' directory from the clone
COPY --from=opea_base /src/comps/ /app/comps/

# Define the path to the requirements file for easier reference
# Step C: Upgrade pip/setuptools/wheel BEFORE any install.
# The Ubuntu 22.04 base ships pip 22.0.2 via apt; its resolver backtracks for
# tens of minutes on valid extras-marker constraints and mis-reports
# ResolutionImpossible (GitLab issue #834). A modern pip is also required to
# honor --require-hashes on the lock below.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Step D: Install dependencies from a hash-pinned lock (issue #834).
# The lock is generated by `make lock-dataprep` (uv pip compile) from
# requirements.in, which is produced by scripts/generate-requirements-in.sh
# from the pinned OPEA tag's requirements.txt (patched) plus overlay extras.
# --no-deps --require-hashes makes the build bit-for-bit reproducible and
# supply-chain-pinned: no transitive re-resolution against live PyPI, and
# every wheel's SHA256 is verified at install time.
#
# NOTE: this block (lock + .in + generator + docling-core pin) exists because
# OPEA v1.3 ships an UNPINNED requirements.txt. OPEA v1.4+ ships its own
# uv-compiled lock with correct pins — on bumping OPEA past v1.3, replace
# this with OPEA's requirements-cpu.txt and delete .in/.lock + the generator
# script. See deferred-work.md (Initiative: issue-834) for the full checklist.
COPY genie-ai-overlay/dataprep/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --no-deps --require-hashes -r /app/requirements.lock

# Copy custom utils to its new correct location (matches your structure)
COPY genie-ai-overlay/dataprep/genieai_dataprep_utils.py /app/comps/dataprep/src/genieai_dataprep_utils.py

# Step F.5: Copy shared OTel tracing module (importable from PYTHONPATH=/app)
COPY genie-ai-overlay/tracing.py /app/tracing.py

# Copy shared TTL-cached model probe (importable as core.model_cache from PYTHONPATH=/app)
COPY genie-ai-overlay/core/model_cache.py /app/core/model_cache.py

# Step G: Pre-install EasyOCR models (auto-download during build)
# This prevents the service from hanging on its one-time model download at runtime.
RUN mkdir -p /tmp/easyocr /home/user/.EasyOCR/model /home/user/.EasyOCR/config && \
# 1. Download the 'en' (English) recognition model
    wget -O /tmp/easyocr/english_g2.zip https://github.com/JaidedAI/EasyOCR/releases/download/v1.3/english_g2.zip && \
# 2. Download the text detection model
    wget -O /tmp/easyocr/craft_mlt_25k.zip https://github.com/JaidedAI/EasyOCR/releases/download/pre-v1.1.6/craft_mlt_25k.zip && \
# 3. Unzip the models
    unzip -o /tmp/easyocr/english_g2.zip -d /home/user/.EasyOCR/model && \
    unzip -o /tmp/easyocr/craft_mlt_25k.zip -d /home/user/.EasyOCR/model && \
# 4. Cleanup
    rm -rf /tmp/easyocr

# Step H: Fix docarray circular import (Proactive fix based on retriever)
# 1. Rename the conflicting local file to avoid name collision.
# 2. Update imports to point to the new, non-conflicting filename.
RUN mv /app/comps/cores/proto/docarray.py /app/comps/cores/proto/opea_docarray.py && \
    sed -i 's/from comps.cores.proto.docarray import/from comps.cores.proto.opea_docarray import/' /app/comps/__init__.py && \
    sed -i 's/from \.\.proto.docarray import/from \.\.proto.opea_docarray import/' /app/comps/cores/mega/orchestrator.py && \
    sed -i 's/from \.\.proto.docarray import/from \.\.proto.opea_docarray import/' /app/comps/cores/mega/micro_service.py

# Step I: "Overlay" our custom GENIE-AI files
# These paths are relative to the build context (our repo root)
# 1. Copy our new subclass (Section 2.1) and the loader
COPY genie-ai-overlay/dataprep/genieai_dataprep_arangodb.py /app/comps/dataprep/src/integrations/genieai_dataprep_arangodb.py
COPY genie-ai-overlay/dataprep/keycloak_service_account.py /app/comps/dataprep/src/integrations/keycloak_service_account.py

COPY genie-ai-overlay/dataprep/genieai_dataprep_loader.py /app/comps/dataprep/src/genieai_dataprep_loader.py

# 2. Overwrite OPEA's entry point with our new one
COPY genie-ai-overlay/dataprep/genieai_dataprep_microservice.py /app/comps/dataprep/src/genieai_dataprep_microservice.py

# 3. Overwrite the OPEA API protocol with our custom version
COPY genie-ai-overlay/core/genieai_api_protocol.py /app/comps/cores/proto/genieai_api_protocol.py

# Step J: Lighten library load & Fix Duplicate Registration
# 1. Comment out unused integrations in the *base* OPEA microservice.
# 2. Fix the duplicate import path for 'arangodb.py' to resolve the ValueError.
RUN sed -i '/from integrations\./ { /arangodb/! s/^/#/ }' /app/comps/dataprep/src/opea_dataprep_microservice.py && \
    sed -i 's|from integrations.arangodb import OpeaArangoDataprep|from comps.dataprep.src.integrations.arangodb import OpeaArangoDataprep|' /app/comps/dataprep/src/opea_dataprep_microservice.py

# Step K: Create non-root user and set permissions
RUN useradd -ms /bin/bash user && \
    chown -R user:user /app /home/user

    # Step K.5: Copy SSL bypass runtime patch as sitecustomize (no-op unless OPEA_SSL_SKIP_VERIFY=1)
    COPY configs/ssl/genie_ssl_patch.py /usr/local/lib/python3.10/dist-packages/sitecustomize.py
    # Remove system sitecustomize (Ubuntu apport handler) so our patch runs first
    RUN rm -f /usr/lib/python3.10/sitecustomize.py

# Step L: Run the new GENIE-AI entry point from its new location
USER user
CMD ["python", "comps/dataprep/src/genieai_dataprep_microservice.py"]
