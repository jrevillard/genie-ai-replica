{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with a red theme for Huduma AI",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI Chatbot"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings. All accent variants (hover, muted, dark mode) are derived automatically from brandColor via CSS.",
      "properties": {
        "brandColor": {
          "type": "string",
          "description": "Primary brand color (hex). This is the single source for the entire accent palette.",
          "default": "#4071cb"
        },
        "bg": {
          "type": "string",
          "description": "Page background color (overrides the default light gray)"
        },
        "fg": {
          "type": "string",
          "description": "Primary text color (overrides the default dark gray)"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific overrides (optional, defaults to brand)",
          "properties": {
            "background": {
              "type": "string",
              "description": "Navbar background color (defaults to brandColor)"
            },
            "text": {
              "type": "string",
              "description": "Navbar text/icon color (auto-contrasted if omitted)"
            }
          }
        },
        "colors": {
          "type": "object",
          "description": "Override semantic status colors",
          "properties": {
            "success": {
              "type": "string",
              "description": "Success color"
            },
            "warning": {
              "type": "string",
              "description": "Warning color"
            },
            "danger": {
              "type": "string",
              "description": "Danger color"
            },
            "info": {
              "type": "string",
              "description": "Info color"
            }
          }
        },
        "typography": {
          "type": "object",
          "description": "Typography overrides",
          "properties": {
            "fontFamily": {
              "type": "string",
              "description": "Override body font stack"
            },
            "fontScale": {
              "type": "number",
              "description": "Multiplier for all text sizes (e.g. 1.1)"
            }
          }
        },
        "visual": {
          "type": "object",
          "description": "The Living Intelligence decorative layer. Every asset path is served from /config/ so an operator can replace it on the host without an image rebuild.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the decorative layer is active. When false, no rule of the layer applies."
            },
            "assets": {
              "type": "object",
              "description": "Site-root-relative paths of the decoration assets.",
              "properties": {
                "hero": {
                  "type": "string",
                  "description": "Hero illustration above the welcome heading."
                },
                "waves": {
                  "type": "string",
                  "description": "Bottom wave decoration."
                },
                "mesh": {
                  "type": "string",
                  "description": "Surface dot motif behind the welcome screen."
                },
                "corner": {
                  "type": "string",
                  "description": "Corner network motif in the resources sidebar."
                }
              }
            }
          }
        }
      },
      "required": [
        "brandColor"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "description": "Custom welcome message for the chatbot, localized.",
              "allOf": [
                {
                  "$ref": "#/definitions/localizedText"
                }
              ]
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "description": "Button label, localized.",
                        "allOf": [
                          {
                            "$ref": "#/definitions/localizedText"
                          }
                        ]
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "description": "Text the user sees in chat, localized.",
                            "allOf": [
                              {
                                "$ref": "#/definitions/localizedText"
                              }
                            ]
                          },
                          "hiddenPrompt": {
                            "description": "Detailed prompt sent to the LLM, localized.",
                            "allOf": [
                              {
                                "$ref": "#/definitions/localizedText"
                              }
                            ]
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Huduma AI",
    "icon": {
      "type": "file",
      "value": "/config/huduma-icon.svg"
    }
  },
  "theme": {
    "brandColor": "#8B2A2A",
    "bg": "#EAD9D9",
    "fg": "#1C1515"
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to Huduma AI, your public service assistant!",
      "botName": "Huduma",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "styles": {
              "backgroundColor": "#EAD9D9",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.justChatUserPrompt",
              "hiddenPrompt": "quickhelp.justChatPrompt"
            }
          },
          {
            "id": "identity-civil",
            "title": "quickhelp.applyForID",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/identity-civil.svg"
            },
            "category": "1",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.applyForIDUserPrompt",
              "hiddenPrompt": "quickhelp.applyForIDPrompt"
            }
          },
          {
            "id": "taxes-revenue",
            "title": "quickhelp.payTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/taxes-revenue.svg"
            },
            "category": "5",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.payTaxesUserPrompt",
              "hiddenPrompt": "quickhelp.payTaxesPrompt"
            }
          },
          {
            "id": "business-trade",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-trade.svg"
            },
            "category": "8",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.startBusinessUserPrompt",
              "hiddenPrompt": "quickhelp.startBusinessPrompt"
            }
          },
          {
            "id": "healthcare-social",
            "title": "quickhelp.findHealthcare",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/healthcare-social.svg"
            },
            "category": "2",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.findHealthcareUserPrompt",
              "hiddenPrompt": "quickhelp.findHealthcarePrompt"
            }
          },
          {
            "id": "education-learning",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": "3",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.educationServicesUserPrompt",
              "hiddenPrompt": "quickhelp.educationServicesPrompt"
            }
          },
          {
            "id": "transportation-mobility",
            "title": "quickhelp.transportLicenses",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/transportation-mobility.svg"
            },
            "category": "7",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.transportLicensesUserPrompt",
              "hiddenPrompt": "quickhelp.transportLicensesPrompt"
            }
          },
          {
            "id": "housing-urban",
            "title": "quickhelp.housingPrograms",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/housing-urban.svg"
            },
            "category": "9",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.housingProgramsUserPrompt",
              "hiddenPrompt": "quickhelp.housingProgramsPrompt"
            }
          },
          {
            "id": "employment-labor",
            "title": "quickhelp.findJobs",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/employment-labor.svg"
            },
            "category": "4",
            "styles": {
              "backgroundColor": "#F0DFDF",
              "hoverColor": "#D8C0C0",
              "outlineColor": "#B69B9B"
            },
            "action": {
              "visibleText": "quickhelp.findJobsUserPrompt",
              "hiddenPrompt": "quickhelp.findJobsPrompt"
            }
          }
        ]
      }
    }
  },
  "custom": {},
  "definitions": {
    "localizedText": {
      "description": "Either a plain string, or a dictionary of locale code to text. The base config ships dictionaries; the flavour configs ship plain strings.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  }
}
