<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen drawn by the Android process while Flutter is starting.
     The AgroGenio team hero (white background keyed out) renders on the
     AgroGenio verde brand background so the splash reads as the same
     surface the rest of the app launches into. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
