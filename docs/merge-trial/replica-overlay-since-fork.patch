+    async def _geocode_location_from_query(self, query_text: str) -> dict | None:
+        """
+        Attempt to extract and geocode a location from the user's query text.
+        Uses OpenStreetMap Nominatim forward geocoding, scoped to Lesotho (countrycodes=ls).
+        
+        Returns {"latitude": float, "longitude": float} if a location is found, else None.
+        Caches results indefinitely (place names don't move).
+        """
+        if not query_text:
+            return None
+
+        # Simple heuristic: look for location-related keywords in the query
+        # This avoids geocoding every single message
+        location_indicators = [
+            "weather", "rain", "temperature", "forecast", "climate",
+            "plant", "planting", "harvest", "irrigat", "spray",
+            "in ", "at ", "near ", "around ", "for "
+        ]
+        query_lower = query_text.lower()
+        
+        # Quick check: does the query seem to mention a location context?
+        has_location_hint = any(indicator in query_lower for indicator in location_indicators)
+        if not has_location_hint:
+            return None
+
+        # Extract potential location name using common patterns
+        # Look for patterns like "in <Place>", "near <Place>", "at <Place>", "for <Place>"
+        # Also try to match known Lesotho place-like words (capitalized words)
+        location_patterns = [
+            r'\b(?:in|at|near|around|for)\s+([A-Z][a-zA-Z\'\-]+(?:\s+[A-Z][a-zA-Z\'\-]+)*)',  # "in Maseru", "near Ha Matala"
+            r'\b(?:weather|rain|forecast|temperature|climate)\s+(?:in|at|for|of)\s+([A-Z][a-zA-Z\'\-]+(?:\s+[A-Z][a-zA-Z\'\-]+)*)',  # "weather in Semonkong"
+            r'\b([A-Z][a-zA-Z\'\-]+(?:\s+[A-Z][a-zA-Z\'\-]+)*)\s+(?:weather|rain|forecast|temperature|climate)',  # "Mokhotlong weather"
+        ]
+
+        candidate_locations = []
+        for pattern in location_patterns:
+            matches = re.findall(pattern, query_text)
+            candidate_locations.extend(matches)
+
+        if not candidate_locations:
+            return None
+
+        # Try to geocode the first candidate
+        for candidate in candidate_locations:
+            candidate_clean = candidate.strip().rstrip('?.!')
+            if len(candidate_clean) < 3:
+                continue
+
+            # Check geocode cache
+            cache_key = candidate_clean.lower()
+            if cache_key in self._geocode_cache:
+                cached_time, cached_coords = self._geocode_cache[cache_key]
+                if logflag:
+                    logger.debug(f"[WEATHER-RAG] Geocode cache hit for '{candidate_clean}'")
+                return cached_coords
+
+            # Call Nominatim forward geocoding (scoped to Lesotho)
+            try:
+                nominatim_url = "https://nominatim.openstreetmap.org/search"
+                params = {
+                    "q": candidate_clean,
+                    "countrycodes": "ls",
+                    "format": "json",
+                    "limit": 1,
+                    "addressdetails": 0
+                }
+                headers = {
+                    "User-Agent": "GENIE-AI-Agrivisory/1.0 (weather-rag-integration)"
+                }
+
+                async with aiohttp.ClientSession() as session:
+                    async with session.get(nominatim_url, params=params, headers=headers, 
+                                          timeout=aiohttp.ClientTimeout(total=3)) as response:
+                        if response.status == 200:
+                            results = await response.json()
+                            if results and len(results) > 0:
+                                lat = float(results[0]["lat"])
+                                lon = float(results[0]["lon"])
+                                coords = {"latitude": lat, "longitude": lon}
+                                # Cache the result (place names don't change)
+                                self._geocode_cache[cache_key] = (time.time(), coords)
+                                if logflag:
+                                    logger.info(f"[WEATHER-RAG] Geocoded '{candidate_clean}' → ({lat}, {lon})")
+                                return coords
+                            else:
+                                if logflag:
+                                    logger.debug(f"[WEATHER-RAG] Nominatim returned no results for '{candidate_clean}'")
+                        else:
+                            logger.warning(f"[WEATHER-RAG] Nominatim returned status {response.status}")
+            except Exception as e:
+                logger.warning(f"[WEATHER-RAG] Geocoding failed for '{candidate_clean}': {e}")
+
+        return None
+
+    async def _fetch_weather_context(self, location_data: dict = None, query_text: str = None) -> str:
+        """
+        Fetch weather from the backend weather service and format as compact LLM context.
+        
+        Location resolution priority:
+        1. Geocoded location from user's query text (if a place is mentioned)
+        2. Frontend-provided weatherLocation (from weather widget selection)
+        3. Default coordinates (Maseru)
+        
+        Uses an in-memory cache with configurable TTL to avoid excessive API calls.
+        Returns an empty string on failure (non-critical, graceful degradation).
+        """
+        if not WEATHER_AUGMENTATION_ENABLED:
+            return ""
+
+        try:
+            # Priority 1: Try to geocode a location from the user's query
+            geocoded_location = None
+            if query_text:
+                geocoded_location = await self._geocode_location_from_query(query_text)
+
+            # Resolve final coordinates
+            latitude = WEATHER_DEFAULT_LATITUDE
+            longitude = WEATHER_DEFAULT_LONGITUDE
+
+            if geocoded_location:
+                latitude = geocoded_location["latitude"]
+                longitude = geocoded_location["longitude"]
+                if logflag:
+                    logger.info(f"[WEATHER-RAG] Using geocoded location: ({latitude}, {longitude})")
+            elif location_data:
+                latitude = float(location_data.get("latitude", latitude))
+                longitude = float(location_data.get("longitude", longitude))
+                if logflag:
+                    logger.info(f"[WEATHER-RAG] Using widget location: ({latitude}, {longitude})")
+
+            # Check cache
+            cache_key = (round(latitude, 2), round(longitude, 2))
+            now = time.time()
+            if cache_key in self._weather_cache:
+                cached_time, cached_data = self._weather_cache[cache_key]
+                if now - cached_time < WEATHER_CACHE_TTL_SECONDS:
+                    if logflag:
+                        logger.debug(f"[WEATHER-RAG] Cache hit for {cache_key}")
+                    return cached_data
+
+            # Fetch from backend weather API (internal Docker network)
+            url = f"{BACKEND_SERVICE_URL}/api/weather"
+            token = await self.user_profile_client._get_auth_token()
+            if not token:
+                logger.warning("[WEATHER-RAG] No auth token available, skipping weather fetch")
+                return ""
+
+            headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
+            payload = {"latitude": latitude, "longitude": longitude}
+
+            async with aiohttp.ClientSession() as session:
+                async with session.post(url, json=payload, headers=headers, timeout=aiohttp.ClientTimeout(total=5)) as response:
+                    if response.status == 200:
+                        data = await response.json()
+                        formatted = self._format_weather_context(data)
+                        # Store in cache
+                        self._weather_cache[cache_key] = (now, formatted)
+                        if logflag:
+                            logger.info(f"[WEATHER-RAG] Weather fetched and cached for {cache_key}")
+                        return formatted
+                    else:
+                        logger.warning(f"[WEATHER-RAG] Backend returned status {response.status}")
+                        return ""
+
+        except Exception as e:
+            logger.warning(f"[WEATHER-RAG] Weather fetch failed (non-critical): {e}")
+            return ""
+
+    def _format_weather_context(self, weather_data: dict) -> str:
+        """Format weather API response into compact LLM context block."""
+        location = weather_data.get("location", "Unknown")
+        current = weather_data.get("current", {})
+        forecast = weather_data.get("forecast", [])
+
+        lines = [
+            f"Location: {location}",
+            f"Now: {current.get('temperature')}°C, {current.get('condition')}, "
+            f"Humidity {current.get('humidity')}%, Wind {current.get('windSpeed')} km/h"
+        ]
+
+        for day in forecast[:7]:
+            date_str = day.get("date", "")[:10]
+            precip = day.get("precipitation")
+            precip_str = f", Rain {precip}mm" if precip and precip > 0 else ""
+            lines.append(
+                f"{date_str}: {day.get('condition')}, "
+                f"High {day.get('highTemp')}°C / Low {day.get('lowTemp')}°C{precip_str}"
+            )
+
+        return "\n".join(lines)
+    # ==================== END WEATHER RAG AUGMENTATION ====================
     
 
 
