# --- PII sidecar + rescan resilience (David 2026-10-13) -----------------------
# The Ansible .env carried NO PII_* vars at all, so cloud deployments silently
# ran the sidecar at the Dockerfile default (2 workers) while the local .env set
# 4 — and okf-server had no way to override the rescan retry pace. Defaults here
# mirror the code/compose defaults so BOTH deployment modes behave the same.
# Worker PROCESSES for the sidecar (GIL-bound NER needs processes, not threads).
# Each holds its own ~390MB spaCy copy, so this is the sidecar's memory knob.
PII_WEB_CONCURRENCY={{ pii_web_concurrency | default('4') }}
# Max chars per analyze() call in the sidecar (measured 2026-10-13). A single
# long scan holds the GIL inside native spaCy/thinc code, which starves
# uvicorn's own supervisor: it SIGKILLs a worker that fails its 5 s liveness
# ping and respawns it (an 850 KB page killed the worker 8/8 before the fix;
# 0/10 after). The default keeps a region at ~3.4 s worst case, inside the
# 5 s window. LOWER it on a slower host — a region must stay under 5 s — and
# raise it only when a region is measured below that.
PII_REGION_MAX_CHARS={{ pii_region_max_chars | default('50000') }}
# Pause between retries when a concept's PII scan comes back 'error' during a
# bulk repo rescan. Must outlast a sidecar worker respawn (~10-20s observed);
# code default 8000 (retries at 8s/16s/24s). Raise on a slow host.
PII_CONCEPT_RETRY_PAUSE_MS={{ pii_concept_retry_pause_ms | default('8000') }}
# Sidecar endpoint + per-call budget (okf-server -> pii-service).
PII_SERVICE_URL={{ pii_service_url | default('http://pii-service:8000') }}
PII_TIMEOUT_MS={{ pii_timeout_ms | default('10000') }}
PII_RETRIES={{ pii_retries | default('2') }}
