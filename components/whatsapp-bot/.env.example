# WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_APP_SECRET=

# Genie AI Backend
GENIEAI_API_BASE_URL=https://app.youngailinz.org/api
