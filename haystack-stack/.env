# ── Translation v2 pipeline activation (added 2026-04-21) ────────────────
# Activates the EN->MA refactor with gpt-4o + glossary injection + bridge
# polish post-processing. All flags revert in one flip back to false.
USE_V2_TRANSLATION_PIPELINE=true
USE_V2_GLOSSARY=true
USE_V2_BRIDGE_POLISH=true
USE_V2_FOR_LEGACY_TRANSLATOR=true
USE_V2_FOR_V1_ENDPOINTS=true
V2_PRIMARY_PROVIDER=openai

# ── Conversational Pacer + Gap Closers (added 2026-04-22) ───────────────
# Pacer: forces short turn-based conversation (2-3 sentences per turn)
USE_CONVERSATIONAL_PACER=true
# Response shape: model chooses greeting/empathy/advice instead of rigid format
USE_RESPONSE_SHAPE_DECISION=true
# Density compression: strips filler post-generation
USE_DENSITY_COMPRESSION=true
# Deterministic safety contract (replaces overly-cautious LLM safety review)
USE_SAFETY_CONTRACT=true
# Intent Router (ack-prefix stripping + 9-intent taxonomy)
USE_INTENT_ROUTER=true
# Intent Learner (capture + store + reviewer corrections)
USE_INTENT_LEARNER=true
# Four-Layer Neuro-Symbolic Router (L0→L1→L2→L3)
USE_FOUR_LAYER_ROUTER=true
# Stance Classifier — Layer 1 (LLM-based, 9 stances)
USE_STANCE_CLASSIFIER=true
# Stance mode: "shadow" (logs only) or "active" (affects routing)
USE_STANCE_MODE=shadow
# Intent Pattern Graph — Layer 3 (emergency, drug, cultural nodes in Redis)
USE_INTENT_PATTERN_GRAPH=true

