    "Only files can be dropped. Please check you are dragging a valid file from your computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إفلات الملفات فقط. يرجى التأكد من أنك تسحب ملفاً صالحاً من جهاز الكمبيوتر الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Dateien können abgelegt werden. Bitte prüfen Sie, ob Sie eine gültige Datei von Ihrem Computer ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only files can be dropped. Please check you are dragging a valid file from your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se pueden soltar archivos. Por favor verifica que estás arrastrando un archivo válido desde tu computadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers peuvent être déposés. Veuillez vérifier que vous faites glisser un fichier valide depuis votre ordinateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya berkas yang dapat dilepas. Harap periksa apakah Anda menyeret berkas yang valid dari komputer Anda."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas arquivos podem ser soltos. Por favor, verifique se você está arrastando um arquivo válido do seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно перетаскивать только файлы. Пожалуйста, убедитесь, что вы перетаскиваете действительный файл с вашего компьютера."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faili pekee ndizo zinaweza kudondoshwa. Tafadhali hakikisha unaburuta faili sahihi kutoka kwenye kompyuta yako."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สามารถวางได้เฉพาะไฟล์เท่านั้น โปรดตรวจสอบว่าคุณกำลังลากไฟล์ที่ถูกต้องจากคอมพิวเตอร์ของคุณ"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能拖放文件。请检查您是否正在从计算机拖动有效文件。"
          }
        }
      }
    },
