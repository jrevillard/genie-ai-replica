# =============================================================================
# GENIE.AI - Environment Configuration (auto-generated by Ansible)
# =============================================================================
# DO NOT EDIT MANUALLY — this file is generated from templates/env.j2
# To change values, edit group_vars/all.yml or group_vars/all.vault, then re-run:
#   ansible-playbook -i inventory deploy.yml --tags deploy --ask-vault-pass
# =============================================================================

# =============================================================================
# SECTION 1: SECRETS
# =============================================================================
ARANGO_PASSWORD={{ arango_password }}
JWT_SECRET={{ jwt_secret }}
SESSION_SECRET={{ session_secret }}
TRANSLATION_CACHE_PASSWORD={{ translation_cache_password }}
POSTGRES_PASSWORD={{ postgres_password }}
AUTH_SERVICE_USERNAME={{ auth_service_username }}
AUTH_SERVICE_PASSWORD={{ auth_service_password }}

# =============================================================================
# SECTION 2: EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST={{ email_host | default('') }}
EMAIL_PORT={{ email_port | default('587') }}
EMAIL_SECURE={{ email_secure | default('false') }}
EMAIL_USER={{ email_user | default('') }}
EMAIL_PASSWORD={{ email_password | default('') }}
EMAIL_FROM={{ email_from | default('') }}

# =============================================================================
# SECTION 3: EXTERNAL API KEYS
# =============================================================================
HUGGING_FACE_HUB_TOKEN={{ hugging_face_hub_token | default('') }}

# =============================================================================
# SECTION 3b: DEPLOYMENT OPTIONS
# =============================================================================
{% if deploy_opea and deploy_opea != '1' %}DEPLOY_OPEA={{ deploy_opea }}
{% endif %}

# =============================================================================
# SECTION 7: API GATEWAY CONFIGURATION
# =============================================================================
{% if nginx_public_domain %}NGINX_PUBLIC_DOMAIN={{ nginx_public_domain }}
{% endif %}
{% if nginx_http_port and nginx_http_port != '80' %}NGINX_HTTP_PORT={{ nginx_http_port }}
{% endif %}
{% if nginx_https_port and nginx_https_port != '443' %}NGINX_HTTPS_PORT={{ nginx_https_port }}
{% endif %}

# =============================================================================
# SECTION 5: FRONTEND CONFIGURATION
# =============================================================================
{% if vue_app_api_url %}VUE_APP_API_URL={{ vue_app_api_url }}
{% endif %}
{% if vue_app_csp_connect_src %}VUE_APP_CSP_CONNECT_SRC={{ vue_app_csp_connect_src }}
{% endif %}

# =============================================================================
# SECTION 6: BACKEND SERVICE CONFIGURATION
# =============================================================================
{% if cors_allowed_origins %}CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}
{% endif %}
{% if csp_connect_src %}CSP_CONNECT_SRC={{ csp_connect_src }}
{% endif %}

# =============================================================================
# SECTION 12: DOCKER SWARM MULTI-NODE
# =============================================================================
{% if swarm_registry_url and swarm_registry_url != 'localhost:5000' %}SWARM_REGISTRY_URL={{ swarm_registry_url }}
{% endif %}
{% if data_dir and data_dir != './data' %}DATA_DIR={{ data_dir }}
{% endif %}
