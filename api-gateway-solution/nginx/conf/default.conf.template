server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    # ACME challenge location (Let's Encrypt HTTP-01)
    # Always present and harmless when certbot is not running (empty dir returns 404)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://${NGINX_PUBLIC_DOMAIN}$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name _;

    # Docker DNS resolver — enables lazy hostname resolution so nginx starts
    # even when upstream containers (frontend, kong) are not yet running.
    # NGINX re-resolves on each request, so containers can start in any order.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # SSL configuration
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-DSS-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # set a 50MB file size limit
    client_max_body_size 50m;

    # Permissions Policy (deployment-specific). The value is also read by the
    # per-location includes: a location that declares add_header directives of
    # its own does not inherit the server's, so the header has to be set in
    # each of them.
    set $permissions_policy "${NGINX_PERMISSIONS_POLICY}";
    add_header Permissions-Policy $permissions_policy always;

    # The framing policy of the default: no page frames another. A surface
    # that is framed by the same origin — the Keycloak login page, the
    # consoles, Grafana — overrides it in its own location.
    set $frame_options "DENY";

    # Strip ALL upstream security/CORS headers — nginx is the single authority
    # (X-Powered-By and Server included — server context, not allowed inside if blocks)
    include conf.d/hide-upstream-headers.inc;

    # Kong upstream address. The variable is resolved at request time, so
    # nginx starts even when the Kong container is not up yet.
    set $kong_addr ${KONG_PROXY_HOST}:8000;

    # The public HTTPS port, as the client sees it. It differs from the
    # container's listening port when the host publishes the container on
    # another one.
    set $https_port ${NGINX_HTTPS_PORT};

    # Block access to dotfiles (e.g., .git, .env), but allow .well-known (OIDC discovery)
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Block access to sensitive files and version control systems
    location ~ /(BitKeeper|\.git|\.svn|\.hg|CVS) {
        deny all;
        return 404;
    }

    # Keycloak theme resources — the login page's and the consoles'
    # stylesheets, images and scripts, whichever theme is installed.
    #
    # Keycloak serves them with a 30-day max-age and, unless the theme names
    # a content hash, no validator at all. A returning browser then keeps the
    # previous stylesheet for a month after a theme change.
    #
    # Two families keep their long cache, and both are safe to keep:
    #   - assets/ — the file name carries a content hash, so a changed file
    #     is a new URL; Keycloak also answers a revalidation with a 304.
    #   - vendor/ — the bundles shipped with Keycloak itself. They change
    #     with the Keycloak version, and the version is the resource tag in
    #     the URL, so an upgrade changes their URL too.
    #
    # Both are Keycloak's own conventions: a bundle under assets/ carries
    # its content hash in its name, and vendor/ is where the shared bundles
    # live. A theme that ships a directory of either name is covered by the
    # rule as well — the rule keys on the directory, not on the owner.
    #
    # It sits before the .txt/.xml rule so that a theme file of either
    # extension is proxied instead of answered from the filesystem.
    location ~ ^/auth/resources/[^/]+/[^/]+/[^/]+/(?!assets/|vendor/).+$ {
        set $frame_options "SAMEORIGIN";
        include conf.d/security-headers.inc;
        add_header Cache-Control "no-cache, must-revalidate" always;

        # Replace the upstream's 30-day cache, do not add to it. The
        # include repeats the server's hide list, because a location
        # that hides a header of its own stops inheriting that list.
        include conf.d/hide-upstream-headers.inc;
        proxy_hide_header Cache-Control;

        include conf.d/kong-proxy.inc;
    }

    # For robots.txt, sitemap.xml and other specific text files
    location ~* \.(txt|xml)$ {
        include conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # For the /uploads/ location specifically
    location /Uploads/ {
        include conf.d/security-headers.inc;
        try_files $uri =404;
    }

    # Keycloak Identity Provider proxied to Kong
    location /auth/ {
        set $frame_options "SAMEORIGIN";
        include conf.d/security-headers.inc;
        include conf.d/kong-proxy.inc;
    }

    # Backend API traffic proxied to Kong
    # CORS Authority: nginx is the single authoritative CORS layer.
    # If Kong has CORS plugins enabled, they must be disabled to avoid duplicate headers.
    # Note: CORS origin uses NGINX_PUBLIC_DOMAIN (single origin at TLS termination),
    # not CORS_ALLOWED_ORIGINS (multi-origin, used by backend only).

    # SSE streaming endpoint — must appear BEFORE /api/ for longest-prefix match.
    # NGINX add_header in a location block completely replaces (not augments) parent
    # headers, so all security/CORS/CSP headers are duplicated from the /api/ block.
    location /api/queries/stream {
        include conf.d/security-headers.inc;

        add_header 'Access-Control-Allow-Origin' 'https://${NGINX_PUBLIC_DOMAIN}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        if ($request_method = 'OPTIONS') {
            include conf.d/security-headers.inc;
            add_header 'Access-Control-Allow-Origin' 'https://${NGINX_PUBLIC_DOMAIN}' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            return 204;
        }

        # Proxy settings to Kong. This location spells the proxy block out
        # rather than including kong-proxy.inc: an SSE stream stays open for
        # the whole conversation, and nginx rejects a timeout directive
        # repeated in the same block instead of letting the location's
        # override the include's.
        proxy_pass http://$kong_addr;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $https_port;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header X-Accel-Buffering no;
        chunked_transfer_encoding on;
        proxy_socket_keepalive on;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        include conf.d/security-headers.inc;

        # CORS headers for API requests
        # Note: nginx 'if' blocks do NOT inherit add_header from parent context,
        # so we must re-include security-headers.conf here for OPTIONS responses.
        if ($request_method = 'OPTIONS') {
            include conf.d/security-headers.inc;
            add_header 'Access-Control-Allow-Origin' 'https://${NGINX_PUBLIC_DOMAIN}' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            return 204;
        }

        add_header 'Access-Control-Allow-Origin' 'https://${NGINX_PUBLIC_DOMAIN}' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;

        # API-specific CSP
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        # Proxy settings to Kong
        # Note: when proxy_pass uses a variable, nginx does NOT perform
        # path prefix substitution — the full request URI is forwarded as-is.
        include conf.d/kong-proxy.inc;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # Swagger API docs — proxied to Kong (backend serves /api-docs and /api-docs.json)
    # NOTE: location /api/ does NOT match /api-docs (hyphen vs slash after "api"),
    # so this block must appear before the frontend catch-all location /.
    location /api-docs {
        include conf.d/security-headers.inc;

        add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        include conf.d/kong-proxy.inc;
    }

    # Android App Links verification
    location = /.well-known/assetlinks.json {
        include conf.d/security-headers.inc;
        default_type application/json;
        alias /etc/nginx/conf.d/assetlinks.json;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # iOS Universal Links verification
    location = /.well-known/apple-app-site-association {
        include conf.d/security-headers.inc;
        default_type text/plain;
        alias /etc/nginx/conf.d/apple-app-site-association;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Frontend Vue.js application
    # Uses a variable for proxy_pass so nginx resolves the hostname at request time
    # via the Docker DNS resolver, instead of failing at startup if frontend is down.
    set $frontend_addr ${NGINX_FRONTEND_HOST}:${NGINX_FRONTEND_PORT};

    # Grafana observability dashboards — proxied to Kong
    location /grafana/ {
        set $frame_options "SAMEORIGIN";
        include conf.d/security-headers.inc;

        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' wss://${NGINX_PUBLIC_DOMAIN}:$https_port https://${NGINX_PUBLIC_DOMAIN}:$https_port; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'self'; form-action 'self' 'unsafe-inline' https://${NGINX_PUBLIC_DOMAIN}:$https_port; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        include conf.d/kong-proxy.inc;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        include conf.d/security-headers.inc;

        # Frontend CSP with parameterized connect-src
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ${CSP_CONNECT_SRC}; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        # Proxy settings to Vue frontend
        proxy_pass http://$frontend_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host ${NGINX_PUBLIC_DOMAIN};
        proxy_buffering off;
        proxy_connect_timeout 300s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Handle SPA fallback - intercept 404s and serve index.html
        proxy_intercept_errors on;
        error_page 404 = @frontend_spa;
    }

    # Named location for SPA fallback
    location @frontend_spa {
        include conf.d/security-headers.inc;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ${CSP_CONNECT_SRC}; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data: https://cdnjs.cloudflare.com;" always;

        proxy_pass http://$frontend_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host ${NGINX_PUBLIC_DOMAIN};
        rewrite ^ /index.html break;
    }
}
