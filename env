# =============================================================================
# GENIE.AI - Environment Configuration Template
# =============================================================================
#
# This file contains all configuration variables for GENIE.AI deployment.
# Copy this file to .env and fill in the required values:
#
#   cp env .env
#
# IMPORTANT: .env is git-ignored and contains your actual secrets.
# This file (env) is the committed template with empty/default values.
#
# Configuration Priority:
#   1. Environment variables in .env (highest priority - overrides all)
#   2. Volume-mounted files (for SSL certificates, prompts)
#   3. Default values in code/docker-compose
#   4. Default values in application code (lowest priority)
#
# Documentation: https://github.com/your-org/genie-ai/docs/deployment.md
# =============================================================================

# =============================================================================
# SECTION 1: SECRETS (REQUIRED)
# =============================================================================
# Generate strong random values using:
#   openssl rand -base64 32
# or:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# These MUST be set in your .env for production deployment.

# ArangoDB database name (default: genie-ai)
# Uncomment and set for per-deployment database isolation (e.g. el-salvador)
# ARANGO_DB=el-salvador

# ArangoDB root password (vector + graph database)
# Used by: backend, document-repository, dataprep, retriever
ARANGO_PASSWORD=

# Redis cache password (translation service caching)
# Used by: redis-cache, translation service
TRANSLATION_CACHE_PASSWORD=

# PostgreSQL shared instance (API gateway + Keycloak)
# The shared PostgreSQL (postgres service) uses a superuser + dedicated users:
# - Superuser 'genieai' (POSTGRES_USER) with POSTGRES_PASSWORD — created by PostgreSQL init
# - Dedicated user 'kong' with KONG_DB_PASSWORD — created by postgres-init
# - Dedicated user 'keycloak' with KEYCLOAK_DB_PASSWORD — created by postgres-init (see Section 9)
# Each service MUST have its own unique password.

# PostgreSQL superuser username (created by PostgreSQL init on first start)
# Default: genieai (set in docker-compose.yaml)
# POSTGRES_USER=genieai

# PostgreSQL superuser password
# Used by: postgres (init), postgres-init (superuser auth)
POSTGRES_PASSWORD=

# Kong dedicated database user password (MUST differ from POSTGRES_PASSWORD)
# Used by: postgres-init (creates 'kong' user), kong, kong-migrations
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KONG_DB_PASSWORD=

# =============================================================================
# SECTION 2: EMAIL CONFIGURATION (REQUIRED)
# =============================================================================
# SMTP server configuration for user verification emails, password reset,
# and system notifications.
#
# Get SMTP credentials from your email provider:
# - Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# - SendGrid, AWS SES, Mailgun: Use provider's SMTP credentials
#
# Required for: User registration, email verification, password reset

EMAIL_HOST=
EMAIL_PORT=
# EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# SMTP AUTH (auto-derived from EMAIL_USER — set to "false" to disable auth while keeping EMAIL_USER)
# EMAIL_SMTP_AUTH=

# =============================================================================
# SECTION 3: EXTERNAL API KEYS
# =============================================================================
# Credentials for external services

# Hugging Face Hub token (required for pulling AI models)
# Get your token at: https://huggingface.co/settings/tokens
# Used by: vLLM, TEI (embedding/reranking services)
# Accept: "Read" permissions sufficient
HUGGING_FACE_HUB_TOKEN=

# Optional: vLLM API key if required by your vLLM deployment
# VLLM_API_KEY=

# =============================================================================
# SECTION 3b: DEPLOYMENT OPTIONS
# =============================================================================
# Control whether OPEA/AI services are deployed (vllm, tei, embedding, reranker,
# retriever, dataprep, chatqna, guardrail, translation).
# DEPLOY_OPEA=1  -> OPEA services deployed (default, requires GPU)
# DEPLOY_OPEA=0  -> OPEA services skipped (core services only, no GPU needed)
#
# DEPLOY_OPEA=1

# =============================================================================
# SECTION 4: AI/ML MODEL CONFIGURATION
# =============================================================================
# All models have sensible defaults in code/docker-compose.
# Override here ONLY if you need different models for your deployment.
#
# Model Selection Guidelines:
# - LLM: Larger models = better quality but slower/more GPU memory
# - Translation: Smaller models sufficient for most use cases
# - Embedding: Use multilingual models if you need non-English support
# - Reranking: Improves retrieval quality, optional but recommended

# Main LLM model for chat (OPEA ChatQnA service)
# Default: meta-llama/Meta-Llama-3.1-8B-Instruct
# Options: meta-llama/Llama-3.1-70B-Instruct (more accurate, slower)
# VLLM_LLM_MODEL_ID=

# Translation model (OPEA Translation service)
# The model used for guardrails and translation (Service: vllm-translation-guardrail)
#
# --- HOW TO CHANGE THE TRANSLATION MODEL ---
# The codebase auto-detects the model type and uses the correct prompt format:
#   - google/translategemma-*       -> uses /v1/completions with manually applied chat template
#   - google/gemma-3-*              -> uses generic plain-text prompt via /v1/chat/completions
#   - Any other model               -> uses generic plain-text prompt via /v1/chat/completions
# To switch, comment out the active line and uncomment the desired model below.
#
# Option 1: Generic LLM-based translation (current default, ~8GB VRAM)
#VLLM_TRANSLATION_MODEL_ID=google/gemma-3-4b-it
# Option 2: Purpose-built translation model, 4b params (~8GB VRAM, supports low-resource languages incl. Sesotho)
#VLLM_TRANSLATION_MODEL_ID=google/translategemma-4b-it
# Option 3: Purpose-built translation model, 12b params (~26GB VRAM, better quality for low-resource languages)
#             Requires gpu_memory_utilization >= 0.6 on 48GB GPU. See issue #581 for quality assessment.
#VLLM_TRANSLATION_MODEL_ID=google/translategemma-12b-it
#
# Override docker-compose defaults for vllm-translation-guardrail (all have sensible defaults):
# VLLM_TRANSLATION_SERVICE_PORT=9031
# VLLM_TRANSLATION_GPU_UTILIZATION=0.35
# VLLM_TRANSLATION_MAX_MODEL_LEN=8192
# VLLM_TRANSLATION_DTYPE=auto

# Embedding service API endpoint path
# Default: /v1/embeddings (OpenAI-compatible, used by OPEA embedding microservice)
# EMBEDDING_SERVER_ENDPOINT=

# Embedding model for vector search
# Default: BAAI/bge-base-en-v1.5
# Options: BAAI/bge-large-en-v1.5 (better, slower), multilingual models
# EMBEDDING_MODEL_ID=

# Reranking model for search result refinement
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL_ID=

# ArangoDB graph traversal (used by retriever and chatqna)
# RETRIEVER_ARANGO_GRAPH_NAME=GRAPH
# RETRIEVER_ARANGO_TRAVERSAL_ENABLED=false
# RETRIEVER_ARANGO_TRAVERSAL_MAX_DEPTH=2
# RETRIEVER_ARANGO_TRAVERSAL_MAX_RETURNED=3
# RETRIEVER_ARANGO_TRAVERSAL_SCORE_THRESHOLD=0.5
# RETRIEVER_ARANGO_TRAVERSAL_CONCURRENT_BATCHES=1

# Retriever tuning (used by retriever and chatqna)
# RETRIEVER_ARANGO_K=4
# RETRIEVER_ARANGO_FETCH_K=20
# RETRIEVER_ARANGO_SCORE_THRESHOLD=0.1
# RETRIEVER_ARANGO_DISTANCE_THRESHOLD=1
# RETRIEVER_ARANGO_LAMBDA_MULT=0.5
# RETRIEVER_ARANGO_SEARCH_START=chunk
# RETRIEVER_ARANGO_SEARCH_MODE=vector
# RETRIEVER_ARANGO_USE_APPROX_SEARCH=false
# RETRIEVER_ARANGO_DISTANCE_STRATEGY=COSINE
# RETRIEVER_ARANGO_NUM_CENTROIDS=1
# RETRIEVER_ARANGO_FILTER_STRATEGY=OR
# RETRIEVER_SUMMARIZER_ENABLED=false
# RERANKING_THRESHOLD=0.9

# =============================================================================
# SECTION 5: FRONTEND CONFIGURATION
# =============================================================================
# Override these for production deployment.
# Defaults are set for local development (localhost).

# Vue.js frontend API URL
# Default: /api (relative, works with Kong/nginx reverse proxy)
# Direct backend access: http://localhost:3000/api
# Production: https://your-domain.com/api
# VUE_APP_API_URL=

# Proxy host for frontend (used for CSP configuration)
# Default: localhost
# Production: your-domain.com
# Should match NGINX_PUBLIC_DOMAIN (section 7)
# VUE_PROXY_HOST=

# Content Security Policy connect sources (allowed WebSocket/API origins)
# Used by: frontend (meta tag, build-time via Vue DefinePlugin)
# Default: 'self' http://localhost:3000 http://localhost:8090 http://127.0.0.1:8090 ws://localhost:3000 ws://localhost:8090
# Production: 'self' https://your-domain.com wss://your-domain.com
# IMPORTANT: Also set CSP_CONNECT_SRC (section 6) to the same value.
# They serve the same purpose but at different stages (build-time vs runtime).
# VUE_APP_CSP_CONNECT_SRC=

# =============================================================================
# SECTION 6: BACKEND SERVICE CONFIGURATION
# =============================================================================
# Override for production deployment.

# CORS allowed origins (which domains can access the API)
# Used by: backend (response headers)
# Default: http://localhost:3000,http://localhost:8090,http://127.0.0.1:8090,https://localhost,http://localhost
# Production: https://your-domain.com,https://*.your-domain.com
# CORS_ALLOWED_ORIGINS=

# Content Security Policy for backend and nginx
# Used by: backend (response headers), nginx (via CSP_CONNECT_SRC env var)
# Note: nginx uses CSP_CONNECT_SRC (set in .env), not CORS_ALLOWED_ORIGINS.
# Local development example: 'self' http://localhost:3000 http://localhost:8090 http://127.0.0.1:8090 ws://localhost:3000 ws://localhost:8090
# NOTE: 'self' must include the single quotes (they are CSP directive syntax, not shell quoting)
# Production: 'self' https://your-domain.com wss://your-domain.com
# Runtime default (if unset): same as local development example above
# IMPORTANT: Also set VUE_APP_CSP_CONNECT_SRC (section 5) to the same value.
# They serve the same purpose but at different stages (build-time vs runtime).
# CSP_CONNECT_SRC=

# Log level for backend and document-repository services
# Used by: backend (shared-lib/logger.js), document-repository (appConfig.js)
# Values: error, warn, info, debug
# Default: info
# LOG_LEVEL=debug

# Application session lifetime for automatic purging (MILLISECONDS, NOT seconds or minutes).
# Controls how long an inactive analytics session is kept before automatic cleanup.
# Used by: backend (session-service.js)
# Default: 1800000 (30 minutes in milliseconds)
# IMPORTANT: Value is in MILLISECONDS. Common values:
#   15 minutes = 900000
#   30 minutes = 1800000 (default)
#   1 hour     = 3600000
# Alignment with Keycloak: set this value to match or slightly exceed Keycloak's
# SSO Session Max or Access Token Lifespan to ensure sessions are purged after
# the user's authentication expires.
# SESSION_EXPIRATION_TIME=

# =============================================================================
# SECTION 7: API GATEWAY CONFIGURATION
# =============================================================================
# Nginx reverse proxy configuration for cloud-native deployment.

# NGINX public domain (used for HTTPS redirect, Host header, CORS origin)
# Default: localhost
# Production: your-domain.com
# Used by: nginx (reverse proxy)
# NGINX_PUBLIC_DOMAIN=

# NGINX HTTP port (host port for HTTP redirect)
# Default: 80
# NGINX_HTTP_PORT=

# NGINX HTTPS port (host port for HTTPS access)
# Default: 443
# NGINX_HTTPS_PORT=

# Internal Docker service names (override ONLY if using custom service names)
# NGINX_FRONTEND_HOST=frontend
# NGINX_FRONTEND_PORT=8090
# KONG_PROXY_HOST=kong

# Kong proxy ports are NOT exposed to the host by default.
# All external traffic routes through nginx (80/443).
# To expose Kong directly for debugging, uncomment in docker-compose.yaml.

# Kong trusted IPs for X-Forwarded-* header passthrough
# Kong must trust nginx (on the Docker network) to pass through X-Forwarded-Proto,
# X-Forwarded-Host, X-Forwarded-Port, and X-Forwarded-Prefix headers set by nginx.
# Without this, Kong overwrites them with its own (http/port 8000).
# Default: 172.16.0.0/12 (covers Docker bridge subnets 172.16–172.31)
# Restrict to your Docker network subnet for production.
# KONG_TRUSTED_IPS=

# Let's Encrypt certificate management (optional)
# Set CERTBOT_EMAIL to enable automatic SSL certificate provisioning via Let's Encrypt.
# Activation requires: CERTBOT_EMAIL + deployment flag (--profile letsencrypt / CERTBOT_REPLICAS)
# CERTBOT_EMAIL=your-email@example.com
# CERTBOT_REPLICAS=0
# CERTBOT_STAGING=false

# Kong DNS stale TTL in seconds (default: 5)
# Lower values reduce 502 errors after backend container recreate
# Range: 1-3600. Set to 1 for immediate re-resolution (higher CPU).
# Use "docker exec <kong-container> kong reload" for immediate DNS flush.
# KONG_DNS_STALE_TTL=

# =============================================================================
# SECTION 8: LLM PROMPTS & FLAGS (OPTIONAL)
# =============================================================================
# Default prompts and flags are built into the Python code.
# Override here ONLY for deployment-specific customization.
#
# **Prompts** (text instructions for AI):
#   - CHATQNA_SYSTEM_PROMPT: Main system prompt for chat behavior
#   - CHATQNA_ABSTENTION_INSTRUCTIONS: Instructions for when to refuse answering
#   - LABEL_SELECTOR_SYSTEM_PROMPT: Prompt for automatic document labeling
#
# **Flags** (behavior toggles):
#   - CHATQNA_ENFORCE_ABSTENTION: Whether to enforce abstention (default: true)
#
# To customize: Uncomment and set values below. To change built-in defaults,
# edit the Python code in genie-ai-overlay/chatqna/ or genie-ai-overlay/dataprep/

# CHATQNA_SYSTEM_PROMPT="You are a helpful assistant..."
# CHATQNA_ABSTENTION_INSTRUCTIONS="If no information found in the context..."
# CHATQNA_ENFORCE_ABSTENTION="false"
# LABEL_SELECTOR_SYSTEM_PROMPT="Categorize this document..."

# =============================================================================
# SECTION 9: KEYCLOAK IDENTITY PROVIDER (REQUIRED)
# =============================================================================
# Keycloak is the identity provider for OIDC authentication.
# All passwords below MUST be set in your .env before deployment.

# Keycloak public URL (for backend OIDC discovery and token validation)
# Used by: backend (keycloak-auth-service.js)
# Must be the public URL via NGINX proxy so the issuer matches the JWT's iss claim.
# In docker-compose, this is auto-derived from NGINX_PUBLIC_DOMAIN:
#   KEYCLOAK_URL=https://<NGINX_PUBLIC_DOMAIN>/auth
# Note: keycloak-config service uses its own internal KEYCLOAK_URL (http://keycloak:8080)
# REQUIRED — app will not start without this value
KEYCLOAK_URL=https://localhost/auth

# Keycloak redirect URIs and web origins are auto-derived from NGINX_PUBLIC_DOMAIN + NGINX_HTTPS_PORT:
#   KC_PUBLIC_ORIGIN=https://<NGINX_PUBLIC_DOMAIN>[:<NGINX_HTTPS_PORT>]
# This is set internally in docker-compose.yaml (keycloak-config service).
# If you use a non-standard HTTPS port (e.g. 8443), set NGINX_HTTPS_PORT in .env — no other changes needed.

# Keycloak realm name
# REQUIRED — app will not start without this value
KEYCLOAK_REALM=genie

# OIDC client ID for the GENIE.AI application
# REQUIRED — app will not start without this value
KEYCLOAK_CLIENT_ID=genie-app

# OIDC client secret (REQUIRED — generate a strong value)
# Used by: backend (token validation), keycloak-config-cli (realm setup)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_CLIENT_SECRET=

# Additional Keycloak realms for backend token validation (JSON array of realm names)
# Each additional realm must have a corresponding OIDC client configured in Keycloak admin console
# with Authorization Code Flow + PKCE enabled and Valid Redirect URIs set to the frontend URL.
# The frontend only authenticates against the primary realm (KEYCLOAK_REALM).
# Users from additional realms authenticate via their own Keycloak login URL.
# Example: KEYCLOAK_ADDITIONAL_REALMS=["partner-org","contractor"]
# KEYCLOAK_ADDITIONAL_REALMS=

# Keycloak master admin password (REQUIRED — set a strong value)
# Used by: admin console access, keycloak-config-cli (master realm authentication)
# WARNING: This is the master admin account password (NOT the GENIE realm admin)
KEYCLOAK_ADMIN_PASSWORD=

# GENIE realm admin username (default: genie-admin)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
# GENIE_ADMIN_USERNAME=genie-admin

# GENIE realm admin password (REQUIRED — must satisfy KEYCLOAK_PASSWORD_POLICY)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
GENIE_ADMIN_PASSWORD=

# GENIE realm admin email (REQUIRED — must be a valid email address)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
GENIE_ADMIN_EMAIL=

# Keycloak PostgreSQL password (REQUIRED — must differ from POSTGRES_PASSWORD)
# Used by: postgres-init (creates dedicated 'keycloak' DB user), keycloak service
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_DB_PASSWORD=

# Keycloak database configuration
# Uses the shared PostgreSQL instance with a dedicated 'keycloak' database and user
# Used by: keycloak service
# KC_DB=postgres

# Keycloak PostgreSQL JDBC URL
# Points to the shared PostgreSQL instance, 'keycloak' database
# KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# Keycloak PostgreSQL username (dedicated user, created by postgres-init)
# KC_DB_USERNAME=keycloak

# Valid redirect URIs for the OIDC client
# Default: http://localhost:8090/* (frontend dev URL)
# Production: https://your-domain.com/*
# KEYCLOAK_VALID_REDIRECT_URIS=http://localhost:8090/*

# Web origins for CORS
# Default: http://localhost:8090 (frontend dev URL)
# Production: https://your-domain.com
# KEYCLOAK_WEB_ORIGINS=http://localhost:8090

# TLS verification for backend → NGINX OIDC discovery/JWKS fetches
# Default: 1 (strict, production). Set to 0 for local dev with self-signed NGINX certs.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Keycloak proxy service account (REQUIRED — set a strong value)
# Used by: backend (keycloak-admin-service.js) for Admin API proxy operations
# The genie-proxy-client has restricted permissions: manage-users, view-users,
# manage-roles, query-users ONLY. Cannot modify realm settings or client config.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_PROXY_CLIENT_SECRET=

# Dataprep service account client (client_credentials grant for service-to-service auth)
# Used by: Dataprep → Document Repository and Backend API calls
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KC_DATAPREP_CLIENT_ID=dataprep-service-client
KC_DATAPREP_CLIENT_SECRET=

# Mobile OIDC client for institutional deployments (Flutter app)
# Public client with PKCE — no client secret required (RFC 8252).
# Change per deployment: each institution needs its own clientId and redirect scheme.
# Used by: keycloak-config-cli (creates the mobile OIDC client in Keycloak at startup)
# See: docs/mobile-deployment-guide.md (deployment onboarding guide)
KC_MOBILE_CLIENT_ID=genie-mobile-itu

# Mobile app custom URL scheme for OIDC callback redirect.
# MUST match the following across all config layers (scheme coherence rule):
#   1. redirectScheme in Dart flavor config (lib/config/flavors/*.dart)
#   2. appAuthRedirectScheme in android/app/build.gradle manifestPlaceholders
#   3. APP_AUTH_REDIRECT_SCHEME in iOS XCConfig (ios/Flutter/*.xcconfig)
#   4. This variable in .env (used by keycloak-config-cli for Keycloak client redirectUris)
# A mismatch causes silent OIDC callback failure — the browser redirects to the wrong
# scheme and the app never receives the authorization code.
KC_MOBILE_REDIRECT_SCHEME=com.itu.genieai

# --- Realm properties (optional) ---
# These control registration, email verification, password policy, and more.
# Uncomment and override only if you need non-default behavior.

# User self-registration (default: true)
# Requires SMTP configuration for verification emails.
# KEYCLOAK_REGISTRATION_ENABLED=true

# Require email verification after registration (default: true)
# Requires SMTP configuration for verification emails to work.
# KEYCLOAK_VERIFY_EMAIL=true

# Allow "Forgot Password" flow on Keycloak login page.
# Requires SMTP configuration (EMAIL_HOST, EMAIL_PORT, etc.) for reset emails to work.
# Set to "false" to hide the "Forgot Password" link on the Keycloak login page.
# Default is "true" via docker-compose.yaml keycloak-config service fallback.
# KEYCLOAK_RESET_PASSWORD=true

# Allow login with email address (default: true)
# KEYCLOAK_LOGIN_WITH_EMAIL=true

# Allow multiple accounts with the same email (default: false)
# KEYCLOAK_DUPLICATE_EMAILS=false

# Brute force detection (lock account after failed attempts, default: true)
# KEYCLOAK_BRUTE_FORCE=true

# Password policy (Keycloak policy syntax)
# Default (in docker-compose.yaml): length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)
# To simplify: KEYCLOAK_PASSWORD_POLICY=length(8)
# KEYCLOAK_PASSWORD_POLICY=length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)

# Theme for login, account console, and email (default: genie — custom GENIE.AI theme)
# KEYCLOAK_THEME=genie

# Internationalization (default: true)
# KEYCLOAK_I18N_ENABLED=true

# Default locale for login pages (default: en)
# KEYCLOAK_LOCALE=en

# Access token lifespan in seconds (default: 300 = 5 minutes)
# KEYCLOAK_ACCESS_TOKEN_LIFESPAN=300

# =============================================================================
# SECTION 9B: EXTERNAL IDENTITY PROVIDERS (OPTIONAL)
# =============================================================================
# External IdP credentials are configured in Keycloak, NOT in GENIE.AI's .env.
