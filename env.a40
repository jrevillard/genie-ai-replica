# GPU Configuration for NVIDIA RTX6000 ADA (24GB VRAM)
# Usage: docker compose --env-file env.rtx6000 up

# ========= GPU SETTINGS (RTX6000-ADA - 24GB VRAM - Aggressive) =========
# Override defaults from docker-compose.yaml for RTX6000 optimization

# Main LLM (vllm) - Higher settings for more VRAM
VLLM_GPU_UTILIZATION=0.6
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=1024

# Translation LLM (vllm-translation-guardrail)
VLLM_TRANSLATION_GPU_UTILIZATION=0.3
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_MAX_NUM_SEQS=64
