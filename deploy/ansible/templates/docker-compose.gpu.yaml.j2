# =============================================================================
# GENIE.AI - GPU Node Docker Compose (auto-generated by Ansible)
# =============================================================================
# DO NOT EDIT MANUALLY — generated from templates/docker-compose.gpu.yaml.j2

volumes:
  certbot_webroot_gpu:
  certbot_etc_gpu:
  hf_cache:

networks:
  gpu_network:

services:

  vllm-llm:
    restart: unless-stopped
    image: {{ vllm_llm_image | default('vllm/vllm-openai:latest') }}
    command: >
      --model {{ vllm_llm_model_id | default('ibm-granite/granite-3.3-2b-instruct') }}
      --gpu_memory_utilization {{ vllm_gpu_utilization | default('0.4') }}
      --served-model-name {{ vllm_llm_model_id | default('ibm-granite/granite-3.3-2b-instruct') }}
      --max_model_len {{ vllm_max_model_len | default('2048') }}
      --max_num_seqs {{ vllm_max_num_seqs | default('64') }}
      --dtype={{ vllm_dtype | default('half') }}
      --enforce-eager
    environment:
      - HUGGING_FACE_HUB_TOKEN={{ hugging_face_hub_token }}
      - VLLM_ATTENTION_BACKEND=TORCH_SDPA
      - VLLM_USE_FLASHINFER_SAMPLER=0
      - NVIDIA_VISIBLE_DEVICES={{ nvidia_visible_devices | default('all') }}
    volumes:
      - hf_cache:/root/.cache/huggingface
    networks:
      - gpu_network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s

  vllm-translation:
    restart: unless-stopped
    image: {{ vllm_translation_image | default('vllm/vllm-openai:v0.10.0') }}
    command: >
      --model {{ vllm_translation_model_id | default('google/gemma-3-4b-it') }}
      --gpu_memory_utilization {{ vllm_translation_gpu_utilization | default('0.3') }}
      --served-model-name {{ vllm_translation_model_id | default('google/gemma-3-4b-it') }}
      --max_model_len {{ vllm_translation_max_model_len | default('2048') }}
      --dtype={{ vllm_translation_dtype | default('auto') }}
      --port 8000
      --no-enable-chunked-prefill
      --max-num-seqs {{ vllm_translation_max_num_seqs | default('16') }}
      --chat-template-content-format openai
    environment:
      - HUGGING_FACE_HUB_TOKEN={{ hugging_face_hub_token }}
      - NVIDIA_VISIBLE_DEVICES={{ nvidia_visible_devices | default('all') }}
    volumes:
      - hf_cache:/root/.cache/huggingface
    networks:
      - gpu_network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 300s

  tei-embedding:
    restart: unless-stopped
    image: {{ tei_embedding_image | default('ghcr.io/huggingface/text-embeddings-inference:1.9.3') }}
    entrypoint: /bin/sh -c "text-embeddings-router --json-output --model-id {{ embedding_model_id | default('BAAI/bge-base-en-v1.5') }} --auto-truncate"
    volumes:
      - {{ gpu_data_dir | default('./data') }}/huggingface:/data
    environment:
      - HUGGING_FACE_HUB_TOKEN={{ hugging_face_hub_token }}
      - RUST_BACKTRACE=
      - NVIDIA_VISIBLE_DEVICES={{ nvidia_visible_devices | default('all') }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/health"]
      interval: 10s
      timeout: 6s
      retries: 48
    networks:
      - gpu_network

  tei-reranker:
    restart: unless-stopped
    image: {{ tei_reranker_image | default('ghcr.io/huggingface/text-embeddings-inference:1.9.3') }}
    entrypoint: /bin/sh -c "text-embeddings-router --json-output --model-id {{ reranker_model_id | default('cross-encoder/ms-marco-MiniLM-L-6-v2') }} --max-batch-tokens {{ tei_reranking_max_batch_tokens | default('1024') }} --max-concurrent-requests {{ tei_reranking_max_concurrent_requests | default('8') }} --auto-truncate"
    volumes:
      - {{ gpu_data_dir | default('./data') }}/huggingface:/data
    environment:
      - HUGGING_FACE_HUB_TOKEN={{ hugging_face_hub_token }}
      - RUST_BACKTRACE=
      - NVIDIA_VISIBLE_DEVICES={{ nvidia_visible_devices | default('all') }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/health"]
      interval: 10s
      timeout: 6s
      retries: 48
    networks:
      - gpu_network

  docling-serve:
    restart: unless-stopped
    image: {{ docling_serve_image | default('ghcr.io/ds4sd/docling-serve:latest') }}
    environment:
      - NVIDIA_VISIBLE_DEVICES={{ nvidia_visible_devices | default('all') }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5001/health"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    networks:
      - gpu_network

  nginx-gpu:
    restart: unless-stopped
    image: {{ nginx_image | default('nginx:1.28-alpine') }}
    ports:
      - "{{ gpu_llm_port | default('9400') }}:9400"
      - "{{ gpu_translation_port | default('9401') }}:9401"
      - "{{ gpu_embedding_port | default('9402') }}:9402"
      - "{{ gpu_reranker_port | default('9403') }}:9403"
      - "{{ gpu_docling_port | default('9404') }}:9404"
      - "80:80"
    volumes:
      - ./{{ gpu_generated_dir }}/gpu-proxy.conf:/etc/nginx/conf.d/default.conf:ro
      - ./{{ gpu_generated_dir }}/api_keys.map:/etc/nginx/api_keys.map:ro
      - ./ssl:/etc/nginx/ssl:ro
      - certbot_webroot_gpu:/var/www/certbot:ro
    depends_on:
      vllm-llm:
        condition: service_healthy
      vllm-translation:
        condition: service_healthy
      tei-embedding:
        condition: service_healthy
      tei-reranker:
        condition: service_healthy
      docling-serve:
        condition: service_healthy
    networks:
      - gpu_network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/"]
      interval: 10s
      timeout: 5s
      retries: 5

  certbot-gpu:
    profiles: [letsencrypt]
    restart: "no"
    image: certbot/certbot:latest
    entrypoint: ["/certbot-entrypoint.sh"]
    environment:
      - CERTBOT_EMAIL={{ certbot_email | default('') }}
      - NGINX_PUBLIC_DOMAIN={{ gpu_public_domain }}
    volumes:
      - {{ gpu_deploy_dir }}/api-gateway-solution/certbot/entrypoint.sh:/certbot-entrypoint.sh:ro
      - certbot_webroot_gpu:/var/www/certbot
      - certbot_etc_gpu:/etc/letsencrypt
      - gpu_ssl:/secrets/ssl
    depends_on:
      nginx-gpu:
        condition: service_healthy
    networks:
      - gpu_network
