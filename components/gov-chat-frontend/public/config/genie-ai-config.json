{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with dual-prompt mechanism for quick help buttons",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings. All accent variants (hover, muted, dark mode) are derived automatically from brandColor via CSS.",
      "properties": {
        "brandColor": {
          "type": "string",
          "description": "Primary brand color (hex). This is the single source for the entire accent palette.",
          "default": "#4071cb"
        },
        "bg": {
          "type": "string",
          "description": "Page background color (overrides the default light gray)"
        },
        "fg": {
          "type": "string",
          "description": "Primary text color (overrides the default dark gray)"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific overrides (optional, defaults to brand)",
          "properties": {
            "background": {
              "type": "string",
              "description": "Navbar background color (defaults to brandColor)"
            },
            "text": {
              "type": "string",
              "description": "Navbar text/icon color (auto-contrasted if omitted)"
            }
          }
        },
        "colors": {
          "type": "object",
          "description": "Override semantic status colors",
          "properties": {
            "success": { "type": "string", "description": "Success color" },
            "warning": { "type": "string", "description": "Warning color" },
            "danger": { "type": "string", "description": "Danger color" },
            "info": { "type": "string", "description": "Info color" }
          }
        },
        "typography": {
          "type": "object",
          "description": "Typography overrides",
          "properties": {
            "fontFamily": { "type": "string", "description": "Override body font stack" },
            "fontScale": { "type": "number", "description": "Multiplier for all text sizes (e.g. 1.1)" }
          }
        }
      },
      "required": [
        "brandColor"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations with dual-prompt mechanism",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "i18n key for text user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "i18n key for detailed prompt sent to LLM"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "action",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "GENIE.AI",
    "icon": {
      "type": "file",
      "value": "/config/logo-genie-ai.jpeg"
    }
  },
  "theme": {
    "brandColor": "#4071cb"
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to GENIE.AI, for Global Empowerment, Intelligence and Equity",
      "botName": "GENIE.AI",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "action": {
              "visibleText": "quickhelp.justChatUserPrompt",
              "hiddenPrompt": "quickhelp.justChatPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "identity-civil",
            "title": "quickhelp.applyForID",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/identity-civil.svg"
            },
            "category": "1",
            "action": {
              "visibleText": "quickhelp.applyForIDUserPrompt",
              "hiddenPrompt": "quickhelp.applyForIDPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "taxes-revenue",
            "title": "quickhelp.payTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/taxes-revenue.svg"
            },
            "category": "5",
            "action": {
              "visibleText": "quickhelp.payTaxesUserPrompt",
              "hiddenPrompt": "quickhelp.payTaxesPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "business-trade",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-trade.svg"
            },
            "category": "8",
            "action": {
              "visibleText": "quickhelp.startBusinessUserPrompt",
              "hiddenPrompt": "quickhelp.startBusinessPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "healthcare-social",
            "title": "quickhelp.findHealthcare",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/healthcare-social.svg"
            },
            "category": "2",
            "action": {
              "visibleText": "quickhelp.findHealthcareUserPrompt",
              "hiddenPrompt": "quickhelp.findHealthcarePrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "education-learning",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": "3",
            "action": {
              "visibleText": "quickhelp.educationServicesUserPrompt",
              "hiddenPrompt": "quickhelp.educationServicesPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "transportation-mobility",
            "title": "quickhelp.transportLicenses",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/transportation-mobility.svg"
            },
            "category": "7",
            "action": {
              "visibleText": "quickhelp.transportLicensesUserPrompt",
              "hiddenPrompt": "quickhelp.transportLicensesPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "housing-urban",
            "title": "quickhelp.housingPrograms",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/housing-urban.svg"
            },
            "category": "9",
            "action": {
              "visibleText": "quickhelp.housingProgramsUserPrompt",
              "hiddenPrompt": "quickhelp.housingProgramsPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "employment-labor",
            "title": "quickhelp.findJobs",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/employment-labor.svg"
            },
            "category": "4",
            "action": {
              "visibleText": "quickhelp.findJobsUserPrompt",
              "hiddenPrompt": "quickhelp.findJobsPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          }
        ]
      }
    }
  },
  "custom": {}
}
