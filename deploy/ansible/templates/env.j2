{# VictoriaLogs multi-tenancy uses two HTTP headers (account + project) on
   every write. The env var `VICTORIALOGS_TENANT_ID` carries the combined
   `account:project` value (default 0:0); split it here so the
   docker-compose.yaml collector stanza can populate both
   `VICTORIALOGS_TENANT_ID_ACCOUNT_ID` and `VICTORIALOGS_TENANT_ID_PROJECT_ID`
   without further splitting. Without this Jinja split, any Ansible deploy
   with a non-default tenant silently routes writes to tenant 0:0 (the
   account+project IDs default to 0) while the backend reads from the
   operator-configured tenant — every deploy is broken. #}
{% set _vl_tenant = (victorialogs_tenant_id | default('0:0')) %}
{% set _vl_tenant_parts = _vl_tenant.split(':', 1) %}
VICTORIALOGS_TENANT_ID_ACCOUNT_ID={{ _vl_tenant_parts[0] | default('0') }}
VICTORIALOGS_TENANT_ID_PROJECT_ID={{ _vl_tenant_parts[1] | default('0') }}
VL_QUERY_TIMEOUT_MS={{ vl_query_timeout_ms | default('30000') }}
{# T8 contract: VL outage surfaces as `VlUnavailableError` (HTTP 503,
