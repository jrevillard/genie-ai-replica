{% endfor %}

# RUNTIME THEME CONFIG MOUNTS (mount sources for /config/ bind mounts)
# Populated on each node by the config_bootstrap role (tag: config).
# CONFIG_DIR_KEYCLOAK is the themes ROOT (all themes, e.g. genie +
# genie-el-salvador), mounted at /opt/keycloak/themes — never a single theme,
# so parent=genie references in extra themes can resolve.
CONFIG_DIR_FRONTEND={{ config_dir }}/frontend
CONFIG_DIR_KEYCLOAK={{ config_dir }}/keycloak/themes
{% if data_dir and data_dir != './data' %}DATA_DIR={{ data_dir }}
{% endif %}

# =============================================================================
# SECTION 18: REMOTE GPU NODE (OPTIONAL)
# =============================================================================
{% if gpu_node_host is defined and gpu_node_host | length > 0 %}
GPU_MODEL_REPLICAS=0
GPU_NODE_HOST={{ gpu_node_host }}
VLLM_ENDPOINT={{ _gpu_base }}/llm
VLLM_TRANSLATION_ENDPOINT={{ _gpu_base }}/translation
EMBEDDING_SERVICE_URL={{ _gpu_base }}/embed
RERANKER_SERVICE_URL={{ _gpu_base }}/rerank
DOCLING_ENDPOINT={{ _gpu_base }}/docling
{% endif %}

# =============================================================================
# SECTION 19: NODE.JS TLS VERIFICATION (OPTIONAL)
# =============================================================================
{% if node_tls_reject_unauthorized is defined and node_tls_reject_unauthorized | length > 0 %}NODE_TLS_REJECT_UNAUTHORIZED={{ node_tls_reject_unauthorized }}
{% endif %}

# =============================================================================
# SECTION 20: OPEA RUNTIME PATCHES (OPTIONAL)
# =============================================================================
{% if opea_ssl_skip_verify is defined and opea_ssl_skip_verify | length > 0 %}OPEA_SSL_SKIP_VERIFY={{ opea_ssl_skip_verify }}
{% endif %}

# =============================================================================
# SECTION 21: KEYCLOAK SSL (OPTIONAL)
# =============================================================================
{% if keycloak_ssl_skip_verify is defined and keycloak_ssl_skip_verify | length > 0 %}KEYCLOAK_SSL_SKIP_VERIFY={{ keycloak_ssl_skip_verify }}
{% endif %}

# =============================================================================
# SECTION 22: (IMAGE_TAG deprecated — replaced by per-service GENIE_AI_*_IMAGE_TAG in Section 17)
# =============================================================================
