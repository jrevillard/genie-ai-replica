# Note: keycloak-config service uses its own internal KEYCLOAK_URL (http://keycloak:8080)
# REQUIRED — app will not start without this value
KEYCLOAK_URL=https://localhost/auth

# Keycloak redirect URIs and web origins are auto-derived from NGINX_PUBLIC_DOMAIN + NGINX_HTTPS_PORT:
#   KC_PUBLIC_ORIGIN=https://<NGINX_PUBLIC_DOMAIN>[:<NGINX_HTTPS_PORT>]
# This is set internally in docker-compose.yaml (keycloak-config service).
# If you use a non-standard HTTPS port (e.g. 8443), set NGINX_HTTPS_PORT in .env — no other changes needed.

# Keycloak realm name
# REQUIRED — app will not start without this value
KEYCLOAK_REALM=genie

# OIDC client ID for the GENIE.AI application
# REQUIRED — app will not start without this value
KEYCLOAK_CLIENT_ID=genie-app

# OIDC client secret (REQUIRED — generate a strong value)
# Used by: backend (token validation), keycloak-config-cli (realm setup)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_CLIENT_SECRET=

# Additional Keycloak realms for backend token validation (JSON array of realm names)
# Each additional realm must have a corresponding OIDC client configured in Keycloak admin console
# with Authorization Code Flow + PKCE enabled and Valid Redirect URIs set to the frontend URL.
# The frontend only authenticates against the primary realm (KEYCLOAK_REALM).
# Users from additional realms authenticate via their own Keycloak login URL.
# Example: KEYCLOAK_ADDITIONAL_REALMS=["partner-org","contractor"]
# KEYCLOAK_ADDITIONAL_REALMS=

# Keycloak master admin password (REQUIRED — set a strong value)
# Used by: admin console access, keycloak-config-cli (master realm authentication)
# WARNING: This is the master admin account password (NOT the GENIE realm admin)
KEYCLOAK_ADMIN_PASSWORD=

# GENIE realm admin username (default: genie-admin)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
# GENIE_ADMIN_USERNAME=genie-admin

# GENIE realm admin password (REQUIRED — must satisfy KEYCLOAK_PASSWORD_POLICY)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
GENIE_ADMIN_PASSWORD=

# GENIE realm admin email (REQUIRED — must be a valid email address)
# Used by: keycloak-config-cli (creates admin user in GENIE realm)
GENIE_ADMIN_EMAIL=

# Keycloak PostgreSQL password (REQUIRED — must differ from POSTGRES_PASSWORD)
# Used by: postgres-init (creates dedicated 'keycloak' DB user), keycloak service
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_DB_PASSWORD=

# Keycloak database configuration
# Uses the shared PostgreSQL instance with a dedicated 'keycloak' database and user
# Used by: keycloak service
# KC_DB=postgres

# Keycloak PostgreSQL JDBC URL
# Points to the shared PostgreSQL instance, 'keycloak' database
# KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# Keycloak PostgreSQL username (dedicated user, created by postgres-init)
# KC_DB_USERNAME=keycloak

# Valid redirect URIs for the OIDC client
# Default: http://localhost:8090/* (frontend dev URL)
# Production: https://your-domain.com/*
# KEYCLOAK_VALID_REDIRECT_URIS=http://localhost:8090/*

# Web origins for CORS
# Default: http://localhost:8090 (frontend dev URL)
# Production: https://your-domain.com
# KEYCLOAK_WEB_ORIGINS=http://localhost:8090

# TLS verification for Node.js services (backend, document-repository).
# Affects all HTTPS connections: backend → NGINX OIDC/JWKS fetches,
# backend → Keycloak token introspection, document-repository → NGINX.
# Default: 1 (strict, production). Set to 0 for local dev with self-signed NGINX certs.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Keycloak proxy service account (REQUIRED — set a strong value)
# Used by: backend (keycloak-admin-service.js) for Admin API proxy operations
# The genie-proxy-client has restricted permissions: manage-users, view-users,
# manage-roles, query-users ONLY. Cannot modify realm settings or client config.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_PROXY_CLIENT_SECRET=

# Dataprep service account client (client_credentials grant for service-to-service auth)
# Used by: Dataprep → Document Repository and Backend API calls
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KC_DATAPREP_CLIENT_ID=dataprep-service-client
KC_DATAPREP_CLIENT_SECRET=

# Mobile OIDC client for institutional deployments (Flutter app)
# Public client with PKCE — no client secret required (RFC 8252).
# Change per deployment: each institution needs its own clientId and redirect scheme.
# Used by: keycloak-config-cli (creates the mobile OIDC client in Keycloak at startup)
# See: site/content/en/docs/deployment/mobile-deployment-guide.md (deployment onboarding guide)
KC_MOBILE_CLIENT_ID=genie-mobile-<institution>

# Mobile app custom URL scheme for OIDC callback redirect.
# MUST match the following across all config layers (scheme coherence rule):
#   1. redirectScheme in Dart flavor config (lib/config/flavors/*.dart)
#   2. appAuthRedirectScheme in android/app/build.gradle manifestPlaceholders
#   3. APP_AUTH_REDIRECT_SCHEME in iOS XCConfig (ios/Flutter/*.xcconfig)
#   4. This variable in .env (used by keycloak-config-cli for Keycloak client redirectUris)
# A mismatch causes silent OIDC callback failure — the browser redirects to the wrong
# scheme and the app never receives the authorization code.
KC_MOBILE_REDIRECT_SCHEME=com.<institution>.genieai

