# Translator backend — OpenAI (default) vs self-hosted Gemma.
# Flip to "true" to route all EN↔MA translation (chat replies, PDFs,
# auto-translator, translate_batch) through a Gemma vLLM endpoint
# instead of OpenAI. Requires the Gemma container or Cloudflare tunnel
# to be reachable from the chatqna service.
USE_GEMMA_TRANSLATOR=false
GEMMA_BASE_URL=http://vllm-translation-guardrail:9031/v1
GEMMA_MODEL=google/gemma-3-4b-it
GEMMA_API_KEY=not-needed

