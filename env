# Multi-turn vector-space blending (issue #833). Blends the query embedding
# with the previous N turns' embedding (V = α·EQ + (1-α)·EH) at the retriever's
# dense leg, so pronoun-heavy follow-ups ("can you elaborate on this?") retrieve
# the prior turn's subject. Default OFF (no-op). Adds ONE embedding call per
# multi-turn query. Query-time feature; unrelated to ingest-time
# CONTEXTUAL_RETRIEVAL_ENABLED. Only the dense leg is blended; the BM25/hybrid
# leg (RETRIEVER_HYBRID_RETRIEVAL_ENABLED) still uses the isolated query text.
# MULTI_TURN_BLEND_ENABLED=false
# MULTI_TURN_BLEND_ALPHA=0.7         # query weight α; 1.0 = query-only, 0.0 = history-only
# MULTI_TURN_HISTORY_TURNS=1         # number of prior turns blended (1 = previous turn only)
# MULTI_TURN_MODE=blend              # condense = per-turn standalone-query rewrite
#                                    # (fail-closed, issue #1091); blend = vector-space
#                                    # blending above. condense overrides the blend flag.
# MULTI_TURN_CONDENSE_HISTORY_TURNS=8  # conversation segments fed to the condense rewrite (8 = 4 exchanges)
# MULTI_TURN_CONDENSE_MAX_TOKENS=256   # output cap for the rewrite LLM call; a longer guided-JSON
#                                      # rewrite truncates and fails the turn (503)
# MULTI_TURN_CONDENSE_TIMEOUT_SECONDS=5.0  # fail-closed budget (s) for the rewrite call
# MULTI_TURN_CONDENSE_SYSTEM_PROMPT=       # override the rewrite prompt (must demand
#                                          # JSON-only output; unset = built-in default)

# Chat context-window: three tiers. A SET MAX_MODEL_LEN_TEXTGEN caps what
# chatqna uses even when discovery answers — a deliberate consumer-side cap
# (e.g. keep the model off its full window under load); to cap what the model
# SERVES use vLLM's --max_model_len instead. Unset, chatqna probes /v1/models
# (remote GPU node when configured, otherwise the compose-internal vLLM) and
# discovery WINS. The 65536 default only applies when the probe fails.
# Symptom that the fallback is too small for the served model: an empty
# CHAT HISTORY on large prompts.
# Used by: chatqna (genieai_chatqna.py)
# Default: 65536 (the project-standard Granite window; set lower only behind
# a non-vLLM backend serving a smaller model)
# MAX_MODEL_LEN_TEXTGEN=65536

# Fallback character budget for chat history sent to the translation model.
# Derived from the translation model's window whenever the probe answers
# (the compose translation vLLM defaults to a 2048-token window → ~2300 chars
# discovered); a SET value caps that derivation even when discovery wins —
# dense scripts like CJK produce more tokens per char than the Latin-script
# estimate, so lower this knob for such deployments. The fallback applies
# where the probe fails.
# Used by: chatqna (genieai_chatqna.py)
# Default: 2000
# MAX_TRANSLATION_CHARS=2000

# Window-discovery refresh shares the MODEL_DETECT_TTL knob (same cache entry
# as model-id detection — under traffic the entry refreshes every 60 s).

# Application session lifetime for automatic purging (MILLISECONDS, NOT seconds or minutes).
# Controls how long an inactive analytics session is kept before automatic cleanup.
# Used by: backend (session-service.js)
# Default: 1800000 (30 minutes in milliseconds)
# IMPORTANT: Value is in MILLISECONDS. Common values:
#   15 minutes = 900000
#   30 minutes = 1800000 (default)
#   1 hour     = 3600000
# Alignment with Keycloak: set this value to match or slightly exceed Keycloak's
# SSO Session Max or Access Token Lifespan to ensure sessions are purged after
# the user's authentication expires.
# SESSION_EXPIRATION_TIME=

