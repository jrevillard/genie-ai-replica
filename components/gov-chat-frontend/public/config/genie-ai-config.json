{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with dual-prompt mechanism for quick help buttons",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings. All accent variants (hover, muted, dark mode) are derived automatically from brandColor via CSS.",
      "properties": {
        "brandColor": {
          "type": "string",
          "description": "Primary brand color (hex). This is the single source for the entire accent palette.",
          "default": "#4071cb"
        },
        "bg": {
          "type": "string",
          "description": "Page background color (overrides the default light gray)"
        },
        "fg": {
          "type": "string",
          "description": "Primary text color (overrides the default dark gray)"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific overrides (optional, defaults to brand)",
          "properties": {
            "background": {
              "type": "string",
              "description": "Navbar background color (defaults to brandColor)"
            },
            "text": {
              "type": "string",
              "description": "Navbar text/icon color (auto-contrasted if omitted)"
            }
          }
        },
        "colors": {
          "type": "object",
          "description": "Override semantic status colors",
          "properties": {
            "success": {
              "type": "string",
              "description": "Success color"
            },
            "warning": {
              "type": "string",
              "description": "Warning color"
            },
            "danger": {
              "type": "string",
              "description": "Danger color"
            },
            "info": {
              "type": "string",
              "description": "Info color"
            }
          }
        },
        "typography": {
          "type": "object",
          "description": "Typography overrides",
          "properties": {
            "fontFamily": {
              "type": "string",
              "description": "Override body font stack"
            },
            "fontScale": {
              "type": "number",
              "description": "Multiplier for all text sizes (e.g. 1.1)"
            }
          }
        }
      },
      "required": [
        "brandColor"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations with dual-prompt mechanism",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "i18n key for text user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "i18n key for detailed prompt sent to LLM"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "action",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "MEWA Bangladesh",
    "icon": {
      "type": "file",
      "value": "/config/genie-ai-icon-light.svg"
    }
  },
  "theme": {
    "brandColor": "#6B9E7A",
    "bg": "#F5F2EC",
    "fg": "#141517",
    "navbar": {
      "background": "#1F4A5E",
      "text": "#FFFFFF"
    },
    "typography": {
      "fontFamily": "\"DM Sans\", -apple-system, \"Helvetica Neue\", Arial, sans-serif"
    },
    "colors": {
      "surface": "#FDFCFA",
      "accent-secondary": "#1F4A5E"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": {
        "en": "Welcome to MEWA! Ask me about this week's weather, risks to your rice, eggplant, mango or turmeric crops, drought status or planting advice for your district.",
        "bn": "MEWA-তে স্বাগতম! এই সপ্তাহের আবহাওয়া, আপনার ধান, বেগুন, আম বা হলুদ ফসলের ঝুঁকি, খরার অবস্থা বা আপনার জেলার জন্য রোপণের পরামর্শ সম্পর্কে আমাকে জিজ্ঞাসা করুন।"
      },
      "botName": "GENIE.AI",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": {
              "en": "Just Chat",
              "bn": "শুধু চ্যাট করুন"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null
          },
          {
            "id": "weather-week",
            "title": {
              "en": "Weather this week",
              "bn": "এই সপ্তাহের আবহাওয়া"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/weather.svg"
            },
            "category": null,
            "action": {
              "visibleText": {
                "en": "What is the weather forecast for this week in my district?",
                "bn": "আমার জেলায় এই সপ্তাহের আবহাওয়ার পূর্বাভাস কী?"
              },
              "hiddenPrompt": {
                "en": "What is the weather forecast for this week in {{location}}? Summarise it in plain words a farmer can act on, then say what it means for the crops grown here.",
                "bn": "What is the weather forecast for this week in {{location}}? Summarise it in plain words a farmer can act on, then say what it means for the crops grown here."
              }
            }
          },
          {
            "id": "drought-status",
            "title": {
              "en": "Drought conditions",
              "bn": "খরার অবস্থা"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/drought.svg"
            },
            "category": null,
            "action": {
              "visibleText": {
                "en": "What are the drought conditions in my area?",
                "bn": "আমার এলাকায় খরার অবস্থা কেমন?"
              },
              "hiddenPrompt": {
                "en": "What are the current drought conditions in {{location}}?",
                "bn": "What are the current drought conditions in {{location}}?"
              }
            }
          },
          {
            "id": "field-map",
            "title": {
              "en": "Map my field",
              "bn": "আমার জমির মানচিত্র"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/map.svg"
            },
            "category": null,
            "action": {
              "visibleText": {
                "en": "Show me my field boundaries on the map",
                "bn": "মানচিত্রে আমার জমির সীমানা দেখান"
              },
              "hiddenPrompt": {
                "en": "Delineate field boundaries around {{location}}",
                "bn": "Delineate field boundaries around {{location}}"
              }
            }
          },
          {
            "id": "flood-map",
            "title": {
              "en": "Flood extent",
              "bn": "বন্যার বিস্তার"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/housing-urban.svg"
            },
            "category": null,
            "action": {
              "visibleText": {
                "en": "Show flood extent in my area",
                "bn": "আমার এলাকায় বন্যার বিস্তার দেখান"
              },
              "hiddenPrompt": {
                "en": "Show the satellite flood map for {{location}}",
                "bn": "Show the satellite flood map for {{location}}"
              }
            }
          },
          {
            "id": "crop-planning",
            "title": {
              "en": "Plan my season",
              "bn": "আমার মৌসুম পরিকল্পনা"
            },
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": null,
            "action": {
              "visibleText": {
                "en": "When should I plant this season and what should I expect?",
                "bn": "এই মৌসুমে কখন রোপণ করব এবং কী আশা করব?"
              },
              "hiddenPrompt": {
                "en": "When should I plant this season in {{location}}, for the crops grown here? What weather should I expect at each growth stage?",
                "bn": "When should I plant this season in {{location}}, for the crops grown here? What weather should I expect at each growth stage?"
              }
            }
          }
        ]
      }
    }
  },
  "custom": {}
}
