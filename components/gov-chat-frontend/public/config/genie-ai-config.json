{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with a darker light blue theme inspired by ITU website banner",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "prompt": {
                        "type": "string",
                        "description": "i18n key for the prompt to send when clicked"
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "prompt",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Agrivisory-Lesotho",
    "icon": {
      "type": "file",
      "value": "/config/logo-v3.webp"
    }
  },
  "theme": {
    "primaryColor": "#4A8C5C",
    "secondaryColor": "#2E7D4A",
    "backgroundColor": "#E8F5E9",
    "textColor": "#1C2526",
    "navbar": {
      "gradientStart": "#4A8C5C",
      "gradientEnd": "#2E7D4A",
      "textColor": "#F0FFF4"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to Agrivisory-Lesotho — AI Agriculture Advisory for Smallholder Farmers",
      "botName": "Agrivisory"

    }
  },
  "custom": {},
  "weather": {
    "defaultLocation": "maseru",
    "locations": [
      { "id": "maseru", "name": "Maseru", "latitude": -29.3167, "longitude": 27.4833 },
      { "id": "berea", "name": "Berea (Teyateyaneng)", "latitude": -29.1500, "longitude": 27.7500 },
      { "id": "leribe", "name": "Leribe (Hlotse)", "latitude": -28.8833, "longitude": 28.0500 },
      { "id": "butha-buthe", "name": "Butha-Buthe", "latitude": -28.7667, "longitude": 28.2500 },
      { "id": "mokhotlong", "name": "Mokhotlong", "latitude": -29.2833, "longitude": 29.0667 },
      { "id": "thaba-tseka", "name": "Thaba-Tseka", "latitude": -29.5167, "longitude": 28.6000 },
      { "id": "qachas-nek", "name": "Qacha's Nek", "latitude": -30.1167, "longitude": 28.6833 },
      { "id": "quthing", "name": "Quthing", "latitude": -30.4000, "longitude": 27.7000 },
      { "id": "mohales-hoek", "name": "Mohale's Hoek", "latitude": -30.1500, "longitude": 27.4667 },
      { "id": "mafeteng", "name": "Mafeteng", "latitude": -29.8167, "longitude": 27.2333 }
    ]
  }
}
