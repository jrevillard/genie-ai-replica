{
    "name": "document-repository",
    "version": "0.1.0",
    "description": "Document repository backend with file upload, virus scanning, and search capabilities",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "test:contract": "jest --testPathPattern='src/__tests__/unit/(controllers|middlewares)/'",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.js\""
    },
    "keywords": [
        "document",
        "repository",
        "upload",
        "search",
        "arangodb"
    ],
    "dependencies": {
        "arangojs": "^8.8.1",
        "archiver": "7.0.1",
        "async-retry": "^1.3.3",
        "axios": "^1.19.0",
        "cheerio": "^1.0.0-rc.12",
        "clamscan": "^2.4.0",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.0",
        "file-type": "^18.7.0",
        "geoip-lite": "^2.0.3",
        "helmet": "^7.1.0",
        "joi": "^17.11.0",
        "jose": "^5.0.0",
        "langdetect": "^0.2.1",
        "mammoth": "^1.11.0",
        "mime-types": "^2.1.35",
        "multer": "^2.2.0",
        "pdf-parse": "^1.1.4",
        "swagger-jsdoc": "6.2.8",
        "swagger-ui-express": "^5.0.0",
        "turndown": "^7.2.2",
        "uuid": "^11.0.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^29.5.8",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "jest": "^29.7.0",
        "jest-junit": "^17.0.0",
        "nodemon": "^3.0.1",
        "prettier": "^3.8.1",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "overrides": {
        "js-yaml": "^4.1.1"
    }
}
