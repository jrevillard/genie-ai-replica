# ─── OAuth (Google / Facebook login) ─────────────────────────────────
# Added 2026-05-04. Client secret intentionally omitted: backend verifies
# the user's access_token via googleapis.com/oauth2/v3/userinfo, which
# does not require the secret. Add GOOGLE_OAUTH_CLIENT_SECRET here later
# if you wire up server-side ID-token verification or refresh-token flow.
GOOGLE_OAUTH_CLIENT_ID=388978201475-a3s7di74d4dciokr9mq34ec62b659h11.apps.googleusercontent.com

# ─── Stable JWT secret (multi-worker fix, 2026-05-04) ────────────────
# uvicorn runs with --workers 4. Without this set, each worker
# generated its own per-process random JWT_SECRET, so a token signed
# by one worker would fail verification on another worker. Symptom:
# random 401 "Invalid token" on /training/consent/me, /caregiver/*,
# /agent/* — anything that auth-checks via verify_jwt.
JWT_SECRET=5100d320cac9a37a12b4f71057cb478c0bd039d5fa7859bc981416d8f4e03371

# ─── Facebook Login (added 2026-05-04) ───────────────────────────────
# Same app as MESSENGER_* above ("Amina wsp" — App ID 1388627716614900).
# App Secret is the same shared secret used for the WhatsApp / Messenger
# webhooks; backend currently doesn't strictly need it for OAuth (it
# verifies the user's access_token via graph.facebook.com/me) but
# storing it here keeps the app-level config consolidated and lets us
# wire server-side webhook signature checks later without another env
# round-trip.
FACEBOOK_APP_ID=1388627716614900
FACEBOOK_APP_SECRET=67b6ad30441d7cfa77798ac4af7810d2

# ─── API Gateway admin secret (Phase 2a, 2026-05-04) ─────────────────
# Used to authenticate POST /api/v1/admin/issue-token. Without this
# set in .env, the gateway generates a random secret per container
# start which breaks any external issuance script across restarts.
AMINA_GATEWAY_ADMIN_SECRET=2f907f952b889c0c00c58f1ce2769468c73d331f28ddf2d6d4f4bcafe7d2ccf8

# === Abuse Defense (activated 2026-05-04 for UNICC manual testing) ===
# Behaviour: 4 abuses past WARNING_3 -> session_terminate (one-shot per
# user). 4 more on a future cycle -> 30 min cool-down. Then 24 h, 7 d.
# Distress / emergency / minor protection always bypass the ladder.
# Doc: docs/compliance/ABUSE_DEFENSE_LOGIC_AND_TEST_RESULTS.md
AMINA_ABUSE_DEFENSE_ENABLED=true
AMINA_ABUSE_DEFENSE_MODE=enforce

# ── Agent Platform v1 + native function-calling (added 2026-05-06) ──
# Turning the agent platform on means the planner runs as a prepass on
# every chat: it picks read-only tools (V1_ALLOWED_RISKS-filtered),
# executes them, and injects the results into the generator's context.
# Native function-calling routes through OpenAI/Gemini's native tool
# API instead of the v1 JSON-string parse — cleaner, fewer parse fails.
# Both paths are fail-open (AMINA_AGENTIC_FAIL_OPEN=true), so any
# planner / native-call crash silently degrades to legacy behaviour.
AMINA_AGENTIC_MODE=assist
AMINA_AGENTIC_NATIVE_TOOLS=true
