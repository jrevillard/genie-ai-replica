#=========DATAPREP GENIE-AI EXTENSIONS =========
# URL for the Node.js Document Repository Service (internal docker network name)
DOCUMENT_REPOSITORY_URL=http://document-repository:3001
# URL to the backend component used to fetch the knowledge hierarchy
BACKEND_SERVICE_URL=http://backend:3000
# Labeling Strategy: 'llm', 'embedding', or 'bm25'
LABELING_STRATEGY=llm
# Thresholds for alternative strategies
EMBEDDING_LABEL_THRESHOLD=0.75
BM25_LABEL_THRESHOLD=2.00
# Extraction Method: 'opea' or 'docling'
CONTENT_EXTRACTION_METHOD=docling
# System prompt for defining labels with the LLM
LABEL_SELECTOR_SYSTEM_PROMPT="You are a precise semantic labeler for a RAG system. Assign 1 to 3 MOST RELEVANT labels from the provided list. Return ONLY strongly relevant labels."
# Optional: Override the system prompt for labeling
# LABEL_SELECTOR_SYSTEM_PROMPT="Your custom prompt here..."

