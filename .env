RETRIEVER_SUMMARIZER_ENABLED=false

#=========RERANKER SERVICE =========
# RERANK_SERVER_HOST_IP=tei_reranker
# RERANK_SERVER_PORT=80
RERANK_SERVER_HOST_IP=reranker
RERANK_SERVER_PORT=8000
RERANK_COMPONENT_NAME=GENIE_TEI_RERANKING
# Controls what strategy the reranker uses for determining the number of documents passed on to the LLM. 
# Can be set to: 'slice', 'threshold', and 'knee_threshold'
RERANKING_STRATEGY=slice
# Controls the number of chunks returned by reranker if RERANKING_STRATEGY is 'slice'
RERANKER_TOP_N=5
# Defines the threshold value used by reranker if RERANKING_STRATEGY is 'threshold', default is 0.75
RERANKING_THRESHOLD=0.30

#=========VLLM SERVICE =========
VLLM_ENDPOINT=http://vllm:8000
# System prompt for responding to user queries based on retrieved content
# The system prompt is appended by: 
# (1) user profile info 
# (2) chat history
# (3) Content, returned by the re-ranker 
CHATQNA_ENFORCE_ABSTENTION=true
CHATQNA_ABSTENTION_INSTRUCTIONS="The knowledge base search did not return relevant or sufficient information. Clearly inform the user that you do not have enough verified information to answer their query. Keep the response concise and transparent. Do not fabricate or infer missing details. Encourage the user to provide more specific details, rephrase their question, or choose a different topic."
#=========VLLM INFERENCE CONFIG =========
# The model used for main chat/generation (Service: vllm)
# Defaults to the granite model 
VLLM_LLM_MODEL_ID=ibm-granite/granite-3.3-2b-instruct
VLLM_MODEL_ID=ibm-granite/granite-3.3-2b-instruct
VLLM_GPU_UTIL=0.35
VLLM_MAX_MODEL_LEN=16384
VLLM_DTYPE=half

#=========TEXTGEN SERVICE =========
TEXTGEN_PORT=9000

#=========VLLM TRANSLATION/GUARDRAIL CONFIG =========
VLLM_TRANSLATION_SERVICE_PORT=9031
# The model used for guardrails and translation (Service: vllm-translation-guardrail)
# Defaults to the gemma model 
VLLM_TRANSLATION_MODEL_ID=google/gemma-3-4b-it
VLLM_TRANSLATION_GPU_UTIL=0.35
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_DTYPE=auto
VLLM_TRANSLATION_KV_CACHE_DTYPE=auto

#=========GUARDRAIL SERVICE CONFIG =========
VLLM_TRANSLATION_ENDPOINT=http://vllm-translation-guardrail:9031

#=========TEI SERVICE CONFIG =========
RUST_BACKTRACE=1
NVIDIA_VISIBLE_DEVICES=all

#=========EMBEDDING AND RERANKING MODELS =========
EMBEDDING_MODEL_ENDPOINT=http://tei:80
TEI_EMBEDDING_ENDPOINT=http://tei:80
# This is the embedding model used by the OPEA embedding service
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
# This reranker model is only needed for multi-lingual backends and is a RoBERTa architecture not BERT. Not compatible with TEI
#RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# This is a correct reranker model to use for the reranker image
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
# This is the TEI embedding model and the vector dimensions need to equal the model used for the OPEA embedding service above
TEI_EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL_ENDPOINT=http://tei_reranker:80
TEI_RERANKING_ENDPOINT=http://tei_reranker:80

#=========TELEMETRY (optional) =========
# JAEGER_IP=127.0.0.1
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=grpc://127.0.0.1:4317
OPEA_PATH=/v1/chatqna
CHATQNA_SYSTEM_PROMPT="You are Keletso, an agricultural advisor for Lesotho extension workers. RULE 1 - TOPIC CHECK: If the question is NOT about agriculture, farming, crops, livestock, pests, soil, fertiliser, seeds, weather affecting crops, market prices for farm produce, or government agricultural programs, respond ONLY with: I am Keletso, your agricultural advisor for Lesotho. I can only assist with farming and agriculture questions. RULE 2 - USE CONTEXT: Base answers on the provided context. If context lacks specific details, use your agricultural knowledge for Lesotho conditions. RULE 3 - VARIETIES: Recommend locally appropriate varieties when asked. RULE 4 - UNKNOWN: If you truly cannot answer, say: I do not have that information in my knowledge base. Please contact your local extension officer. RULE 5 - BREVITY: Maximum 4 sentences. RULE 6 - IDENTITY: Always refer to yourself as Keletso."
