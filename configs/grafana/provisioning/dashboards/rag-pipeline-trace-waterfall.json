      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (http_status_code) (increase(http_server_duration_milliseconds_count{service_name=~\"genie-backend|genieai-chatqna|genieai-retriever|genieai-reranker|genieai-dataprep\"}[5m]))",
          "legendFormat": "{{http_status_code}}",
