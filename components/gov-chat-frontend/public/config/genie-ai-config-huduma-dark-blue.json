{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with a darker blue theme for Huduma AI",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI Chatbot"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "prompt": {
                        "type": "string",
                        "description": "i18n key for the prompt to send when clicked"
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "prompt",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Huduma AI",
    "icon": {
      "type": "file",
      "value": "/config/huduma-icon.svg"
    }
  },
  "theme": {
    "primaryColor": "#255C92",
    "secondaryColor": "#132F4D",
    "backgroundColor": "#D9E2EA",
    "textColor": "#151B1C",
    "navbar": {
      "gradientStart": "#1F4B7A",
      "gradientEnd": "#0D243D",
      "textColor": "#E7ECEF"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to Huduma AI, your public service assistant!",
      "botName": "Huduma",
      "quickHelp": {
        "buttons": [
          {
            "id": "justChat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "prompt": "quickhelp.justChatPrompt",
            "styles": {
              "backgroundColor": "#f0f7ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#a3ceff"
            }
          },
          {
            "id": "idApplication",
            "title": "quickhelp.applyForID",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/id-application.svg"
            },
            "category": "1",
            "prompt": "quickhelp.applyForIDPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "businessRegistration",
            "title": "quickhelp.registerBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-registration.svg"
            },
            "category": "2",
            "prompt": "quickhelp.registerBusinessPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "taxFiling",
            "title": "quickhelp.fileTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/tax-filing.svg"
            },
            "category": "3",
            "prompt": "quickhelp.fileTaxesPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "licenseRenewal",
            "title": "quickhelp.renewLicense",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/license-renewal.svg"
            },
            "category": "4",
            "prompt": "quickhelp.renewLicensePrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "healthServices",
            "title": "quickhelp.accessHealthServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/health-services.svg"
            },
            "category": "5",
            "prompt": "quickhelp.accessHealthServicesPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "educationInfo",
            "title": "quickhelp.findEducationInfo",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-info.svg"
            },
            "category": "6",
            "prompt": "quickhelp.findEducationInfoPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "socialServices",
            "title": "quickhelp.accessSocialServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/social-services.svg"
            },
            "category": "7",
            "prompt": "quickhelp.accessSocialServicesPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          },
          {
            "id": "legalAid",
            "title": "quickhelp.getLegalAid",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/legal-aid.svg"
            },
            "category": "8",
            "prompt": "quickhelp.getLegalAidPrompt",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d6e4ff"
            }
          }
        ]
      }
    }
  },
  "custom": {}
}