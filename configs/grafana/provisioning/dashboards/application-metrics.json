      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{http_status_code=~\"5..\"}[5m])) / sum(increase(http_requests_total[5m])) * 100",
          "legendFormat": "Backend 5xx Rate",
          "refId": "K"
        },
        {
          "expr": "sum(increase(genie_ai_chat_request_total{error=\"true\"}[5m])) / sum(increase(genie_ai_chat_request_total[5m])) * 100",
          "legendFormat": "Chat Error Rate",
          "refId": "L"
