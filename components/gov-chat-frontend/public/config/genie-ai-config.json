            }
          },
          {
            "id": "weather-seasons",
            "title": "quickhelp.housingPrograms",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/weather-seasons.svg"
            },
            "category": null,
            "categoryNameEN": "Weather & seasons",
            "action": {
              "visibleText": "quickhelp.housingProgramsUserPrompt",
              "hiddenPrompt": "quickhelp.housingProgramsPrompt"
            },
            "styles": {
