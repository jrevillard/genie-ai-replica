# ======== Stage 1: The OPEA Base ========
# This stage clones the external OPEA repository at a specific version.
ARG OPEA_REPO_URL="https://github.com/opea-project/GenAIComps.git"
ARG OPEA_VERSION="v1.5" # This tag can be changed to upgrade OPEA
FROM alpine/git:v2.52.0 AS opea_base

ARG OPEA_REPO_URL
ARG OPEA_VERSION

WORKDIR /src
# Clone only the specified branch/tag, with no history for speed
RUN git clone --depth 1 --branch ${OPEA_VERSION} ${OPEA_REPO_URL} .

# ======== Final Stage: Assembly ========
# Match OPEA v1.5's dataprep base (python:3.11-slim). No GPU is granted to
# dataprep in docker-compose.yaml (only gpu-models profile services get one),
# so the CUDA base is unnecessary; the slim base also retires the Ubuntu
# update-alternatives python3.10 machinery in one stroke.
FROM python:3.11-slim

# ARG for Hugging Face token is NO LONGER NEEDED.
WORKDIR /app

# Step A: Install System Dependencies
# All required system libraries for OPEA dataprep (matches OPEA v1.5's apt list,
# plus GENIE.AI additions: libgl1 + libglib2.0-0 for opencv (the lock installs
# non-headless opencv-python transitively via unstructured-inference; its cv2
# extension links libgthread-2.0.so.0/libglib-2.0.so.0, which python:3.11-slim
# does not ship), unzip + ca-certificates for the EasyOCR model pre-download
# below). libmariadb-dev is required because the 'mariadb' python package has
# no manylinux wheel and compiles against it.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --fix-missing \
    build-essential \
    default-jre \
    ffmpeg \
    libcairo2 \
    libgl1 \
    libglib2.0-0 \
    libjemalloc-dev \
    libmariadb-dev \
    libpq-dev \
    libreoffice \
    poppler-utils \
    tesseract-ocr \
    wget \
    curl \
    unzip \
    ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add /app (for 'comps'), the dataprep 'src' (for entrypoint),
# and 'proto' (for api_protocol) to PYTHONPATH
ENV PYTHONPATH="${PYTHONPATH}:/app:/app/comps/dataprep/src:/app/comps/dataprep/src/integrations:/app/comps/cores/proto"

# Step B: Copy the entire OPEA 'comps' directory from the clone
COPY --from=opea_base /src/comps/ /app/comps/

# Step C: Upgrade pip/setuptools/wheel BEFORE any install.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Step D: Install dependencies from the committed hash-pinned lock.
# The lock is compiled with `make lock-dataprep` (uv pip compile
# --generate-hashes --python-version 3.11) from the GENIE.AI fork of OPEA
# v1.5's requirements.in. --require-hashes makes the build bit-for-bit
# reproducible and supply-chain-pinned: every wheel's SHA256 is verified at
# install time, with no re-resolution against live PyPI.
COPY genie-ai-overlay/dataprep/requirements-cpu.txt /app/requirements-cpu.txt
RUN pip install --no-cache-dir --no-deps --require-hashes -r /app/requirements-cpu.txt

# Step D.5: Post-import smoke test for heavy dependencies.
# Catches import failures (missing shared libs, ABI mismatches, bad wheels) at
# BUILD time rather than at first runtime request. These four packages are the
# heaviest / most failure-prone in the lock (pyspark requires JVM at runtime,
# unstructured links opencv + tesseract, graspologic pulls networkx + scipy stacks,
# openai-whisper pulls torch). If any import fails the build stops here —
# runtime ingest would fail the same way with a far more opaque traceback.
RUN python -c "import pyspark; import unstructured; import graspologic; import whisper; print('heavy-deps ok')"

# Copy custom utils to its new correct location (matches your structure)
COPY genie-ai-overlay/dataprep/genieai_dataprep_utils.py /app/comps/dataprep/src/genieai_dataprep_utils.py

# Step F.5: Copy shared OTel tracing module (importable from PYTHONPATH=/app)
COPY genie-ai-overlay/tracing.py /app/tracing.py

# Copy shared TTL-cached model probe (importable as core.model_cache from PYTHONPATH=/app)
COPY genie-ai-overlay/core/model_cache.py /app/core/model_cache.py

# Step G: Pre-install EasyOCR models (auto-download during build)
# This prevents the service from hanging on its one-time model download at runtime.
RUN mkdir -p /tmp/easyocr /home/user/.EasyOCR/model /home/user/.EasyOCR/config && \
# 1. Download the 'en' (English) recognition model
    wget -O /tmp/easyocr/english_g2.zip https://github.com/JaidedAI/EasyOCR/releases/download/v1.3/english_g2.zip && \
# 2. Download the text detection model
    wget -O /tmp/easyocr/craft_mlt_25k.zip https://github.com/JaidedAI/EasyOCR/releases/download/pre-v1.1.6/craft_mlt_25k.zip && \
# 3. Unzip the models
    unzip -o /tmp/easyocr/english_g2.zip -d /home/user/.EasyOCR/model && \
    unzip -o /tmp/easyocr/craft_mlt_25k.zip -d /home/user/.EasyOCR/model && \
# 4. Cleanup
    rm -rf /tmp/easyocr

# Step H: Fix docarray circular import (proactive fix, shared with retriever/reranker)
# The vendored comps/cores/proto/docarray.py shadows the real 'docarray' PyPI
# package on PYTHONPATH. docarray_alias_shim.py (wired via zz_genie_startup.pth at
# site-init by install_site_startup.sh, Step K.5) pins the real package in
# sys.modules — no vendored file is renamed or edited.
COPY genie-ai-overlay/build-patches/docarray_alias_shim.py /app/docarray_alias_shim.py

# Step I: "Overlay" our custom GENIE-AI files
# These paths are relative to the build context (our repo root)
# 1. Copy our new subclass (Section 2.1) and the loader
COPY genie-ai-overlay/dataprep/genieai_dataprep_arangodb.py /app/comps/dataprep/src/integrations/genieai_dataprep_arangodb.py
COPY genie-ai-overlay/dataprep/keycloak_service_account.py /app/comps/dataprep/src/integrations/keycloak_service_account.py

COPY genie-ai-overlay/dataprep/genieai_dataprep_loader.py /app/comps/dataprep/src/genieai_dataprep_loader.py

# 2. Overwrite OPEA's entry point with our new one
COPY genie-ai-overlay/dataprep/genieai_dataprep_microservice.py /app/comps/dataprep/src/genieai_dataprep_microservice.py

# 3. Overwrite the OPEA API protocol with our custom version
COPY genie-ai-overlay/core/genieai_api_protocol.py /app/comps/cores/proto/genieai_api_protocol.py

# Step J: Lighten library load & Fix Duplicate Registration
# 1. Comment out unused integrations in the *base* OPEA microservice.
# 2. Fix the duplicate import path for 'arangodb.py' to resolve the ValueError.
# Assert-on-patch guards: each sed MUST land or the build fails (upstream
# restructuring would otherwise ship a silently-broken image).
RUN sed -i '/from integrations\./ { /arangodb/! s/^/#/ }' /app/comps/dataprep/src/opea_dataprep_microservice.py && \
    (grep -q '^# from integrations\.' /app/comps/dataprep/src/opea_dataprep_microservice.py || \
    { echo "ASSERT-ON-PATCH GUARD FAILED: non-arangodb integrations not commented out in opea_dataprep_microservice.py -- upstream restructured the integration imports"; exit 1; })

RUN sed -i 's|from integrations.arangodb import OpeaArangoDataprep|from comps.dataprep.src.integrations.arangodb import OpeaArangoDataprep|' /app/comps/dataprep/src/opea_dataprep_microservice.py && \
    (grep -q 'from comps.dataprep.src.integrations.arangodb import OpeaArangoDataprep' /app/comps/dataprep/src/opea_dataprep_microservice.py || \
    { echo "ASSERT-ON-PATCH GUARD FAILED: Step J absolute-import rewrite did not land -- upstream restructured the arangodb import path"; exit 1; })

# Step K: Create non-root user and set permissions
RUN useradd -ms /bin/bash user && \
    chown -R user:user /app /home/user

    # Step K.5: Install the SSL bypass runtime patch via a .pth site-init hook
    # (no-op unless OPEA_SSL_SKIP_VERIFY=1). The installer derives the site-packages
    # path from the running interpreter, so no hardcoded python3.x path is needed.
    # docarray_alias_shim.py (Step H) is picked up automatically when present.
    COPY --chmod=0755 genie-ai-overlay/build-patches/install_site_startup.sh /app/install_site_startup.sh
    COPY configs/ssl/genie_ssl_patch.py /app/genie_ssl_patch.py
    RUN /app/install_site_startup.sh

# Step L: Run the new GENIE-AI entry point from its new location
USER user
CMD ["python", "comps/dataprep/src/genieai_dataprep_microservice.py"]
