# GPU Configuration for NVIDIA A40 (46GB VRAM)
# Usage: docker compose --env-file env.rtx6000 up

# ========= GPU SETTINGS  =========
# Override defaults from docker-compose.yaml for A40 optimization

# Main LLM (vllm) - Higher settings for more VRAM
VLLM_GPU_UTILIZATION=0.5
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=64

# Translation LLM (vllm-translation-guardrail)
VLLM_TRANSLATION_GPU_UTILIZATION=0.3
VLLM_TRANSLATION_MAX_MODEL_LEN=4096
VLLM_TRANSLATION_MAX_NUM_SEQS=64


