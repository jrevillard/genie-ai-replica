        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ว่าต้องการออก? การเปลี่ยนแปลงใดๆ ที่ยังไม่ได้บันทึกจะสูญหาย"
