    "Photo must be clear, recent, and show your full face" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون الصورة واضحة، حديثة، وتظهر وجهك بالكامل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto muss klar, aktuell sein und dein ganzes Gesicht zeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo must be clear, recent, and show your full face"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto debe ser clara, reciente y mostrar tu rostro completo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo doit être claire, récente et montrer votre visage entier"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto harus jelas, terbaru, dan menampilkan wajah penuh Anda"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A foto deve ser clara, recente e mostrar seu rosto inteiro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото должно быть четким, недавним и показывать ваше лицо полностью"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picha lazima iwe wazi, ya hivi karibuni, na ionyeshe uso wako kamili"
