# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_PROXY_CLIENT_SECRET=

# Dataprep service account client (client_credentials grant for service-to-service auth)
# Used by: Dataprep → Document Repository and Backend API calls
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KC_DATAPREP_CLIENT_ID=dataprep-service-client
# OKF server confidential-client secret (REQUIRED for the okf-server Keycloak
# client; empty ships a secretless confidential client). Generate: openssl rand -hex 24.
# UPGRADE NOTE (Story 6.1): okf-server enforces okf-scope authorization after this
# upgrade. Existing tools-admin holders are AUTO-GRANTED the wildcard scope by the
# keycloak-config entrypoint (non-breaking). New stewards: set the user attribute
# okf_scopes (e.g. ["okf:tenant:repo-id:admin"]) via the Keycloak admin API.
KC_OKF_SERVER_CLIENT_SECRET=

# --- OKF ingestion worker (Story 2.9.4; crawlWorker pattern) ---
# Drains parsed concepts to dataprep. OKF_INGEST_WORKER_ENABLED=false disables
# the worker entirely.
# OKF_INGEST_WORKER_ENABLED=true
# OKF_INGEST_WORKER_INTERVAL_MS=15000
# OKF_INGEST_WORKER_SWEEP_INTERVAL_MS=3600000
# PARALLEL DRAIN (David, 2026-09-03): number of independent worker lanes. Each
# lane claims a different parsed concept and drains it concurrently (requires
# dataprep to accept parallel ingests — set DATAPREP_INGEST_CONCURRENCY to
# match). 1 = the historical sequential behavior. Repos are independent units
# of work: raise both values to scale with machine capacity (e.g. 6 on a
# 24-vCPU workstation; watch dataprep/vLLM headroom).
# OKF_INGEST_CONCURRENCY=1
# IMPORT LANES (perf 2026-09-05): per-concept import pipeline parallelism in
# okf-server (creation-side import, NOT the post-publish drain). 1 = the
# historical single-flight; clamp 1..16. Raise together with
# PII_WEB_CONCURRENCY — the PII sidecar scans dominate lane time (measured
# ~100% of a 4.3 min/batch wikipedia import before the bump).
# OKF_IMPORT_CONCURRENCY=1
# Stuck-drain reaper: a concept claimed but not terminal after this many ms is
# dead-lettered (dead lane / lost callback), and a concept claimed more than
# OKF_INGEST_WORKER_MAX_CLAIMS times is treated as poison. WAITING concepts
# are never reaped, whatever the queue depth.
# OKF_INGEST_WORKER_REAP_GRACE_MS=3600000
# OKF_INGEST_WORKER_MAX_CLAIMS=8

# --- OKF retrieval mode governance (Story 1.7; ADR-okf-039 D3) ---
# BOOT DEFAULTS only — the governed row in okf_system_config (_key='retrieval')
# overrides field-by-field once a steward PUTs /api/okf/retrieval-config
# (tools-admin; audited). mode 'legacy' runs today's single-graph retriever
# byte-for-byte; 'okf_only'/'hybrid' engage the Epic-1 fan-out ONLY when ≥1 OKF
# graph is serving. Garbage values fall back to the safe defaults in code
# (mode → legacy; caps clamped to sane maxima) — these env vars can never
# enable the fan-out on a misconfigured deployment.
# OKF_RETRIEVAL_MODE=legacy
# OKF_RETRIEVAL_MAX_FANOUT_GRAPHS=5
# OKF_RETRIEVAL_SPINE_MAX_HOPS=2
# OKF_RETRIEVAL_EXTRACTED_HOP_CAP=1
# OKF_RETRIEVAL_CANDIDATE_CAP_PER_GRAPH=50
# OKF_RETRIEVAL_CANDIDATE_CAP_GLOBAL=200
# BFF-side carrier cache (Story 1.1): the retrieval-posture/authz window and
# per-call okf-server timeout consumed by gov-chat-backend (code defaults
# 30000/3000 ms). Latency tuning only — these can never engage the fan-out.
# OKF_RETRIEVAL_CONFIG_TTL_MS=30000
# OKF_RETRIEVAL_CONFIG_TIMEOUT_MS=3000

# --- OKF content-only chunking (Story 4.8-amend) ---
# Concepts never become doc-repo files docs — the worker POSTs the concept's
# markdown DIRECTLY to dataprep (DATAPREP_URL below). Dataprep's completion
# callback then hits the OKF_SERVER_URL (set in compose, defaults to
# http://okf-server:3002) and authenticates with OKF_INTERNAL_SECRET. The
# okf-server controller is FAIL-CLOSED — empty secret ⇒ every callback 401s.
# MUST be the SAME value on both services.
# OKF_INTERNAL_SECRET=<set this — same value on okf-server + dataprep-arango-service>
# DATAPREP_URL=http://dataprep-arango-service:5000

# Maximum size (MB) of a crawled source file okf-server will convert into an
# OKF repository (server-side streaming conversion job — authoritative check
# against the doc-repo Content-Length before any processing). Default:
# 10240 (10 GB). Mode B (per-page) scales to the cap via batched in-process
# ingests; mode A (single mega-concept) is additionally limited to ~45 MB
# (one request body).
# OKF_MAX_CRAWL_SOURCE_MB=10240
# Debug logging for the crawl→OKF conversion job (1 = per-page/per-batch logs
# from okf-server). Leave empty to disable.
# OKF_CONVERSION_DEBUG=

# Maximum body size (MB) doc-repo accepts for the OKF bundle-ingest route
# (POST /api/files/ingest-bundle). Publish ships the whole repository zip as
# base64-in-JSON, so large repos need this headroom: a 1000-concept wikipedia
# repo zips to ~30 MB ≈ ~42 MB of JSON. Default 100 (10× the app's 10mb JSON
# cap); every other JSON route stays at the 10mb default.
# OKF_BUNDLE_MAX_MB=100
# Timeout (ms) for okf-server's bundle-store POST to doc-repo during publish.
# Large bundles (tens of MB) plus the ClamAV scan can outrun a short timeout.
# Default 300000 (5 min).
# OKF_BUNDLE_STORE_TIMEOUT_MS=300000

# Dataprep service account secret (client_credentials grant)
KC_DATAPREP_CLIENT_SECRET=

# Mobile OIDC client for institutional deployments (Flutter app)
# Public client with PKCE — no client secret required (RFC 8252).
# Change per deployment: each institution needs its own clientId and redirect scheme.
# Used by: keycloak-config-cli (creates the mobile OIDC client in Keycloak at startup)
# See: site/content/en/docs/deployment/mobile-deployment-guide.md (deployment onboarding guide)
KC_MOBILE_CLIENT_ID=genie-mobile-<institution>

# Mobile app custom URL scheme for OIDC callback redirect.
# MUST match the following across all config layers (scheme coherence rule):
#   1. redirectScheme in Dart flavor config (lib/config/flavors/*.dart)
#   2. appAuthRedirectScheme in android/app/build.gradle manifestPlaceholders
#   3. APP_AUTH_REDIRECT_SCHEME in iOS XCConfig (ios/Flutter/*.xcconfig)
#   4. This variable in .env (used by keycloak-config-cli for Keycloak client redirectUris)
# A mismatch causes silent OIDC callback failure — the browser redirects to the wrong
# scheme and the app never receives the authorization code.
KC_MOBILE_REDIRECT_SCHEME=com.<institution>.genieai

