FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates ffmpeg && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY genie-ai-overlay/voice-agent/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY genie-ai-overlay/voice-agent/genieai_voice_agent.py /app/genieai_voice_agent.py

EXPOSE 9300

CMD ["python", "/app/genieai_voice_agent.py", "start"]
