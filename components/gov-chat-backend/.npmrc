# sharp's postinstall downloads the prebuilt libvips binary from GitHub release
# assets, which is unreachable from the CI runner (connection resets with
# "socket hang up"). Redirect the download to npmmirror's sharp-libvips mirror,
# which mirrors GitHub's release layout and is verified reachable from the
# runner. Override per-environment via npm_config_sharp_libvips_binary_host.
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips/
