{
  "name": "genie-okf-server",
  "version": "0.1.0",
  "description": "GENIE.AI OKF Server — Open Knowledge Format governed serving layer",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^winston$": "<rootDir>/node_modules/winston",
      "^winston-daily-rotate-file$": "<rootDir>/node_modules/winston-daily-rotate-file",
      "^@opentelemetry/api$": "<rootDir>/node_modules/@opentelemetry/api",
      "shared-lib$": "<rootDir>/../shared/lib/index.js",
      "shared-lib/(.*)$": "<rootDir>/../shared/lib/$1"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "arangojs": "^8.8.1",
    "async-retry": "^1.3.3",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "gray-matter": "^4.0.3",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jose": "^6.2.2",
    "luxon": "^3.6.1",
    "markdown-it": "^15.0.0",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.10.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3"
  }
}
