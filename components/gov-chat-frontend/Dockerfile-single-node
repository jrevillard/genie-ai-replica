# Single-node variant — same runtime-config shape as the main Dockerfile
# (A4: no VUE_APP_* build baking; docker-entrypoint.sh writes config.js at
# container start, nginx serves the static bundle). The old http-server CMD
# (with its CSP header hack and /api proxy) died with the build args.
FROM node:22.14.0-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .
RUN npm run build  # Builds to /app/dist

# Runtime: nginx serves the static bundle; entrypoint renders config.js
# and envsubst's ${NGINX_PORT} into nginx.conf
FROM nginx:alpine

WORKDIR /app

COPY --from=build /app/dist /app/dist
RUN chmod -R a+r /app/dist

COPY nginx.conf /etc/nginx/nginx.conf.template
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8090

ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["sh", "-c", "envsubst '$NGINX_PORT' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"]
