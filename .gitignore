# ─── Node / npm ──────────────────────────────────────────────────
node_modules/

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ─── Build outputs ───────────────────────────────────────────────
dist/
build/
*.log
*.log.gz
logs/

# ─── Local security-scan artifacts (never committed) ────────────
semgrep_*.json
gitleaks_*.json
changed_files_session.txt

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Model binaries (too big for git; rehydrate from sibling
#     genie-ai-replica or download per setup docs). Keeping the
#     directories themselves so bind-mounts have a target. ────────
*.bin
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf
**/whispercpp/models/*.bin
**/piper/models/*.onnx
**/data/huggingface-cache/
# .onnx.json sidecars (Piper voice configs) ARE small and tracked.
!*.onnx.json
!**/piper/models/*.onnx.json

# ─── Local recovery / backup workspaces ──────────────────────────
_local_backup/
_recovery/
haystack-stack/_recovery/
haystack-stack/backups/

# ─── Runtime container state (ArcadeDB + Redis + trace logs).
#     These get rewritten on every container start, so committing
#     them produces noisy "modified" diffs on every restart. The
#     directory layout itself is recreated by docker compose on
#     first up; nothing useful is lost by gitignoring them.
haystack-stack/data/arcadedb/
haystack-stack/data/redis/
haystack-stack/evidence_reports/traces/

# ─── Vite / Rollup caches ────────────────────────────────────────
.vite/
**/node_modules/.vite/

# ─── Editor / IDE ────────────────────────────────────────────────
.vscode/*.local
.idea/

# ─── Secrets — NEVER COMMIT (BUG-001 fix, supersedes the prior
#     2026-04-30 decision that briefly allowed .env in-tree). The
#     committed surface for environment is .env.defaults (demo-safe)
#     and .env.example (template). Real .env files with provider
#     keys must stay local. The pre-commit hook in .githooks/
#     enforces this at commit time. ────────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.development
haystack-stack/.env
haystack-stack/.env.local
components/multichannel-access/.env
components/frontend/.env.local
secrets/
*.key
*.pem
*.decrypted
*.plaintext

# Explicitly allow the safe-to-commit env templates / demo defaults
!.env.example
!.env.defaults
!.env.encrypted
!haystack-stack/.env.example
!haystack-stack/.env.defaults
!haystack-stack/.env.encrypted
!components/multichannel-access/.env.example
!components/frontend/.env.example

# ─── .env backups — always carry real provider keys, never commit ──
*.env.backup_*
haystack-stack/.env.backup_*
haystack-stack/.env.bak.*
haystack-stack/.env.broken.*

# ─── Claude Code working dir — temp deploy scripts hard-code SSH
#     creds & paramiko sessions to the A40, plus local-machine
#     Claude settings. Watchdog scripts live in scripts/ops/. ──────
.claude/_tmp_*
.claude/_seed_*
.claude/_RESTORE.md
.claude/_amina_*
.claude/settings.local.json
.claude/settings.json
.claude/scheduled_tasks.lock

# ─── Runtime artifacts ─────────────────────────────────────────────
var/
*.err
components/frontend/vite-test.err

# ─── Caregiver education certificates — PII. The pre-existing .webp
#     committed before this rule is left in place; new uploads stay
#     local only. Per privacy policy, originals are pseudonymised. ─
haystack-stack/education_certs/*.jpg
haystack-stack/education_certs/*.png
haystack-stack/education_certs/*.pdf
