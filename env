# GPU service endpoints for the okf-server publish pipeline (Story 1.6):
#   VLLM_LLM_HOST  — OpenAI-compatible /v1/chat/completions for tag suggest + validate (AsyncOpenAI-equivalent)
#   TEI_EMBED_HOST — /embed for tag vectorization (1024-dim, shared embedding space with chunks)
# VLLM_LLM_HOST=http://vllm-llm-served:8000
# TEI_EMBED_HOST=http://embedding-tei:80
# OKF_FRONTMATTER_TAG_BATCH_SIZE=1        # one repo at a time for suggestTags
