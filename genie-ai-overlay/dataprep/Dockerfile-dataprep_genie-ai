# ======== Stage 1: The OPEA Base ========
# This stage clones the external OPEA repository at a specific version.
ARG OPEA_REPO_URL="https://github.com/opea-project/GenAIComps.git"
ARG OPEA_VERSION="v1.3" # This tag can be changed to upgrade OPEA
FROM alpine/git:latest AS opea_base

ARG OPEA_REPO_URL
ARG OPEA_VERSION

WORKDIR /src
# Clone only the specified branch/tag, with no history for speed
RUN git clone --depth 1 --branch ${OPEA_VERSION} ${OPEA_REPO_URL} .

# ======== Final Stage: Assembly ========
FROM python:3.10-slim

WORKDIR /app

# Step A: Copy the base OPEA microservice code
# This copies arangodb.py, main.py, requirements.txt, etc.
COPY --from=opea_base /src/comps/dataprep/src/ /app/
# **Step A.1: Copy the shared 'cores' module (for api_protocol.py)**
COPY --from=opea_base /src/comps/cores/ /app/comps/cores/

# Step B: Copy and Run the Dependency Patch and the utils.py patch
# This removes unused, broken dependencies (pathway, graspologic)
COPY --chmod=0755 genie-ai-overlay/build-patches/fix_dependencies.sh /app/fix_dependencies.sh
RUN ./app/fix_dependencies.sh /app/requirements.txt
COPY genie-ai-overlay/dataprep/genieai_dataprep_utils.py /app/genieai_dataprep_utils.py

# Step C: Install *fixed* dependencies
# This will now succeed by skipping the unused packages
RUN pip install --no-cache-dir -r requirements.txt

# Step D: "Overlay" our custom GENIE-AI files
# These paths are relative to the build context (our repo root)
# 1. Copy our new subclass (Section 2.1) and the loader
COPY genie-ai-overlay/dataprep/genieai_dataprep_arangodb.py /app/integrations/genieai_dataprep_arangodb.py
COPY genie-ai-overlay/dataprep/genieai_dataprep_loader.py /app/genieai_dataprep_loader.py

# 2. Overwrite OPEA's entry point with our new one
COPY genie-ai-overlay/dataprep/genieai_dataprep_microservice.py /app/genieai_dataprep_microservice.py

# 3. Overwrite the OPEA API protocol with our custom version
COPY genie-ai-overlay/core/genieai_api_protocol.py /app/comps/cores/proto/genieai_api_protocol.py

# Step E: Run the new GENIE-AI entry point
# We are running genieai_dataprep_microservice.py, which we successfully overwrote in Step D
CMD ["python", "genieai_dataprep_microservice.py"]