# JAEGER_IP=127.0.0.1
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=grpc://127.0.0.1:4317
# TELEMETRY_ENDPOINT=http://127.0.0.1:4318/v1/traces

# OpenTelemetry — distributed tracing endpoint (optional, defaults to collector service)
# Used by: Node.js backend (OTLP/HTTP), Python OPEA services (OTLP/HTTP with /v1/traces)
# Enables log-trace correlation: all service logs include trace_id/span_id for Grafana
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# =============================================================================
# SECTION 12C: OBSERVABILITY STACK (OPTIONAL)
# =============================================================================
# Deploy OTel Collector + VictoriaMetrics + VictoriaLogs + Grafana alongside the application.
# All services use the fluentd logging driver to forward container logs to the
# OTel Collector's fluent_forward receiver (port 24224, localhost only).
# Docker dual logging (20.10+) keeps `docker logs` functional.
# Enable via: docker compose --profile observability up -d
#   or Swarm:  ENABLE_OBSERVABILITY=1 in .env (MUST be 0 or 1, not true/false)
#   or Ansible: enable_observability: "1" in group_vars/all.yml
#
# Uncomment to override defaults (all have sensible defaults in docker-compose):
# ENABLE_OBSERVABILITY=0
# GRAFANA_ADMIN_USER=admin
# GRAFANA_PORT=3002
# VICTORIAMETRICS_RETENTION=30d
# VICTORIALOGS_RETENTION=30d

# Grafana admin password (required secret, no default)
# Used by: grafana service
GRAFANA_ADMIN_PASSWORD=

# Grafana OIDC client (required secret, no default)
# Used by: keycloak-config service (creates grafana OIDC client), grafana service (OAuth)
KC_GRAFANA_CLIENT_ID=grafana
KC_GRAFANA_CLIENT_SECRET=

# Grafana OAuth configuration (override defaults in docker-compose):
# GF_AUTH_GENERIC_OAUTH_ENABLED=true
# GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
# GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email

# =============================================================================
# SECTION 13: DOCKER SWARM MULTI-NODE (OPTIONAL)
# =============================================================================
# Override these variables when deploying with Docker Swarm (docker stack deploy).
# Default values are for single-node Docker deployment (localhost).
#
# See docs/docker-swarm-setup.md for the full Swarm deployment guide.
#
# IMPORTANT: In Swarm, .env variables are resolved once at deploy time on the
# manager node. Changing a variable requires redeploying the entire stack:
#   docker stack deploy -c docker-compose.yaml genieai
#
# Variables that differ between Docker and Swarm:
#
# DATA_DIR=./data
#   Base directory for all bind mounts (logs, backups, model cache).
#   Subdirectories are auto-created by the deploy playbook:
#     data/logs/kong, data/logs/backend, data/logs/doc-repo,
#     data/database_backups, data/huggingface
#   Docker: ./data (default, no override needed)
#   Swarm:  override only if storing data on a different mount point
#
# SWARM_REGISTRY_URL=<manager-node-ip>:5000
#   Docker: N/A (images built locally)
#   Swarm:  URL of the Docker registry accessible from all nodes.
#           Default localhost:5000 works for single-node only.
#           For multi-node, use the manager node's IP or hostname.
#           Example: 192.168.1.10:5000
#
# NGINX_PUBLIC_DOMAIN=<gateway-node-fqdn>
#   Docker: localhost
#   Swarm:  FQDN of the gateway node (gateway=true label, e.g., gateway.example.com)
#
# VUE_APP_API_URL=https://<gateway-node-fqdn>/api
#   Docker: /api (relative, works with local proxy)
#
#   Swarm:  Full HTTPS URL pointing to the gateway node
#
# CSP_CONNECT_SRC='self' https://<gateway-node-fqdn> wss://<gateway-node-fqdn>
#   Docker: 'self' http://localhost:3000 http://localhost:8090 ...
#   Swarm:  'self' https://<gateway-node-fqdn> wss://<gateway-node-fqdn>
#
# CORS_ALLOWED_ORIGINS=https://<gateway-node-fqdn>
#   Docker: http://localhost:3000,http://localhost:8090,...
#   Swarm:  https://<gateway-node-fqdn>
#
# Variables that MUST be identical across all nodes:
#   ARANGO_PASSWORD, TRANSLATION_CACHE_PASSWORD,
#   POSTGRES_PASSWORD, KC_DATAPREP_CLIENT_SECRET
#
# Variables that MUST be identical (AI model IDs):
#   EMBEDDING_MODEL_ID, RERANKER_MODEL_ID, VLLM_LLM_MODEL_ID
#
# GPU-specific overrides work the same as Docker:
#   set -a && source .env && source env.t4 && set +a && docker stack deploy -c docker-compose.yaml genieai

# =============================================================================
# SECTION 14: REMOTE GPU NODE (OPTIONAL)
# =============================================================================
# When deploying a dedicated GPU node with the remote architecture (issue #758),
# override the default local Docker DNS endpoints to point to the GPU node via HTTPS.
# The GPU node runs nginx with TLS and API key authentication on ports 9400-9404.
#
# GPU_NODE_HOST=gpu.example.com
#   DNS hostname or IP of the remote GPU node.
#   All services below derive their URLs from this variable.
#
# VLLM_ENDPOINT=https://${GPU_NODE_HOST}:9400/v1
# TRANSLATION_VLLM_ENDPOINT=https://${GPU_NODE_HOST}:9401/v1
# EMBEDDING_SERVICE_URL=https://${GPU_NODE_HOST}:9402
# RERANKER_SERVICE_URL=https://${GPU_NODE_HOST}:9403
#
# DOCLING_ENDPOINT=https://${GPU_NODE_HOST}:9404
#   Remote docling-serve endpoint for document extraction.
#   When set, dataprep sends documents to the remote GPU node for processing.
#   When empty, dataprep uses the in-process docling converter (existing behavior).
#
# DOCLING_ENDPOINT_TIMEOUT=120
#   HTTP timeout (seconds) for remote docling-serve calls. Default: 120.
#
# VLLM_API_KEY=<api-key-for-your-instance>
#   API key for authenticating with the GPU node nginx proxy.
#   One key per GENIE.AI instance, shared across all 5 GPU services.
#   Contact the GPU node administrator to obtain your key.

