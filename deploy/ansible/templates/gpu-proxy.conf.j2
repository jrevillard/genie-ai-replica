# GPU Node nginx Configuration
# TLS termination + API key authentication for 5 AI model services
# Path-based routing on single HTTPS port (firewall allows only 80/443)
# Generated by Ansible from templates/gpu-proxy.conf.j2

# API key map — reads keys from external file (one key per GENIE.AI client)
# File format: <key> 1;  (one per line)
map $http_x_api_key $api_key_valid {
    default 0;
    include /etc/nginx/api_keys.map;
}

# Custom log format — does NOT include X-API-Key header value
log_format gpu_node '$remote_addr - [$time_local] "$request" '
                     '$status $body_bytes_sent '
                     '"$http_referer" "$http_user_agent"';

# SSL configuration
ssl_certificate     /etc/nginx/ssl/server.crt;
ssl_certificate_key /etc/nginx/ssl/server.key;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_ciphers         HIGH:!aNULL:!MD5;

# HTTPS — path-based routing for all GPU services
server {
    listen 443 ssl;
    server_name {{ gpu_public_domain }};

    access_log /var/log/nginx/gpu_443_access.log gpu_node;
    error_log  /var/log/nginx/gpu_443_error.log;

    if ($api_key_valid = 0) {
        return 401;
    }

    # vLLM LLM inference — backend appends /v1/* (OpenAI-compatible)
    location /llm/ {
        proxy_pass http://vllm-llm:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # vLLM Translation inference — backend appends /v1/*
    location /translation/ {
        proxy_pass http://vllm-translation:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # TEI Embedding
    location /embed/ {
        proxy_pass http://tei-embedding:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # TEI Reranker
    location /rerank/ {
        proxy_pass http://tei-reranker:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-ForwardedFor $proxy_add_x_forwarded_for;
        proxy_set_header X-ForwardedProto $scheme;
    }

    # Docling — document extraction (large file uploads)
    location /docling/ {
        proxy_pass http://docling-serve:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 100M;
    }

    location / {
        return 404;
    }
}

# HTTP — certbot ACME challenge only
server {
    listen 80;
    server_name {{ gpu_public_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
