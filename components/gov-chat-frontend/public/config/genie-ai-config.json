              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "livestock",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/livestock.svg"
            },
            "category": null,
            "categoryNameEN": "Livestock",
            "action": {
              "visibleText": "quickhelp.educationServicesUserPrompt",
              "hiddenPrompt": "quickhelp.educationServicesPrompt"
            },
            "styles": {
