# Minimal boot set for the dev compose stack (components/docker-compose.yaml):
#   cp gov-chat-backend/.env.example gov-chat-backend/.env   # then fill CHANGE_ME
# Full production reference: deploy/ansible/templates/env.j2 (Ansible-rendered).
# NOTE: compose ALSO substitutes ${ARANGO_PASSWORD} itself (arango-vector-db's
# ARANGO_ROOT_PASSWORD) from the shell or components/.env — set it there too.
# All KEYCLOAK_* vars below are boot-required (keycloak-proxy-service exits without them).

# ArangoDB (backend exits at boot without all four)
ARANGO_URL=http://arango-vector-db:8529
ARANGO_DB_NAME=genie-ai
ARANGO_USER=root
ARANGO_PASSWORD=CHANGE_ME

# Keycloak (dev compose runs no keycloak — point at a reachable realm, e.g. the deployed one)
KEYCLOAK_URL=CHANGE_ME                 # e.g. https://agriconnect.site/auth
KEYCLOAK_REALM=agrivisory
KEYCLOAK_PROXY_CLIENT_ID=genie-proxy-client
KEYCLOAK_PROXY_CLIENT_SECRET=CHANGE_ME

# Approval gate (true = new first-logins land Pending until an admin approves)
USER_APPROVAL_REQUIRED=true
