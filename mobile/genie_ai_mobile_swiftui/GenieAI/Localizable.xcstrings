        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อผู้ใช้ต้องประกอบด้วยตัวอักษร ตัวเลข ขีดล่าง จุด และขีดกลางเท่านั้น"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名只能包含字母、数字、下划线、点和连字符"
          }
        }
      }
    },
