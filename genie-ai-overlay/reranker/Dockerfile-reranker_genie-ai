# ======== Stage 1: The OPEA Base ========
# Will be cached by Docker
ARG OPEA_REPO_URL="https://github.com/opea-project/GenAIComps.git"
ARG OPEA_VERSION="v1.5"
FROM alpine/git:v2.52.0 AS opea_base

ARG OPEA_REPO_URL
ARG OPEA_VERSION

WORKDIR /src
RUN git clone --depth 1 --branch ${OPEA_VERSION} ${OPEA_REPO_URL} .

# ======== Final Stage: Assembly ========
FROM python:3.11-slim

# SLIM VARIANT (issue #2000) — one Dockerfile, two dependency sets.
#
#   requirements-cpu.txt  (default) → the FAT lock: `torch==2.13.0` resolves
#       to the CUDA/cu13 build (15 `nvidia-*` wheels + triton, ~3.2 GB
#       compressed in the pip layer — the whole 6.8 GB image). The reranker
#       has NO local-model path (OPEA v1.5's
#       `comps/rerankings/src/integrations/tei.py` is a pure remote client —
#       `huggingface_hub.AsyncInferenceClient` against
#       `TEI_RERANKING_ENDPOINT` — and `ovms.py` is remote too), so torch
#       reaches the fat lock only through upstream OPEA's requirements.in
#       (`sentence_transformers`, `datasets`, `haystack-ai`).
#   requirements-slim.txt → the SLIM lock: no torch at all. The service code
#       is identical; only the installed set changes.
#
# The build args are DEFAULTED, so the published `:main` image installs the
# fat lock exactly as before.
#
# EXTRA_PIP_ARGS is empty for both variants of this image (the slim lock has
# no torch): the reranker needs no second index.
ARG REQUIREMENTS_FILE="requirements-cpu.txt"
ARG EXTRA_PIP_ARGS=""

# Install system dependencies required by the original reranker (upgrade pulls
# current Debian security updates so the image does not lag point-releases)
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --fix-missing \
    git \
    curl \
    libgl1 \
    libglx-mesa0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Add /app (for 'comps'), the reranker 'src' (for entrypoint),
# and 'proto' (for api_protocol) to PYTHONPATH
ENV PYTHONPATH="${PYTHONPATH}:/app:/app/comps/rerankings/src:/app/comps/cores/proto"

# Step A: Copy the entire OPEA 'comps' directory from the clone
COPY --from=opea_base /src/comps/ /app/comps/

# Step B: Install dependencies from the committed hash-pinned lock.
# The lock is compiled with `make lock-reranker` (uv pip compile
# --generate-hashes --python-version 3.11) from the GENIE.AI fork of OPEA
# v1.5's requirements.in. --require-hashes makes the build bit-for-bit
# reproducible and supply-chain-pinned, with no re-resolution against live PyPI.
# `kneed` (used by the GenieTEIReranking class) is compiled into the lock, so
# the separate pip install is gone.
COPY genie-ai-overlay/reranker/${REQUIREMENTS_FILE} /app/requirements.txt
RUN pip install --no-cache-dir --no-deps --require-hashes ${EXTRA_PIP_ARGS} -r /app/requirements.txt

# Step D: Fix docarray circular import
# The vendored comps/cores/proto/docarray.py shadows the real 'docarray' PyPI
# package on PYTHONPATH. docarray_alias_shim.py (wired via zz_genie_startup.pth at
# site-init by install_site_startup.sh, Step G) pins the real package in
# sys.modules — no vendored file is renamed or edited.
COPY genie-ai-overlay/build-patches/docarray_alias_shim.py /app/docarray_alias_shim.py

# Step D.5: Copy shared OTel tracing module (importable from PYTHONPATH=/app)
COPY genie-ai-overlay/tracing.py /app/tracing.py

# Copy the shared span-attribute vocabulary (importable as core.span_attrs).
# The reranker imports it for the attribute names and the adaptive-breakdown
# chunk-key sentinel; without this the image fails at import, not at runtime.
COPY genie-ai-overlay/core/span_attrs.py /app/core/span_attrs.py

# Copy the shared model-endpoint HTTP budget policy (core.model_http_policy).
# The reranker reads RERANK_TIMEOUT_SECONDS from it to bound the /rerank call.
# The default matches aiohttp's own 300 s so behaviour is unchanged out of the
# box, but the budget is now named, knob-driven and shared with the rest of the
# deck instead of being an accident of which session object is constructed.
COPY genie-ai-overlay/core/model_http_policy.py /app/core/model_http_policy.py

# Step E: "Overlay" custom GENIE-AI files
# 1. Place the custom reranker class into the integrations folder
COPY genie-ai-overlay/reranker/genieai_tei_reranker.py /app/comps/rerankings/src/integrations/genieai_tei_reranker.py

# 2. Overwrite the default microservice entrypoint with modified version
COPY genie-ai-overlay/reranker/genieai_reranking_microservice.py /app/comps/rerankings/src/opea_reranking_microservice.py

# Step F: Create non-root user and set permissions
RUN useradd -ms /bin/bash user && \
    chown -R user:user /app /home/user

# Step G: Install the SSL bypass runtime patch via a .pth site-init hook
# (no-op unless OPEA_SSL_SKIP_VERIFY=1). The installer derives the site-packages
# path from the running interpreter, so no hardcoded python3.x path is needed.
# docarray_alias_shim.py (Step D) is picked up automatically when present.
COPY --chmod=0755 genie-ai-overlay/build-patches/install_site_startup.sh /app/install_site_startup.sh
COPY configs/ssl/genie_ssl_patch.py /app/genie_ssl_patch.py
RUN /app/install_site_startup.sh

# The OS packages are refreshed by a separate, bustable layer: the monthly
# rebuild passes --build-arg CACHE_BUST=<timestamp>, and a layer that takes
# that argument is the only one whose cache key changes.
#
# Position: after the expensive layers (what sits above it stays cached — a
# layer's cache key includes its parent), before the writes to package-owned
# paths (a package that moves would restore its own files over ours), and
# still root.
ARG CACHE_BUST=0
RUN CACHE_BUST=$CACHE_BUST apt-get update -y -o Acquire::Retries=5 && \
    apt-get upgrade -y --with-new-pkgs --fix-missing -o Acquire::Retries=5 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Step H: Run the new microservice entry point from its new location
USER user
CMD ["python", "comps/rerankings/src/opea_reranking_microservice.py"]
