# Minimal boot set for the dev compose stack (components/docker-compose.yaml):
#   cp gov-chat-frontend/.env.example gov-chat-frontend/.env   # then fill CHANGE_ME
# Full production reference: deploy/ansible/templates/env.j2 (Ansible-rendered).
# RUNTIME (A4): docker-entrypoint.sh renders /app/dist/config.js (window.APP_CONFIG)
# from these container-env values at every start — edits apply on container
# (re)create (`docker compose up -d frontend`), NOT on rebuild; .dockerignore
# excludes .env* from the build context anyway.

VUE_APP_API_URL=http://localhost:3000/api   # dev compose publishes backend on 3000
VUE_APP_KEYCLOAK_URL=CHANGE_ME              # e.g. https://agriconnect.site/auth
VUE_APP_KEYCLOAK_CLIENT_ID=itu-agrivisory-client
