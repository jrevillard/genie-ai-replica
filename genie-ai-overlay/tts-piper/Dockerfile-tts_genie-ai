FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY genie-ai-overlay/tts-piper/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY genie-ai-overlay/tts-piper/genieai_tts_microservice.py /app/genieai_tts_microservice.py

EXPOSE 9200

CMD ["python", "/app/genieai_tts_microservice.py"]
