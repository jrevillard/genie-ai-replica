{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Alert State",
        "builtIn": false,
        "showIn": 0,
        "tags": ["observability"],
        "type": "alert"
      }
    ]
  },
  "description": "Meta-monitoring dashboard for the observability stack itself",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "OTel Collector Status",
      "description": "Collector pipeline health — proxy via VM ingestion rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "uid": "victoriametrics" },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "rows/s"
        }
      },
      "targets": [
        {
          "expr": "rate(vm_rows_ingested_total[2m])",
          "instant": true,
          "refId": "A",
          "legendFormat": "Ingestion rate"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "title": "VictoriaMetrics Ingestion Rate",
      "description": "Overall metric ingestion rate into VictoriaMetrics",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "uid": "victoriametrics" },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "rows/s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "expr": "rate(vm_rows_ingested_total[5m])",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "title": "VictoriaMetrics Storage Usage",
      "description": "Free disk space available to VictoriaMetrics",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "datasource": { "uid": "victoriametrics" },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1073741824 },
              { "color": "green", "value": 10737418240 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "vm_free_disk_space_bytes",
          "instant": true,
          "refId": "A",
          "legendFormat": "Free disk"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "VictoriaLogs Ingestion Rate",
      "description": "Log ingestion rate via VictoriaMetrics metrics",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "datasource": { "uid": "victoriametrics" },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "rows/s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "expr": "rate(vm_rows_ingested_total{type=\"vlstorage\"}[5m])",
          "refId": "A",
          "legendFormat": "Log ingestion"
        }
      ]
    },
    {
      "title": "VictoriaTraces Export Metrics",
      "description": "Trace export success/failure rate from OTel Collector",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "datasource": { "uid": "victoriametrics" },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "expr": "rate(otelcol_exporter_sent_spans{exporter=\"otlp_http/victoriatraces\"}[5m])",
          "refId": "A",
          "legendFormat": "Sent spans"
        },
        {
          "expr": "rate(otelcol_exporter_send_failed_spans{exporter=\"otlp_http/victoriatraces\"}[5m])",
          "refId": "B",
          "legendFormat": "Failed spans"
        }
      ]
    },
    {
      "title": "Grafana Health",
      "description": "Grafana service up/down status",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "id": 6,
      "datasource": { "uid": "victoriametrics" },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"grafana\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "Tempo Proxy Health",
      "description": "Tempo Proxy service up/down status",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "id": 7,
      "datasource": { "uid": "victoriametrics" },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"tempo-proxy\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "Query Latency — VictoriaMetrics",
      "description": "VM query performance over time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 8,
      "datasource": { "uid": "victoriametrics" },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(vm_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(vm_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "B",
          "legendFormat": "p50"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["observability", "meta-monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Observability Stack Health",
  "uid": "observability-stack-health",
  "version": 1
}
