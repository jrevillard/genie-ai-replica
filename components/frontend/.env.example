# AMINA Frontend Environment Variables
# Copy to .env and fill in values

# API base URL (where the backend is running)
VITE_API_URL=http://localhost:8000

# Google OAuth (get from console.cloud.google.com)
# Create OAuth 2.0 Client ID → Web application
# Authorized JS origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth (get from developers.facebook.com)
# Create App → Facebook Login → Web
VITE_FACEBOOK_APP_ID=

# DHIS2 OAuth (your DHIS2 instance URL)
VITE_DHIS2_BASE_URL=https://play.dhis2.org/40.4.0
