# =============================================================================
# GENIE.AI - Environment Configuration Template
# =============================================================================
#
# This file contains all configuration variables for GENIE.AI deployment.
# Copy this file to .env and fill in the required values:
#
#   cp env .env
#
# IMPORTANT: .env is git-ignored and contains your actual secrets.
# This file (env) is the committed template with empty/default values.
#
# Configuration Priority:
#   1. Environment variables in .env (highest priority - overrides all)
#   2. Volume-mounted files (for SSL certificates, prompts)
#   3. Default values in code/docker-compose
#   4. Default values in application code (lowest priority)
#
# Documentation: https://github.com/your-org/genie-ai/docs/deployment.md
# =============================================================================

# =============================================================================
# SECTION 1: SECRETS (REQUIRED)
# =============================================================================
# Generate strong random values using:
#   openssl rand -base64 32
# or:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# These MUST be set in your .env for production deployment.

# ArangoDB database name (default: genie-ai)
# Uncomment and set for per-deployment database isolation (e.g. el-salvador)
# ARANGO_DB=el-salvador

# ArangoDB root password (vector + graph database)
# Used by: backend, document-repository, dataprep, retriever
ARANGO_PASSWORD=

# Redis cache password (translation service caching)
# Used by: redis-cache, translation service
TRANSLATION_CACHE_PASSWORD=

# PostgreSQL shared instance (API gateway + Keycloak)
# The shared PostgreSQL (postgres service) uses a superuser + dedicated users:
# - Superuser 'genieai' (POSTGRES_USER) with POSTGRES_PASSWORD — created by PostgreSQL init
# - Dedicated user 'kong' with KONG_DB_PASSWORD — created by postgres-init
# - Dedicated user 'keycloak' with KEYCLOAK_DB_PASSWORD — created by postgres-init (see Section 9)
# Each service MUST have its own unique password.

# PostgreSQL superuser username (created by PostgreSQL init on first start)
# Default: genieai (set in docker-compose.yaml)
# POSTGRES_USER=genieai

# PostgreSQL superuser password
# Used by: postgres (init), postgres-init (superuser auth)
POSTGRES_PASSWORD=

# Kong dedicated database user password (MUST differ from POSTGRES_PASSWORD)
# Used by: postgres-init (creates 'kong' user), kong, kong-migrations
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KONG_DB_PASSWORD=

# =============================================================================
# SECTION 2: EMAIL CONFIGURATION (REQUIRED)
# =============================================================================
# SMTP server configuration for user verification emails, password reset,
# and system notifications.
#
# Get SMTP credentials from your email provider:
# - Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# - SendGrid, AWS SES, Mailgun: Use provider's SMTP credentials
#
# Required for: User registration, email verification, password reset

EMAIL_HOST=
EMAIL_PORT=
# EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# SMTP AUTH (auto-derived from EMAIL_USER — set to "false" to disable auth while keeping EMAIL_USER)
# EMAIL_SMTP_AUTH=

# =============================================================================
# SECTION 3: EXTERNAL API KEYS
# =============================================================================
# Credentials for external services

# Hugging Face Hub token (required for pulling AI models)
# Get your token at: https://huggingface.co/settings/tokens
# Used by: vLLM, TEI (embedding/reranking services)
# Accept: "Read" permissions sufficient
HUGGING_FACE_HUB_TOKEN=

# Optional: vLLM API key if required by your vLLM deployment
# VLLM_API_KEY=

# =============================================================================
# SECTION 3b: DEPLOYMENT OPTIONS
# =============================================================================
# Control whether OPEA/AI services are deployed (vllm, tei, embedding, reranker,
# retriever, dataprep, chatqna, guardrail, translation).
# DEPLOY_OPEA=1  -> OPEA services deployed (default, requires GPU)
# DEPLOY_OPEA=0  -> OPEA services skipped (core services only, no GPU needed)
#
# DEPLOY_OPEA=1

# =============================================================================
# SECTION 4: AI/ML MODEL CONFIGURATION
# =============================================================================
# All models have sensible defaults in code/docker-compose.
# Override here ONLY if you need different models for your deployment.
#
# Model Selection Guidelines:
# - LLM: Larger models = better quality but slower/more GPU memory
# - Translation: Smaller models sufficient for most use cases
# - Embedding: Use multilingual models if you need non-English support
# - Reranking: Improves retrieval quality, optional but recommended

# Main LLM model for chat (OPEA ChatQnA service)
# Default: meta-llama/Meta-Llama-3.1-8B-Instruct
# Options: meta-llama/Llama-3.1-70B-Instruct (more accurate, slower)
# VLLM_LLM_MODEL_ID=

# Translation model (OPEA Translation service)
# The model used for guardrails and translation (Service: vllm-translation-guardrail)
#
# --- HOW TO CHANGE THE TRANSLATION MODEL ---
# The codebase auto-detects the model type and uses the correct prompt format:
#   - google/translategemma-*       -> uses /v1/completions with manually applied chat template
#   - google/gemma-3-*              -> uses generic plain-text prompt via /v1/chat/completions
#   - Any other model               -> uses generic plain-text prompt via /v1/chat/completions
# To switch, comment out the active line and uncomment the desired model below.
#
# Option 1: Generic LLM-based translation (current default, ~8GB VRAM)
#VLLM_TRANSLATION_MODEL_ID=google/gemma-3-4b-it
# Option 2: Purpose-built translation model, 4b params (~8GB VRAM, supports low-resource languages incl. Sesotho)
#VLLM_TRANSLATION_MODEL_ID=google/translategemma-4b-it
# Option 3: Purpose-built translation model, 12b params (~26GB VRAM, better quality for low-resource languages)
#             Requires gpu_memory_utilization >= 0.6 on 48GB GPU. See issue #581 for quality assessment.
#VLLM_TRANSLATION_MODEL_ID=google/translategemma-12b-it
#
# Override docker-compose defaults for vllm-translation-guardrail (all have sensible defaults):
# VLLM_TRANSLATION_SERVICE_PORT=9031
# VLLM_TRANSLATION_GPU_UTILIZATION=0.35
# VLLM_TRANSLATION_MAX_MODEL_LEN=8192
# VLLM_TRANSLATION_DTYPE=auto

# --- WHICH BACKEND TRANSLATES THE ANSWER ---
# The endpoint decides, not this variable: a deployment that NAMED a
# translation API always uses it. When that API is configured (GPU_NODE_HOST
# set, or VLLM_TRANSLATION_ENDPOINT naming something other than the
# in-cluster worker below) the GPU is MANDATORY — the backend waits for it at
# startup and refuses to start when it does not answer, rather than
# translating with a model the deployment did not ask for. A GPU blip then
# takes the backend down instead of quietly moving ~6 Gi of CPU model
# (Xenova/nllb-200-distilled-600M, ~6 Gi at ONNX load) into the process.
#
# When no API is named, this variable chooses between the two backends that
# exist: `auto` (the default when unset) probes the in-cluster worker once
# and keeps the GPU if it answers, the CPU model if it does not; `cpu` takes
# the CPU model directly; `gpu` skips the probe and requires the GPU.
# TRANSLATION_BACKEND=auto

# Embedding service API endpoint path
# Default: /v1/embeddings (OpenAI-compatible, used by OPEA embedding microservice)
# EMBEDDING_SERVER_ENDPOINT=

# Embedding model for vector search
# Default: BAAI/bge-large-en-v1.5  (1024-dim, set in docker-compose.yaml)
# Options: BAAI/bge-base-en-v1.5 (768-dim, faster but lower recall)
# Warning: changing the model requires re-ingesting all documents —
# the ArangoDB vector index is dimension-specific.
# EMBEDDING_MODEL_ID=

# Reranking model for search result refinement
# Default: BAAI/bge-reranker-v2-m3
# RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3

# Query-instruction prefix overrides for contrastive / instruction-tuned
# embedding models (issue #1035). Built-in table covers BAAI/bge en+zh-v1.5,
# hkunlp/instructor, and nomic-ai/nomic-embed. Use this env var to:
#   (a) override a built-in entry, or
#   (b) add a finetune / non-built-in model that needs a custom prefix.
# Comma-separated `substring=instruction` pairs; substring is matched
# case-insensitively against TEI_EMBED_MODEL. Trailing spaces inside the
# instruction value are preserved. Commas inside the instruction value are
# NOT supported (the entry is truncated at the first comma).
# Example: add a Chinese-prefix override for a deployer-specific finetune.
# EMBEDDING_QUERY_INSTRUCTIONS=my-org/bge-finetune=Custom instruction:

# ArangoDB graph traversal (used by retriever and chatqna)
# ARANGO_GRAPH_NAME=GRAPH                  # ArangoDB graph name (was RETRIEVER_ARANGO_GRAPH_NAME in v1.3)
# RETRIEVER_ARANGO_TRAVERSAL_ENABLED=false
# RETRIEVER_ARANGO_TRAVERSAL_MAX_DEPTH=2
# RETRIEVER_ARANGO_TRAVERSAL_MAX_RETURNED=3
# RETRIEVER_ARANGO_TRAVERSAL_SCORE_THRESHOLD=0.5
# RETRIEVER_ARANGO_TRAVERSAL_CONCURRENT_BATCHES=1

# Retriever tuning (used by retriever and chatqna)
# RETRIEVER_ARANGO_K=4
# RETRIEVER_ARANGO_FETCH_K=20
# RETRIEVER_ARANGO_SCORE_THRESHOLD=0.1
# RETRIEVER_ARANGO_DISTANCE_THRESHOLD=1
# RETRIEVER_ARANGO_LAMBDA_MULT=0.5
# RETRIEVER_ARANGO_SEARCH_START=chunk
# RETRIEVER_ARANGO_SEARCH_MODE=vector
# RETRIEVER_ARANGO_USE_APPROX_SEARCH=false
# RETRIEVER_ARANGO_DISTANCE_STRATEGY=COSINE
# RETRIEVER_ARANGO_NUM_CENTROIDS=1
# RETRIEVER_ARANGO_FILTER_STRATEGY=OR
# RETRIEVER_SUMMARIZER_ENABLED=false
# RERANKING_THRESHOLD=0.75
# RERANKING_STRATEGY=slice      # slice (default) | threshold | slice_threshold | knee_threshold | adaptive
# RERANKER_TOP_N=3              # chunks kept for slice/slice_threshold strategies (default 3)
# TEI reranker runtime caps. TEI 1.9.3 effective per-input cap = min(model_max, --max-batch-tokens).
# Raising --max-batch-tokens to 8192 aligns the cap with bge-reranker-v2-m3 (model_max_length=8192);
# --auto-truncate=false forces HTTP 422 Validation on overflow instead of silent truncation.
# TEI_RERANKING_MAX_BATCH_TOKENS=8192      # Per-batch token cap (TEI --max-batch-tokens). Also clamps per-input cap.
# TEI_RERANKING_AUTO_TRUNCATE=false          # Fail-fast on overflow (TEI --auto-truncate)
# TEI_RERANKING_MAX_CONCURRENT_REQUESTS=32   # In-flight requests cap. Lower if VRAM budget tighter (bench-validated safe at 32 with shared vLLM).
# TEI embedding (bge-large-en-v1.5; max_position_embeddings=512) — parallels the reranker fix above.
# --auto-truncate=false + --max-batch-tokens mirror the same fail-loud shape; values are commented to defer to docker-compose.yaml defaults.
# TEI_EMBEDDING_AUTO_TRUNCATE=false          # Fail-fast on overflow (TEI --auto-truncate). Defaults to false in compose.
# TEI_EMBEDDING_MAX_BATCH_TOKENS=8192         # Per-batch token cap (TEI --max-batch-tokens). Mirrors reranker fix.
# Adaptive utility-cost selection (only used when RERANKING_STRATEGY=adaptive):
# NOVELTY_SIGMOID_A=20.0       # novelty->weight logistic steepness
# NOVELTY_SIGMOID_B=0.25       # novelty->weight logistic midpoint
# CONTEXT_DECAY_FACTOR=0.0025      # per-token context-window cost coefficient
# MIN_VALUE_THRESHOLD=-1.0     # select a chunk only if marginal value > threshold

# Dataprep LLM labeling tuning — labeling is the dominant ingestion cost (one
# vLLM call per chunk). Defaults are safe; raise on a remote vLLM with spare
# capacity to cut ingestion time. See genieai_dataprep_arangodb.py.
#
# REQUIREMENT: the labeling LLM (VLLM_LLM_MODEL_ID) MUST support OpenAI-compatible
# `response_format={"type":"json_object"}` (vLLM guided JSON decoding). Dataprep
# requests strict JSON object output per chunk; a model/vLLM without guided JSON
# produces markdown-wrapped or malformed JSON -> per-chunk fallback (slower,
# lower label quality). Validated on ibm-granite/granite-4.1-8b.
# DATAPREP_MAX_CONCURRENT_BATCHES=20  # concurrent LLM label calls (default 20; was 5)
# DATAPREP_LLM_LABEL_BATCH_SIZE=4     # chunks per LLM labeling call (default 4).
#                                     #   >1 batches chunks to cut network round-trips
#                                     #   to a remote vLLM. Raise to 8 on capable models
#                                     #   (e.g. granite-4.1-8b); batches fall back to
#                                     #   per-chunk on parse failure, so output is correct.
#
# Chunk sizing — character-based. Per-extension DATAPREP_CHUNK_SIZE_*; global
# DATAPREP_CHUNK_OVERLAP. Override per ingest via doc-repo payload.chunkOverlap.
# DATAPREP_CHUNK_SIZE_PDF=500
# DATAPREP_CHUNK_SIZE_DOCX=1000
# DATAPREP_CHUNK_SIZE_XLSX=1500
# DATAPREP_CHUNK_SIZE_PPTX=500
# DATAPREP_CHUNK_SIZE_HTML=500
# DATAPREP_CHUNK_SIZE_TXT=500
# DATAPREP_CHUNK_SIZE_MD=500
# DATAPREP_CHUNK_OVERLAP=50

# Contextual Retrieval (Anthropic-style) — OPTIONAL, default OFF.
# When enabled, the dataprep generates a short LLM document-context prefix per
# chunk and prepends it before EMBEDDING and LABELING, so chunks carry the
# document's subject (fixes label/embedding context loss — e.g. a generic
# irrigation chunk in a cucumber guide becomes retrievable by "cucumber"). Adds
# one vLLM call per chunk (concurrency-bounded) at ingest time. On any failure
# (per-chunk or client-init) the chunk is stored raw — ingestion never blocks.
# See site/content/en/docs/rag/data-labeling.md + _bmad-output spec-contextual-retrieval.md.
# CONTEXTUAL_RETRIEVAL_ENABLED=true    # default true (on by default); set false to disable (no-op beyond skipping context gen)
# DATAPREP_CONTEXTUAL_MODEL=           # model for context generation; empty = reuse
#                                      #   VLLM_LLM_MODEL_ID. MUST support guided JSON
#                                      #   (response_format=json_object) like granite-4.1-8b.
# DATAPREP_CONTEXTUAL_DOC_BUDGET=100000 # max chars of doc text fed to the context LLM
# DATAPREP_CONTEXTUAL_MAX_TOKENS=512   # max OUTPUT tokens for the context LLM (doc-level + per-chunk). Model writes ~196 tokens; 200 truncated the JSON under load. 512 = safe margin.
#                                      #   (~1500 tokens); <=0 disables truncation.
# CONTEXTUAL_STRATEGY=per_chunk         # per_chunk (default; one call/chunk, section-tailored context)
#                                      #   every chunk — N× cheaper, still propagates the doc
#                                      #   subject) | per_chunk (one call/chunk, section-tailored
#                                      #   context — the Anthropic recipe).
# CONTEXTUAL_LABEL_RAW=true            # decoupled mode (default): label the RAW chunk and use the
#                                      #   context ONLY for the embedding — keeps label precision
#                                      #   while propagating the subject via vectors).

# --- Model-endpoint HTTP budgets (optional) ---
# Per-request timeouts for calls to the LLM and embedding endpoints. Read by
# every in-repo client (core/model_http_policy.py), except the two named below
# and the vendored comps graph transformer, which has no budget of ours to set. Two clients are deliberately left unbounded: the
# retriever's HuggingFaceEndpointEmbeddings (a pydantic model whose accepted
# fields depend on the pinned langchain-huggingface, so passing a timeout it may
# not declare fails at construction rather than at call time — and it is the
# REMOTE-TEI branch, so a remote-GPU deployment is the one that has it) and its
# HuggingFaceBgeEmbeddings (in-process, no HTTP hop to bound).
# Raise these only if your model is genuinely slower than the default allows —
# on a shared GPU they are what stops a contended endpoint from stalling an
# ingest for half an hour with no error.
# Every timeout knob falls back to its default on a non-numeric,
# zero or negative value, so a typo cannot take a service down. MODEL_LLM_MAX_
# RETRIES is the exception and 0 is a real value for it: it means "no SDK
# retries" and is honoured as set. Setting both names does not blend them —
# MODEL_LLM_TIMEOUT_SECONDS wins, and a rejected value resolves to the default
# rather than deferring to VLLM_TIMEOUT beside it.
#
# MODEL_LLM_TIMEOUT_SECONDS=180   # vLLM completions made by THIS repo: the
#                                 #   retriever's API-key probe. Embedding is
#                                 #   MODEL_EMBEDDING_TIMEOUT_SECONDS below, and
#                                 #   the summarizer MODEL_SUMMARIZER_TIMEOUT_
#                                 #   SECONDS below — neither is this knob. Not
#                                 #   the chat path — that call lives inside the
#                                 #   vendored comps orchestrator graph, which has
#                                 #   no configurable budget at all (see
#                                 #   OVERRIDES.yaml).
#                                 #   Lower than the openai-python default of
#                                 #   600 on purpose: the phase behind it
#                                 #   degrades (a probe that misses its budget
#                                 #   leaves documents unsummarised), so a request
#                                 #   that has not answered in 3 min is delaying an
#                                 #   otherwise usable document.
#                                 #   Total only. The 5 s connect ceiling the
#                                 #   openai SDK ships is kept regardless — a GPU
#                                 #   node that stops answering gives up in 5 s
#                                 #   rather than the full budget. Raising it
#                                 #   for a slower model? Then raise
#                                 #   DATAPREP_LLM_PHASE_TIMEOUT_SECONDS too —
#                                 #   the ceiling must stay above
#                                 #   (1+retries) x this.
# MODEL_LLM_MAX_RETRIES=2         # SDK-level retries on 408/409/429/5xx and
#                                 #   connection errors. The phase ceiling has
#                                 #   to outlast two terms:
#                                 #     ladder (1+retries) x 180s = 540s
#                                 #     waves  x 180s = 4 x 180 = 720s
#                                 #   Both fit under the 900s default, and it is
#                                 #   the WAVES term that binds. Raising
#                                 #   either the per-call budget or the batch
#                                 #   size is what crosses it (300s/call needs
#                                 #   1200s of waves). If you raise one, raise
#                                 #   DATAPREP_LLM_PHASE_TIMEOUT_SECONDS too, or
#                                 #   dataprep warns at startup.
# MODEL_EMBEDDING_TIMEOUT_SECONDS=600 # The retriever's embedding client,
#                                 #   OpenAI-API branch ONLY. The TEI branch
#                                 #   (TEI_EMBEDDING_ENDPOINT and HF_TOKEN)
#                                 #   uses HuggingFaceEndpointEmbeddings and is
#                                 #   deliberately unbudgeted — and that branch
#                                 #   is the REMOTE-GPU topology, so on a remote
#                                 #   deployment this knob does not reach it.
#                                 #   HuggingFaceBgeEmbeddings is in-process.
#                                 #   This call was UNBOUNDED before the knob
#                                 #   existed: langchain-openai forwards
#                                 #   request_timeout (default None) into the
#                                 #   openai client, and an explicit None
#                                 #   overrides the SDK default. So 600 is a
#                                 #   new ceiling, not a restatement — there is
#                                 #   no pre-existing floor to reason from.
#                                 #   Lower it only knowing how this call fails:
#                                 #   the retriever's except clause returns []
#                                 #   and that short-circuits ahead of the
#                                 #   hybrid/BM25 leg, so too low a value yields
#                                 #   a silently EMPTY retrieval, not a visible
#                                 #   error.
# MODEL_SUMMARIZER_TIMEOUT_SECONDS=600 # The retriever's document summarizer.
#                                 #   Deliberately NOT tightened to the LLM
#                                 #   budget: its except clause re-raises
#                                 #   anything but vLLM input overflow, so a
#                                 #   timeout becomes a 500 on the chat request.
#                                 #   Also a new ceiling, not the SDK default
#                                 #   kept — the client carried no timeout. 600
#                                 #   matches the openai SDK's own default so a
#                                 #   no-fallback call is as unlikely as
#                                 #   possible to turn a working deployment
#                                 #   into a failing one.
# MODEL_CONNECT_TIMEOUT_SECONDS=30  # The CONNECT phase ceiling for the two
#                                 #   aiohttp clients that this policy gave a
#                                 #   budget to. aiohttp's default session
#                                 #   already carried 30 s here; passing an
#                                 #   explicit ClientTimeout(total=...) DROPS
#                                 #   it, and None means no limit, not
#                                 #   "inherit" — so bounding those calls would
#                                 #   otherwise have removed a ceiling rather
#                                 #   than added one. Raise it for slow DNS or a
#                                 #   routed mesh; nothing else reads it.
# MODEL_PROBE_TIMEOUT_SECONDS=10     # The /v1/models probe behind the TTL-
#                                 #   cached model-id lookup (retriever
#                                 #   summarizer init, dataprep graph). It
#                                 #   degrades — a failure logs and falls back
#                                 #   to the configured model id — but a vLLM
#                                 #   still loading weights takes MINUTES to
#                                 #   answer, and the fallback then silently
#                                 #   picks the configured id instead of the
#                                 #   served one. Raise it on a remote GPU node
#                                 #   whose models load slowly.
# MODEL_RERANK_TIMEOUT_SECONDS=300 # TEI rerank. Deliberately NOT tighter than the
#                                 #   300 s an unconfigured aiohttp session would
#                                 #   have used: the rerank path has no fallback, so
#                                 #   its timeout becomes a 500 on the chat request.
#                                 #   Lower it only once rerank can degrade.
# MODEL_AUTH_TIMEOUT_SECONDS=300  # The dataprep service-account token fetch.
#                                 #   Its own knob, NOT the control-plane 30 s:
#                                 #   every _write_ingestion_log and
#                                 #   _update_doc_status call waits on this
#                                 #   token, it is a single attempt with no
#                                 #   retry, and a failure re-raises. So there
#                                 #   is no degradation route and the value
#                                 #   stays at what aiohttp applied. Raise it
#                                 #   for a Keycloak slow to start.
# MODEL_CONTROL_PLANE_TIMEOUT_SECONDS=30  # The in-cluster control-plane calls:
#                                 #   ingestion-log writes, doc-status updates,
#                                 #   doc-repo callbacks. NOT the Keycloak token
#                                 #   fetch, which is the knob above.
# VLLM_TIMEOUT                     # NOT SETTABLE THROUGH THIS FILE. The only
#                                 #   reader is the vendored comps graph
#                                 #   transformer, and it takes the value
#                                 #   verbatim from os.getenv: an injected value
#                                 #   arrives as a STRING, httpx 0.28 does not
#                                 #   coerce it, and the client raises TypeError
#                                 #   instead of timing out. It is therefore
#                                 #   injected nowhere, and the graph phase keeps
#                                 #   comps' own 600 s default — which is also
#                                 #   correct, that being the one phase with no
#                                 #   fallback. See genie-ai-overlay/OVERRIDES.yaml.
#
# Dataprep phase budgets — the wall clock for a whole LLM phase, not one call.
# A phase that runs out is abandoned and degrades (labelling to file labels,
# context generation to the raw chunk); it does not fail the ingest.
#
# DATAPREP_LLM_PHASE_TIMEOUT_SECONDS=900   # labelling / context generation.
#                                 #   Wall clock for a whole LLM phase, not for
#                                 #   one call. Above a single batched call
#                                 #   ((1+MAX_RETRIES) x 180 = 540s) so a slow
#                                 #   batch still completes, and far below one
#                                 #   batch task (540s + batch_size x 1620s =
#                                 #   ~7020s at defaults) so the phase gives up
#                                 #   while stragglers are still retrying. Raise
#                                 #   it for large documents: it is a flat
#                                 #   ceiling, not an allowance per wave.
#                                 #   Sized for WAVES, not batches: 65 batches
#                                 #   at concurrency 20 is 4 waves, so the
#                                 #   reference document needs 4 x 180 = 720s
#                                 #   even when every call finishes inside its
#                                 #   own budget. 900s clears that, so at the
#                                 #   defaults only a call that actually times
#                                 #   out can trigger degradation.
#                                 #   The ceiling does NOT scale with document
#                                 #   size, so a document large enough that its
#                                 #   labelling legitimately takes longer is
#                                 #   degraded to file labels.
#                                 #   KEEP IT ABOVE BOTH: waves x
#                                 #   MODEL_LLM_TIMEOUT_SECONDS (4 x 180 = 720s
#                                 #   at the defaults) AND
#                                 #   (1+MODEL_LLM_MAX_RETRIES) x
#                                 #   MODEL_LLM_TIMEOUT_SECONDS (540s). The
#                                 #   wave term is the one that usually binds —
#                                 #   65 batches at concurrency 20 is 4 waves
#                                 #   sharing one ceiling. Below either, chunks
#                                 #   fall back per chunk, which looks like a
#                                 #   labelling-quality regression rather than a
#                                 #   misconfiguration, and the document lands
#                                 #   as 'Ingested with Warnings'. The defaults
#                                 #   leave a 180s margin. dataprep warns at
#                                 #   startup naming both if it is too low.
# DATAPREP_LLM_PROGRESS_INTERVAL_SECONDS=60  # how often a running phase reports
#                                 #   "LLM labeling in progress: N/M batches
#                                 #   completed, K in flight, Ts elapsed
#                                 #   (budget Xs)" to the ingestion log
#                                 #   (the admin UI reads that log). Raise it to
#                                 #   quiet a busy log, lower it for more detail.

# Hybrid Retrieval — BM25 + Reciprocal Rank Fusion (Contextual Retrieval Part B) — OPTIONAL, default OFF.
# When enabled, the retriever runs a lexical (BM25) channel over <GRAPH>_SOURCE.text
# alongside the dense vector search and fuses the two result sets with weighted
# Reciprocal Rank Fusion. Recovers exact-match / rare-term / keyword-heavy queries
# that dense embeddings rank poorly. Both channels read the same `text` field
# (contextualized by Part A). Opt-in; OFF = true no-op (dense-only, byte-for-byte).
# The BM25 ArangoSearch view is created idempotently + lazily per graph_name.
# See _bmad-output/implementation-artifacts/spec-hybrid-retrieval-bm25-rrf.md
# RETRIEVER_HYBRID_RETRIEVAL_ENABLED=false  # opt-in (default false; OFF = true no-op)
# RETRIEVER_HYBRID_RRF_K=60                 # RRF ranking constant (literature standard)
# RETRIEVER_HYBRID_BM25_CANDIDATES=50       # BM25 candidate fetch depth; fused then cut to top_k
# RETRIEVER_HYBRID_DENSE_WEIGHT=1.0         # weight on the dense channel's rank contribution
# RETRIEVER_HYBRID_LEXICAL_WEIGHT=1.0       # weight on the BM25 channel's rank contribution
# RETRIEVER_HYBRID_BM25_ANALYZER=text_en    # ArangoSearch analyzer on the text field

# Confidence scoring (chatqna) — rank-weighted aggregate of calibrated reranker
# scores. The flat mean was count-dependent and tail-sensitive (a long tail of
# low-scoring chunks kept by the adaptive strategy for novelty depressed it);
# rank-weighting lets the most relevant document dominate. See site/content/en/docs/architecture/architecture.md §9.4.
# CONFIDENCE_RANK_DECAY=0.5          # exponential weight decay per rank (rank 0 = best)
# RERANKER_SCORE_CALIBRATION=none    # none | sigmoid — enable sigmoid ONLY if TEI
#                                    #   returns raw logits (verify first: sigmoid on
#                                    #   already-normalised scores compresses them and
#                                    #   worsens the symptom). Default none is safe.
# RERANKER_SCORE_TEMPERATURE=1.0     # temperature for sigmoid calibration
# LLM_SELF_CONFIDENCE_ENABLED=0      # 0|1 — opt-in LLM self-grade: the model appends a
#                                    #   [[CONF:<0-100>]] sentinel rating how well the
#                                    #   retrieved documents support its answer; we strip
#                                    #   it from the visible text and expose it as
#                                    #   self_confidence alongside confidence_score.
#                                    #   OFF by default — surface to users only after the
#                                    #   eval harness confirms it is calibrated.

