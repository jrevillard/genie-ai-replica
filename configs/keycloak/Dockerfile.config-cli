FROM adorsys/keycloak-config-cli:6.5.0-26

# The upstream image runs as uid 65534 and ships without a security-upgrade
# layer, so its Ubuntu 24.04 base packages only move when the upstream image
# is rebuilt. Pull published security fixes at build time instead — the
# monthly rebuild then picks them up automatically (perl, p11-kit, libc6...).
USER root
# --fix-missing + retries: Ubuntu occasionally serves an index that references
# a pool .deb already rotated out (index/pool skew on security.ubuntu.com —
# seen 2026-09-24 with libexpat1 2.6.1-2ubuntu0.6, hard 404 on every fresh
# build for ~1h). apt then skips that one package instead of failing the
# whole image build; the skipped bump is picked up by the next rebuild.
# The OS packages are refreshed by a separate, bustable layer: the monthly
# rebuild passes --build-arg CACHE_BUST=<timestamp>, and a layer that takes
# that argument is the only one whose cache key changes.
#
# Position: after the expensive layers (what sits above it stays cached — a
# layer's cache key includes its parent), before the writes to package-owned
# paths (a package that moves would restore its own files over ours), and
# still root.
#
# The upgrade output is kept OUT of the job trace and printed only when the
# step fails: Cloudflare's WAF is SUSPECTED to refuse the trace upload of any
# job whose log carries a sensitive path, and dpkg prints one here ("Installing new
# version of config file /etc/issue", measured on this base image). The WAF
# exception is tracked in issue #2001 — this workaround is to be purged once
# it lands.
ARG CACHE_BUST=0
RUN CACHE_BUST=$CACHE_BUST apt-get update -y -o Acquire::Retries=5 && \
    (CACHE_BUST=$CACHE_BUST apt-get upgrade -y --with-new-pkgs --fix-missing -o Acquire::Retries=5 > /tmp/apt.log 2>&1 || { tail -n 50 /tmp/apt.log | sed -E 's#(/[A-Za-z0-9._~/-]{2,})#<path>#g'; exit 1; }) && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && rm -f /tmp/apt.log
USER 65534

COPY genie-realm.yaml /config/genie-realm.yaml
COPY --chmod=755 config-and-sleep.sh /usr/local/bin/config-and-sleep.sh

ENTRYPOINT ["/usr/local/bin/config-and-sleep.sh"]
