# GPU Configuration for AMD Strix Halo (Radeon 8060S iGPU, gfx1151, unified memory)
#
# SINGLE-SERVER PROFILE: the RERANKER_BACKEND=vllm and
# EMBEDDING_BACKEND=vllm pins below assume the rocm-models profile's
# vllm-reranker / vllm-embedding services. On a compose SPLIT venue unset
# both — the gpu-proxy routes /rerank and /v1/embeddings to the node-side
# instances — see the ROCm section of site/content/en/docs/deploy/gpu.md.
#
# Usage:
#   docker compose --env-file .env --env-file env.strixhalo \
#     -f docker-compose.yaml \
#     --profile opea --profile gpu-models --profile rocm-models up -d
#
# NO overlay files: the vendor axis lives in the base compose files as
# VALUES (image pins, device paths, group GIDs) and in the rocm-models
# profile (the two pooling instances). COMPOSE_PROFILES does NOT work
# here — it is a CLI-level variable, silently ignored inside --env-file,
# and an explicit --profile flag REPLACES it. Pass the flags.
#
# Values measured on the reference machine (Ryzen AI MAX+ 395, 91 GB unified
# RAM, GTT aperture 45.8 GiB) — see docs/superpowers/specs/
# 2026-11-11-rocm-gpu-tier-spike-results.md for the measurements behind
# every number. The GTT is carved from system RAM: the GPU-tier claims
# below coexist with other workloads on the host.

# ========= Vendor image pins (the VENDOR axis, base variable names) =========
# Main + translation + pooling vLLM: ROCm 10.1 build of vLLM 0.29.x —
# version parity with the NVIDIA pin (vllm/vllm-openai:v0.29.0). Verified
# serving all four models with guided JSON in the spike. Unset VLLM_IMAGE
# (every NVIDIA deployment) keeps the compose default.
VLLM_IMAGE=rocm/vllm:rocm10.1.0_ubuntu24.04_py3.14-pytorch_2.13.0_vllm-0.29.0
# TEI: the ROCm image fails on gfx1151 (Instinct-only kernels) — CPU image
# per the spike decision. bge-scale models on 32 cores are ample and claim
# no GTT. These are the BASE compose variables (the same rows env.t4 /
# env.rtx6000 leave unset).
TEI_EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3
TEI_RERANKING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3

# ========= Vendor device passthrough (the same axis) =========
# The base files interpolate these into devices: on every GPU service.
# An NVIDIA host never sets them, so compose renders /dev/null and
# /dev/zero — paths that exist on every host (a missing device path is a
# hard create-time error).
GPU_DEVICE_KFD=/dev/kfd
GPU_DEVICE_DRI=/dev/dri
# Device group GIDs — distro-specific; `getent group render video` on the
# GPU host. Defaults match the reference Ubuntu host (render=990, video=44).
RENDER_GID=990
VIDEO_GID=44
# Neutralize the NVIDIA device var on THIS venue: compose merges
# `environment:` by key, and the base rows are `${NVIDIA_VISIBLE_DEVICES:-all}`
# — setting it here flips every GPU-tier service to `void`, which ROCm
# containers ignore and which claims no GPU even on an NVIDIA host.
NVIDIA_VISIBLE_DEVICES=void

# ========= Main LLM (vllm) — shared-era sizing, REVERTED 2026-11-18 =========
# Sized for a SHARED host: the operator's budget for the whole GPU tier
# peaked at 27 GB (decision 2026-11-11). Model set: granite-3.1-2b main +
# gemma-3-1b-it translation. 0.28 claims ~12.8 GiB (weights ~4.3 + KV
# ~3.8 for a 49152 window + runtime overhead). Total tier peak measured
# ≤ ~22 GB against the 27 GB ceiling.
#
# 8B DEDICATED-HOST PROBE (2026-11-18, REVERTED — the operator rolled back
# to this 2B sizing for further testing): granite-4.1-8b booted fine at
# 0.66/32768 — weights 15.64 GiB, KV cache 14.08 GiB = 92,256 tokens
# (the granite-4 hybrid mamba keeps KV per token tiny), max concurrency
# 2.82x at 32,768-token requests, guided-JSON labeling + chat probes
# passed, engine init 374 s. It came DOWN because the ~30 GiB model claim
# is also ~30 GiB of host RAM (GTT pages are unified memory) and the 91
# GiB host dropped to ~4 GiB free with the desktop up. THE CONSTRAINT FOR
# ANY LARGER MODEL IS HOST RAM, NOT THE GPU APERTURE. A future round
# starts there: 0.45 util claims ~20.6 GiB total — after the 15.64 GiB
# weights only ~5 GiB KV remains (~33k tokens at the measured ~0.156
# MiB/token), less than ONE 32k request — so fp16 8B does NOT fit this
# aperture at any util that leaves the tier coexisting; the realistic
# path is a ROCm-compatible AWQ/GPTQ 8B build (~9 GiB weights) if one
# verifies on gfx1151.
VLLM_LLM_MODEL_ID=ibm-granite/granite-3.1-2b-instruct
# granite-3.1 takes the `granite` tool-call parser (vLLM 0.29 docs) — NOT the
# granite4 default the compose pin carries for Granite 4.x models (#2052).
VLLM_TOOL_CALL_PARSER=granite
VLLM_GPU_UTILIZATION=0.28
VLLM_MAX_MODEL_LEN=49152
VLLM_MAX_NUM_SEQS=16
VLLM_DTYPE=half

# ========= Translation LLM (vllm-translation-guardrail) =========
# gemma-3-1b-it (~2 GiB bf16 weights): 0.12 claims ~5.5 GiB — weights
# plus an 8192-window KV cache with margin. Verified in the coexistence
# probe.
VLLM_TRANSLATION_GPU_UTILIZATION=0.12
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_MAX_NUM_SEQS=16
VLLM_TRANSLATION_DTYPE=auto

# ========= Docling =========
# Dataprep's docling runs CPU-side on the ROCm path (no docling ROCm
# support; the CUDA probe in dataprep would otherwise warn and fall back).
DOCLING_DEVICE=cpu

# ========= TEI CPU footprint =========
# TEI runs the CPU image here (the ROCm build fails on gfx1151 — see the
# spike results). The base compose's batch knobs assume GPU-side TEI;
# on CPU they inflate candle's buffer pools (the reranker measured
# 16.3 GiB RSS at 8192/32). Capping them cuts the footprint ~3x with
# no quality effect — batching depth is throughput, not accuracy.
TEI_RERANKING_MAX_BATCH_TOKENS=2048
TEI_RERANKING_MAX_CONCURRENT_REQUESTS=8
TEI_EMBEDDING_MAX_BATCH_TOKENS=2048
# bge-reranker-v2-m3's max input is 8192 tokens; with a 2048 batch cap TEI
# requires truncation enabled (chunks are ~500 chars — truncation is
# theoretical in the RAG path).
TEI_RERANKING_AUTO_TRUNCATE=true

# ========= Host ports for a shared machine =========
# The reference machine already hosts other stacks on 80/443/8529 — the
# ROCm venues publish on free ports (audit in the spike-results doc).
# NGINX_HTTP_PORT/NGINX_HTTPS_PORT/ARANGO_PORT serve the single-server
# main-stack venue; GPU_HTTP(S)_PORT serve the split GPU-node venue
# (docker-compose.gpu.yaml + its ROCm overlay). Drop or adjust on a
# dedicated ROCm host.
NGINX_HTTP_PORT=8180
NGINX_HTTPS_PORT=8443
ARANGO_PORT=18529
GPU_HTTPS_PORT=18443
GPU_HTTP_PORT=8181

# ========= Model IDs =========
# VLLM_LLM_MODEL_ID is pinned in the Main LLM block above (shared-era
# sizing, 2026-11-18). Translation stays on the spike's measured model per
# the operator's no-translation-upgrade ruling.
VLLM_TRANSLATION_MODEL_ID=google/gemma-3-1b-it

# ========= Device group GIDs (distro-specific) =========
# Set in the vendor block above.

# ========= Split-URL OIDC values (backend / okf-server / document-repository) ==
# The base compose carries these passthroughs with EMPTY defaults — the
# NVIDIA shape (one URL, in-network). This venue needs the discovery/JWKS
# fetches pinned in-network AND the browser-edge issuer trusted. Values
# are literals (dotenv does not interpolate), so the realm is spelled out.
# KEYCLOAK_PUBLIC_URL names the browser edge — that is venue-specific
# (domain + port live in .env), so it is set in the VENUE .env, not here.
KEYCLOAK_DISCOVERY_URL=http://keycloak:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/genie/protocol/openid-connect/certs

# ========= vLLM reranker backend (Task 14) =========
# The TEI ROCm image cannot run on gfx1151 (Instinct-only kernels — see the
# spike results), so the reranker is served by a THIRD vLLM instance on the
# GPU, and the reranker wrapper is switched to it by config. TEI stays the
# default backend everywhere else (RERANKER_BACKEND unset = tei = NVIDIA
# path unchanged). The response normalization and the request-shape switch
# live in the reranker component (genieai_tei_reranker.py).
RERANKER_BACKEND=vllm
# The overlay network name of the vLLM reranker instance (compose service
# `vllm-reranker`); the split GPU-node topology overrides this to the node's
# published address.
RERANKER_VLLM_ENDPOINT=http://vllm-reranker:8000
# The cross-encoder served by the instance. vLLM calls the score field
# `relevance_score` (Cohere shape); the wrapper normalizes it.
VLLM_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_VLLM_MODEL=BAAI/bge-reranker-v2-m3
# ~2.3 GiB of the GTT at 0.05 (568M-param bf16 weights + activation) —
# spike-measured 1.56 GiB touched. Sits inside the dedicated-host budget
# beside granite-3.1-2b (0.28) + gemma (0.12).
VLLM_RERANKER_GPU_UTILIZATION=0.05
VLLM_RERANKER_MAX_MODEL_LEN=8192

# ========= vLLM embedding backend (Task-14 mirror) =========
# Same story as the reranker above: the TEI ROCm image cannot run on gfx1151
# and the CPU TEI embedder saturates ~24 cores under concurrent ingest, so
# embeddings are served by their own vLLM instance on the GPU serving
# bge-large-en-v1.5 as a pooling model (OpenAI shape,
# POST /v1/embeddings {model, input} → data[].embedding — spike-verified).
# Both consumers move together (dataprep embeds the corpus, the retriever
# embeds the queries — a split would mix vector spaces in one collection).
# TEI stays the default backend on every other deployment
# (EMBEDDING_BACKEND unset = tei = NVIDIA path unchanged).
EMBEDDING_BACKEND=vllm
# The overlay network name of the vLLM embedding instance (compose service
# `vllm-embedding`). It serves BOTH embedding consumers:
#   - dataprep (corpus) and the retriever's fallback branch read it as the
#     vLLM backend's base URL ({base}/v1/embeddings);
#   - chatqna's RAG graph encodes the QUERY through its `embedding` node,
#     and that node reads the same URL (MR !968 review: without it the GPU
#     embedder would serve ingestion only and every chat query would be
#     encoded by the CPU TEI container). chatqna derives the node's
#     host/port/protocol/endpoint from it and posts the same OpenAI-shaped
#     body; the bge query instruction is applied by chatqna itself.
# The split GPU-node topology has NO vllm-embedding service — the node's
# /embed/ route stays TEI (CPU), so split-venue embeddings are TEI by
# design and no node-side override exists.
EMBEDDING_VLLM_ENDPOINT=http://vllm-embedding:8000
