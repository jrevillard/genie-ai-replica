    "Username can only contain letters, numbers, underscores, dots and hyphens" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لاسم المستخدم أن يحتوي فقط على أحرف وأرقام وشرطات سفلية ونقاط"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername darf nur Buchstaben, Zahlen, Unterstriche, Punkte und Bindestriche enthalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Username can only contain letters, numbers, underscores, dots and hyphens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El usuario solo puede contener letras, números, guiones bajos, puntos y guiones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur ne peut contenir que des lettres, des chiffres, des traits de soulignement, des points et des tirets"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
