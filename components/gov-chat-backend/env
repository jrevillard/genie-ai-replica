# ArangoDB Configuration
ARANGO_URL=http://arango-vector-db:8529  # Matches Docker service name
ARANGO_DB_NAME=node-services
ARANGO_USER=root
ARANGO_PASSWORD=<your_arango_password>

# Database Backup Configuration
BACKUP_DIR=./database_backups
MAX_BACKUPS=5
BACKUP_FORMAT=json
COMPRESS_BACKUPS=true
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
NODE_ENV=production
API_PREFIX=/api

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Session Configuration
# SESSION_SECRET=your_session_secret_here  # Replace with a secure random string
SESSION_SECRET=<your_session_secret>
SESSION_EXPIRATION_TIME=1800000  # 30 minutes in milliseconds

# CORS Configuration
CORS_ORIGIN=https://your-domain.example.com/

# Email configuration
EMAIL_HOST=<your_smtp_host>
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<your_smtp_user>
EMAIL_PASSWORD=<your_smtp_password>
EMAIL_FROM=noreply@genie-ai.itu.int

# App config
APP_NAME=Genie AI
#FRONTEND_URL=https://e2e-82-109.ssdcloudindia.net
FRONTEND_URL=https://genie-ai.itu.int/
OPENWEATHERMAP_API_KEY=<your_openweathermap_api_key>

# Frontend Translation Service configuration
TRANSLATION_THREADS=4
TRANSLATION_BATCHES=5
TRANSLATION_CACHE=on
TRANSLATION_CACHE_PATH=/cache/translations
TRANSLATION_CACHE_PASSWORD=<your_redis_password>
TRANSLATION_CACHE_HOST=redis-cache
TRANSLATION_CACHE_PORT=6379

# OPEA Host configuration
OPEA_HOST=<your_opea_host>
OPEA_PORT=8888
CONTEXT_OPTION=conversation-with-context-labels

#CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:8090,https://localhost:8090,https://genie-ai.itu.int,/^https?:\/\/.*\.ssdcloudindia\.net$$/
CSP_CONNECT_SRC="'self' http://localhost:3000 http://localhost:8090 ws://localhost:8090 wss://*.ssdcloudindia.net *.ssdcloudindia.net https://api.open-meteo.com https://ipapi.co https://nominatim.openstreetmap.org wss://genie-ai.itu.int:443'"

