# AMINA Frontend — local env
# ============================
# This file is gitignored and loaded by Vite at dev/build time. Any var
# prefixed with VITE_* is exposed to client-side code.
#
# After editing this file you must RESTART vite (it only reads .env at
# startup, not on HMR).

# API base (backend)
VITE_API_URL=http://localhost:8000

# ── DHIS2 OAuth ──
# Public demo instance — our aggregate push + tracker + OAuth client
# "amina" (secret "amina-dev-secret") are all registered here.
VITE_DHIS2_BASE_URL=https://play.im.dhis2.org/dev

# ── Google OAuth — REQUIRES YOU to create a Client ID ──
# Steps (one-time, 3–5 min):
#   1. console.cloud.google.com → Create project → OAuth consent screen → Set up
#   2. Credentials → Create credentials → OAuth client ID → Web application
#   3. Authorized JS origins:  http://localhost:5173
#   4. Authorized redirect URIs: http://localhost:5173
#   5. Copy the Client ID (ends in .apps.googleusercontent.com) into the
#      value below and restart vite.
VITE_GOOGLE_CLIENT_ID=388978201475-a3s7di74d4dciokr9mq34ec62b659h11.apps.googleusercontent.com

# ── Facebook OAuth — REQUIRES YOU to create a Facebook Login product ──
# Steps (one-time, 3–5 min):
#   1. developers.facebook.com → Your app (you already have Amina Test 1.0
#      or Amina wsp from the WhatsApp setup earlier) → Add product →
#      Facebook Login → Web
#   2. Valid OAuth Redirect URIs: http://localhost:5173/
#   3. Copy the app's "App ID" from Settings → Basic into the value below
#      and restart vite. Example:
#        VITE_FACEBOOK_APP_ID=1388627716614900
VITE_FACEBOOK_APP_ID=1388627716614900

# ── Channels FAB handles (from the earlier Meta + Telegram setup) ──
# If you set these, the "Talk to us" bottom-right FAB will deep-link users
# to your bot. Leave blank to show "coming soon".
VITE_AMINA_WHATSAPP_NUMBER=
VITE_AMINA_MESSENGER_HANDLE=
VITE_AMINA_TELEGRAM_HANDLE=amina_care_bot
