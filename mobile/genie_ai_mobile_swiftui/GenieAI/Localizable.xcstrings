    "You have unsaved changes. Are you sure you want to cancel?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك تغييرات غير محفوظة. هل أنت متأكد أنك تريد الإلغاء؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast ungespeicherte Änderungen. Bist du sicher, dass du abbrechen möchtest?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have unsaved changes. Are you sure you want to cancel?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes cambios sin guardar. ¿Seguro que deseas cancelar?"
