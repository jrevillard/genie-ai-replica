    "Warning: This action is permanent and cannot be undone. All your data will be permanently deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحذير: هذا الإجراء دائم ولا يمكن التراجع عنه. سيتم حذف جميع بياناتك نهائياً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Diese Aktion ist dauerhaft und kann nicht rückgängig gemacht werden. Alle deine Daten werden unwiderruflich gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: This action is permanent and cannot be undone. All your data will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia: Esta acción es permanente. Todos tus datos se borrarán irremediablemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertissement : Cette action est permanente et irréversible. Toutes vos données seront définitivement supprimées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan: Tindakan ini bersifat permanen dan tidak dapat dibatalkan. Semua data Anda akan dihapus secara permanen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: Esta ação é permanente e não pode ser desfeita. Todos os seus dados serão excluídos permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание: Это действие необратимо. Все ваши данные будут удалены навсегда."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onyo: Kitendo hiki ni cha kudumu na hakiwezi kubatilishwa. Data yako yote itafutwa kabisa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำเตือน: การกระทำนี้เป็นการถาวรและไม่สามารถย้อนกลับได้ ข้อมูลทั้งหมดของคุณจะถูกลบอย่างถาวร"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：此操作是永久性的，无法撤销。您的所有数据将被永久删除。"
          }
        }
      }
