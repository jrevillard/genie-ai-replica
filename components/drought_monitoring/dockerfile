FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY README.md .
COPY src/ ./src/

RUN pip install -e .

# PDF output volume mount point
RUN mkdir -p /app/reports

ENV GEE_PROJECT=mewa-493916 \
    DROUGHT_REPORTS_DIR=/app/reports \
    LOG_LEVEL=INFO

# FastAPI server — triggered by warning_system_engine scheduler
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8001", "--app-dir", "src"]
