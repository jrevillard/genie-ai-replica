        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Median (p50) request latency per service",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
