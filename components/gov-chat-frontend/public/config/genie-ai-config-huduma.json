{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI Chatbot"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Category ID for the button (null for general)"
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "i18n key for text user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "i18n key for detailed prompt sent to LLM"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "action",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "Huduma AI",
    "icon": {
      "type": "file",
      "value": "/config/huduma-icon.svg"
    }
  },
  "theme": {
    "primaryColor": "#4E97D1",
    "secondaryColor": "#2C5F8A",
    "backgroundColor": "#f5f7fa",
    "textColor": "#333333",
    "navbar": {
      "gradientStart": "#4E97D1",
      "gradientEnd": "#2C5F8A",
      "textColor": "#ffffff"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to Huduma AI, your public service assistant!",
      "botName": "Huduma",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "styles": {
              "backgroundColor": "#f0f7ff",
              "hoverColor": "#e1f0ff",
              "outlineColor": "#bcdcff"
            },
            "action": {
              "visibleText": "quickhelp.justChatUserPrompt",
              "hiddenPrompt": "quickhelp.justChatPrompt"
            }
          },
          {
            "id": "identity-civil",
            "title": "quickhelp.applyForID",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/identity-civil.svg"
            },
            "category": "1",
            "styles": {
              "backgroundColor": "#f5f9ff",
              "hoverColor": "#e6f0ff",
              "outlineColor": "#d1e0ff"
            },
            "action": {
              "visibleText": "quickhelp.applyForIDUserPrompt",
              "hiddenPrompt": "quickhelp.applyForIDPrompt"
            }
          },
          {
            "id": "taxes-revenue",
            "title": "quickhelp.payTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/taxes-revenue.svg"
            },
            "category": "5",
            "styles": {
              "backgroundColor": "#fff7ed",
              "hoverColor": "#ffedd5",
              "outlineColor": "#fed7aa"
            },
            "action": {
              "visibleText": "quickhelp.payTaxesUserPrompt",
              "hiddenPrompt": "quickhelp.payTaxesPrompt"
            }
          },
          {
            "id": "business-trade",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-trade.svg"
            },
            "category": "8",
            "styles": {
              "backgroundColor": "#f5f3ff",
              "hoverColor": "#ede9fe",
              "outlineColor": "#ddd6fe"
            },
            "action": {
              "visibleText": "quickhelp.startBusinessUserPrompt",
              "hiddenPrompt": "quickhelp.startBusinessPrompt"
            }
          },
          {
            "id": "healthcare-social",
            "title": "quickhelp.findHealthcare",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/healthcare-social.svg"
            },
            "category": "2",
            "styles": {
              "backgroundColor": "#fef2f2",
              "hoverColor": "#fee2e2",
              "outlineColor": "#fecaca"
            },
            "action": {
              "visibleText": "quickhelp.findHealthcareUserPrompt",
              "hiddenPrompt": "quickhelp.findHealthcarePrompt"
            }
          },
          {
            "id": "education-learning",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": "3",
            "styles": {
              "backgroundColor": "#eff6ff",
              "hoverColor": "#dbeafe",
              "outlineColor": "#bfdbfe"
            },
            "action": {
              "visibleText": "quickhelp.educationServicesUserPrompt",
              "hiddenPrompt": "quickhelp.educationServicesPrompt"
            }
          },
          {
            "id": "transportation-mobility",
            "title": "quickhelp.transportLicenses",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/transportation-mobility.svg"
            },
            "category": "7",
            "styles": {
              "backgroundColor": "#f5f3ff",
              "hoverColor": "#ede9fe",
              "outlineColor": "#ddd6fe"
            },
            "action": {
              "visibleText": "quickhelp.transportLicensesUserPrompt",
              "hiddenPrompt": "quickhelp.transportLicensesPrompt"
            }
          },
          {
            "id": "housing-urban",
            "title": "quickhelp.housingPrograms",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/housing-urban.svg"
            },
            "category": "9",
            "styles": {
              "backgroundColor": "#ecfeff",
              "hoverColor": "#cffafe",
              "outlineColor": "#a5f3fc"
            },
            "action": {
              "visibleText": "quickhelp.housingProgramsUserPrompt",
              "hiddenPrompt": "quickhelp.housingProgramsPrompt"
            }
          },
          {
            "id": "employment-labor",
            "title": "quickhelp.findJobs",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/employment-labor.svg"
            },
            "category": "4",
            "styles": {
              "backgroundColor": "#fdf2f8",
              "hoverColor": "#fce7f3",
              "outlineColor": "#f9a8d4"
            },
            "action": {
              "visibleText": "quickhelp.findJobsUserPrompt",
              "hiddenPrompt": "quickhelp.findJobsPrompt"
            }
          }
        ]
      }
    }
  },
  "custom": {}
}