{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GENIE.AI Framework Configuration",
  "description": "Configuration file for customizing the GENIE.AI chatbot framework with dual-prompt mechanism for quick help buttons",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "General application settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main application title displayed in the UI",
          "default": "GENIE.AI"
        },
        "icon": {
          "type": "object",
          "description": "Application icon configuration (SVG)",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "inline"
              ],
              "description": "Type of icon source",
              "default": "file"
            },
            "value": {
              "type": "string",
              "description": "Path to SVG file (for 'file') or inline SVG content (for 'inline')"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      },
      "required": [
        "title",
        "icon"
      ]
    },
    "theme": {
      "type": "object",
      "description": "UI theme and color scheme settings",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary color for buttons and accents",
          "default": "#4E97D1"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary color for accents and highlights",
          "default": "#2C5F8A"
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color for main content area",
          "default": "#f5f7fa"
        },
        "textColor": {
          "type": "string",
          "description": "Primary text color",
          "default": "#333333"
        },
        "navbar": {
          "type": "object",
          "description": "Navbar-specific styling",
          "properties": {
            "gradientStart": {
              "type": "string",
              "description": "Start color for navbar gradient",
              "default": "#4E97D1"
            },
            "gradientEnd": {
              "type": "string",
              "description": "End color for navbar gradient",
              "default": "#2C5F8A"
            },
            "textColor": {
              "type": "string",
              "description": "Navbar text/icon color",
              "default": "#ffffff"
            }
          }
        }
      },
      "required": [
        "primaryColor",
        "secondaryColor",
        "navbar"
      ]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles and configurations",
      "properties": {
        "chat": {
          "type": "object",
          "description": "Chat-specific settings",
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "description": "Custom welcome message for the chatbot",
              "default": "Welcome to GENIE.AI!"
            },
            "botName": {
              "type": "string",
              "description": "Name of the chatbot",
              "default": "Genie"
            },
            "quickHelp": {
              "type": "object",
              "description": "Quick Help button configurations with dual-prompt mechanism",
              "properties": {
                "buttons": {
                  "type": "array",
                  "description": "List of Quick Help buttons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the button"
                      },
                      "title": {
                        "type": "string",
                        "description": "i18n key for button label"
                      },
                      "icon": {
                        "type": "object",
                        "description": "Button icon configuration",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "file",
                              "inline"
                            ],
                            "description": "Type of icon source"
                          },
                          "value": {
                            "type": "string",
                            "description": "Path to SVG file or inline SVG content"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "category": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "serviceCategories._key (catKey) when it matches this deployment. Prefer categoryNameEN for portable configs."
                      },
                      "categoryNameEN": {
                        "type": "string",
                        "description": "English category title (must match serviceCategories.nameEN). Resolved to catKey at runtime; use instead of legacy numeric category when hierarchy is re-seeded."
                      },
                      "action": {
                        "type": "object",
                        "description": "The dual-prompt mechanism: visibleText for user, hiddenPrompt for LLM",
                        "properties": {
                          "visibleText": {
                            "type": "string",
                            "description": "i18n key for text user sees in chat"
                          },
                          "hiddenPrompt": {
                            "type": "string",
                            "description": "i18n key for detailed prompt sent to LLM"
                          }
                        },
                        "required": [
                          "visibleText",
                          "hiddenPrompt"
                        ]
                      },
                      "styles": {
                        "type": "object",
                        "description": "Custom styles for the button",
                        "properties": {
                          "backgroundColor": {
                            "type": "string",
                            "description": "Background color"
                          },
                          "hoverColor": {
                            "type": "string",
                            "description": "Hover background color"
                          },
                          "outlineColor": {
                            "type": "string",
                            "description": "Border/outline color"
                          }
                        },
                        "required": [
                          "backgroundColor",
                          "hoverColor",
                          "outlineColor"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "icon",
                      "category",
                      "action",
                      "styles"
                    ]
                  }
                }
              },
              "required": [
                "buttons"
              ]
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "description": "Custom key-value pairs for use case-specific configurations",
      "additionalProperties": true
    }
  },
  "required": [
    "app",
    "theme"
  ],
  "app": {
    "title": "GENIE.AI",
    "icon": {
      "type": "file",
      "value": "/config/genie-ai-inko.svg"
    }
  },
  "theme": {
    "primaryColor": "#1CA069",
    "secondaryColor": "#157A50",
    "backgroundColor": "#F0F4EF",
    "textColor": "#1E2B1C",
    "navbar": {
      "gradientStart": "#30572A",
      "gradientEnd": "#4A7A42",
      "textColor": "#FFFFFF"
    }
  },
  "features": {
    "chat": {
      "welcomeMessage": "Welcome to GENIE.AI, for Global Empowerment, Intelligence and Equity",
      "botName": "GENIE.AI",
      "quickHelp": {
        "buttons": [
          {
            "id": "just-chat",
            "title": "quickhelp.justChat",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/just-chat.svg"
            },
            "category": null,
            "action": {
              "visibleText": "quickhelp.justChatUserPrompt",
              "hiddenPrompt": "quickhelp.justChatPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
