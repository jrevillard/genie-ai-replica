# ======== Stage 1: The OPEA Base ========
# This stage is identical and will be cached by Docker
ARG OPEA_REPO_URL="https://github.com/opea-project/GenAIComps.git"
ARG OPEA_VERSION="v1.5"
FROM alpine/git:v2.52.0 AS opea_base

ARG OPEA_REPO_URL
ARG OPEA_VERSION

WORKDIR /src
RUN git clone --depth 1 --branch ${OPEA_VERSION} ${OPEA_REPO_URL} .

# ======== Final Stage: Assembly ========
# Match OPEA v1.5's base image (python:3.11-slim).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libcairo2 \
    libglib2.0-0 \
    libjemalloc-dev \
    libmariadb-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Add /app (for 'comps'), the retriever 'src' (for entrypoint),
# and 'proto' (for api_protocol) to PYTHONPATH
ENV PYTHONPATH="${PYTHONPATH}:/app:/app/comps/retrievers/src:/app/comps/cores/proto"

# Step A: Copy the entire OPEA 'comps' directory from the clone
COPY --from=opea_base /src/comps/ /app/comps/

# Step B: Install dependencies from the committed hash-pinned lock.
# The lock is compiled with `make lock-retriever` (uv pip compile
# --generate-hashes --python-version 3.11) from the GENIE.AI fork of OPEA
# v1.5's requirements.in. --require-hashes makes the build bit-for-bit
# reproducible and supply-chain-pinned, with no re-resolution against live PyPI.
# The v1.5 lock pins langchain-huggingface and langchain-arangodb at the
# v1.5 lock versions (langchain-arangodb 0.0.6), so the old v1.3 post-install
# upgrade blocks are gone. langchain-arangodb 0.0.6 already carries the
# `filter_clause` named-param fix (the 0.0.4 release swallowed it via **kwargs,
# so a category FILTER never reached the AQL — that silent-drop bug is absent at
# 0.0.6), so the label filter is real with this pin and needs no version bump.
# See requirements.in for the full 0.0.6 disposition.
# The OpenTelemetry deps are likewise pinned in the lock (no unhashed install).
COPY genie-ai-overlay/retriever/requirements-cpu.txt /app/requirements-cpu.txt
RUN pip install --no-cache-dir --no-deps --require-hashes -r /app/requirements-cpu.txt

# Step D: Fix docarray circular import
# The vendored comps/cores/proto/docarray.py shadows the real 'docarray' PyPI
# package on PYTHONPATH. docarray_alias_shim.py (wired via zz_genie_startup.pth at
# site-init by install_site_startup.sh, Step G) pins the real package in
# sys.modules — no vendored file is renamed or edited.
COPY genie-ai-overlay/build-patches/docarray_alias_shim.py /app/docarray_alias_shim.py

# Step E: "Overlay" our custom GENIE-AI files
# Copy the shared OTel tracing module (importable from PYTHONPATH=/app)
COPY genie-ai-overlay/tracing.py /app/tracing.py

# Copy shared TTL-cached model probe (importable as core.model_cache from PYTHONPATH=/app)
COPY genie-ai-overlay/core/model_cache.py /app/core/model_cache.py

# Copy shared label-contract decoder (chatqna encode → retriever decode)
COPY genie-ai-overlay/core/label_contract.py /app/core/label_contract.py

# Copy overlay files to their correct new locations within /app/comps/
COPY genie-ai-overlay/retriever/genieai_retriever_arangodb.py /app/comps/retrievers/src/integrations/genieai_retriever_arangodb.py
# Add the custom config.py from the overlay to fix the ImportError
COPY genie-ai-overlay/retriever/config.py /app/comps/retrievers/src/integrations/config.py
COPY genie-ai-overlay/retriever/genieai_retriever_microservice.py /app/comps/retrievers/src/genieai_retriever_microservice.py

# This path remains correct as it's relative to /app/comps/
COPY genie-ai-overlay/core/genieai_api_protocol.py /app/comps/cores/proto/genieai_api_protocol.py

# Step F: Create non-root user and set permissions
RUN useradd -ms /bin/bash user && \
    chown -R user:user /app /home/user

# Step G: Install the SSL bypass runtime patch via a .pth site-init hook
# (no-op unless OPEA_SSL_SKIP_VERIFY=1). The installer derives the site-packages
# path from the running interpreter, so no hardcoded python3.x path is needed.
# docarray_alias_shim.py (Step D) is picked up automatically when present.
COPY --chmod=0755 genie-ai-overlay/build-patches/install_site_startup.sh /app/install_site_startup.sh
COPY configs/ssl/genie_ssl_patch.py /app/genie_ssl_patch.py
RUN /app/install_site_startup.sh

# Step H: Run the new GENIE-AI entry point from its new location
USER user
CMD ["python", "comps/retrievers/src/genieai_retriever_microservice.py"]
