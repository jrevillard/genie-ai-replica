{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "Pins the values a wrong TYPE or a wrong ENUM would silently mis-render. Enums: a wrong clusterProfile renders the dev topology and the drift hook cannot catch it. Booleans: Helm's `not`/`and`/`or`/`ternary` are strict \u2014 a knob set to 0 or \"true\" aborts the render with 'wrong type for value; expected bool; got int64', so the type is checked up front instead. Everything else stays permissive (no additionalProperties:false anywhere) \u2014 Helm injects `global`, and future tiers add keys. Every boolean leaf of values.yaml is typed here; scripts/values-schema-bools-check.py fails the build when a new one is added without a matching constraint.",
  "type": "object",
  "properties": {
    "clusterProfile": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "instances": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Instance count for this data tier. null (the default) = the cluster profile's count (clusterProfileInstances); an explicit integer wins over the profile."
            }
          }
        },
        "arangodb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "keycloak": {
          "type": "object",
          "properties": {
            "bruteForceProtected": {
              "type": "boolean"
            },
            "convergence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "duplicateEmailsAllowed": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "failOnPlaceholderSecrets": {
              "type": "boolean"
            },
            "hostname": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean"
                }
              }
            },
            "http": {
              "type": "object",
              "properties": {
                "httpEnabled": {
                  "type": "boolean"
                }
              }
            },
            "internationalizationEnabled": {
              "type": "boolean"
            },
            "loginWithEmailAllowed": {
              "type": "boolean"
            },
            "registrationAllowed": {
              "type": "boolean"
            },
            "resetPasswordAllowed": {
              "type": "boolean"
            },
            "startOptimized": {
              "type": "boolean"
            },
            "verifyEmail": {
              "type": "boolean"
            },
            "instances": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Instance count for this data tier. null (the default) = the cluster profile's count (clusterProfileInstances); an explicit integer wins over the profile."
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "traces": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "envoyGateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "createGatewayClass": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "translation": {
              "type": "object",
              "properties": {
                "streamingEnabled": {
                  "type": "boolean"
                }
              }
            },
            "securityContext": {
              "type": "object",
              "properties": {
                "runAsNonRoot": {
                  "type": "boolean"
                },
                "allowPrivilegeEscalation": {
                  "type": "boolean"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Pod count. 0 is the documented way to scale a tier off; a non-numeric value would be coerced by the template's int conversion into 0 \u2014 a silent scale-to-zero \u2014 so the type is pinned here."
            }
          }
        },
        "frontend": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "securityContext": {
              "type": "object",
              "properties": {
                "runAsNonRoot": {
                  "type": "boolean"
                },
                "allowPrivilegeEscalation": {
                  "type": "boolean"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Pod count. 0 is the documented way to scale a tier off; a non-numeric value would be coerced by the template's int conversion into 0 \u2014 a silent scale-to-zero \u2014 so the type is pinned here."
            }
          }
        },
        "documentRepository": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "securityContext": {
              "type": "object",
              "properties": {
                "runAsNonRoot": {
                  "type": "boolean"
                },
                "allowPrivilegeEscalation": {
                  "type": "boolean"
                }
              }
            },
            "virusScanning": {
              "type": "boolean"
            },
            "pvc": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Pod count. 0 is the documented way to scale a tier off; a non-numeric value would be coerced by the template's int conversion into 0 \u2014 a silent scale-to-zero \u2014 so the type is pinned here."
            }
          }
        },
        "clamav": {
          "type": "object",
          "properties": {
            "cache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Pod count. 0 is the documented way to scale a tier off; a non-numeric value would be coerced by the template's int conversion into 0 \u2014 a silent scale-to-zero \u2014 so the type is pinned here."
            }
          }
        },
        "redisCache": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pvc": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Pod count. 0 is the documented way to scale a tier off; a non-numeric value would be coerced by the template's int conversion into 0 \u2014 a silent scale-to-zero \u2014 so the type is pinned here."
            }
          }
        }
      }
    },
    "opea": {
      "type": "object",
      "properties": {
        "chatqna": {
          "type": "object",
          "properties": {
            "chatqnaEnforceAbstention": {
              "type": "boolean"
            },
            "retrieverArangoTraversalEnabled": {
              "type": "boolean"
            }
          }
        },
        "dataprep": {
          "type": "object",
          "properties": {
            "contextualRetrievalEnabled": {
              "type": "boolean"
            },
            "contextualLabelRaw": {
              "type": "boolean"
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "gpu": {
          "type": "object",
          "properties": {
            "skipTlsVerify": {
              "type": "boolean"
            }
          }
        },
        "models": {
          "type": "object",
          "properties": {
            "cache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "retriever": {
          "type": "object",
          "properties": {
            "retrieverArangoTraversalEnabled": {
              "type": "boolean"
            },
            "retrieverHybridRetrievalEnabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "clusterProfileInstances": {
      "type": "object",
      "description": "clusterProfile-driven instance counts for the data tier (Keycloak, Postgres). An explicit data.<tier>.instances wins over these.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "clusterProfileReplicas": {
      "type": "object",
      "description": "clusterProfile-driven replica overrides. The profile WINS over services.<svc>.replicas (that value is a baseline).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
