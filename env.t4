# GPU Configuration for NVIDIA T4 (16GB VRAM)
# Usage: docker compose --env-file env.t4 up

# ========= GPU SETTINGS (T4 - 16GB VRAM - Conservative) =========
# Override defaults from docker-compose.yaml for T4 optimization

# Main LLM (vllm)
VLLM_GPU_UTILIZATION=0.4
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=64
VLLM_DTYPE=half

# Translation LLM (vllm-translation-guardrail)
VLLM_TRANSLATION_GPU_UTILIZATION=0.3
VLLM_TRANSLATION_MAX_MODEL_LEN=2048
VLLM_TRANSLATION_MAX_NUM_SEQS=16
VLLM_TRANSLATION_KV_CACHE_DTYPE=fp8
VLLM_TRANSLATION_DTYPE=half
