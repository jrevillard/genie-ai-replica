            "action": {
              "visibleText": "quickhelp.payTaxesUserPrompt",
              "hiddenPrompt": "quickhelp.payTaxesPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
            "id": "soil-fertility",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/soil-fertility.svg"
            },
            "category": null,
            "categoryNameEN": "Soil fertility",
            "action": {
              "visibleText": "quickhelp.startBusinessUserPrompt",
              "hiddenPrompt": "quickhelp.startBusinessPrompt"
            },
            "styles": {
              "backgroundColor": "#D3E0EA",
              "hoverColor": "#A3BFFA",
              "outlineColor": "#87CEEB"
            }
          },
          {
