<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode splash — deep brand-tinted verde background.
         iconBackgroundColor is transparent so the verde slot shows
         through unclamped (no white-circle mask from Android 12+). -->
    <style name="LaunchSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/launch_image</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
</resources>
