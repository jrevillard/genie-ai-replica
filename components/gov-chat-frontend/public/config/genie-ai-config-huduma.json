            "title": "quickhelp.payTaxes",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/taxes-revenue.svg"
            },
            "category": "5",
            "prompt": "quickhelp.payTaxesPrompt",
            "styles": {
              "backgroundColor": "#fff7ed",
              "hoverColor": "#ffedd5",
              "outlineColor": "#fed7aa"
            }
          },
          {
            "id": "business-trade",
            "title": "quickhelp.startBusiness",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/business-trade.svg"
            },
            "category": "8",
            "prompt": "quickhelp.startBusinessPrompt",
            "styles": {
              "backgroundColor": "#f5f3ff",
              "hoverColor": "#ede9fe",
              "outlineColor": "#ddd6fe"
            }
          },
          {
            "id": "healthcare-social",
            "title": "quickhelp.findHealthcare",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/healthcare-social.svg"
            },
            "category": "2",
            "prompt": "quickhelp.findHealthcarePrompt",
            "styles": {
              "backgroundColor": "#fef2f2",
              "hoverColor": "#fee2e2",
              "outlineColor": "#fecaca"
            }
          },
          {
            "id": "education-learning",
            "title": "quickhelp.educationServices",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/education-learning.svg"
            },
            "category": "3",
            "prompt": "quickhelp.educationServicesPrompt",
            "styles": {
              "backgroundColor": "#eff6ff",
              "hoverColor": "#dbeafe",
              "outlineColor": "#bfdbfe"
            }
          },
          {
            "id": "transportation-mobility",
            "title": "quickhelp.transportLicenses",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/transportation-mobility.svg"
            },
            "category": "7",
            "prompt": "quickhelp.transportLicensesPrompt",
            "styles": {
              "backgroundColor": "#f5f3ff",
              "hoverColor": "#ede9fe",
              "outlineColor": "#ddd6fe"
            }
          },
          {
            "id": "housing-urban",
            "title": "quickhelp.housingPrograms",
            "icon": {
              "type": "file",
              "value": "/config/quickhelp/housing-urban.svg"
            },
            "category": "9",
            "prompt": "quickhelp.housingProgramsPrompt",
            "styles": {
              "backgroundColor": "#ecfeff",
