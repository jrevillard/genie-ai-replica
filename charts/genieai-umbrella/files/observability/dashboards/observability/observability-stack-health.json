{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Health monitoring for the GENIE.AI observability stack (OTel Collector, VictoriaMetrics, VictoriaLogs, VictoriaTraces).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Service Uptime",
      "description": "Uptime of observability services.",
      "type": "stat",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "vm_app_uptime_seconds",
          "legendFormat": "{{ service_name }}",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "Trace Pipeline",
      "description": "Trace ingestion requests received over 5 minutes.",
      "type": "stat",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "req / 5m",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(increase(vt_http_requests_total{path=\"/insert/opentelemetry/v1/traces\"}[5m]))",
          "legendFormat": "Trace inserts",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "VictoriaMetrics Storage",
      "description": "Disk usage and row count for VictoriaMetrics.",
      "type": "stat",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 800000000000
              },
              {
                "color": "red",
                "value": 900000000000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Rows stored"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(vm_data_size_bytes{job=\"victoriametrics\"})",
          "legendFormat": "Data size",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum(vm_rows{job=\"victoriametrics\"})",
          "legendFormat": "Rows stored",
          "refId": "B",
          "datasource": {
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "vm_free_disk_space_bytes{job=\"victoriametrics\"}",
          "legendFormat": "Free disk",
          "refId": "C",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "Disk Usage %",
      "description": "Percentage of disk space used on the VictoriaMetrics volume.",
      "type": "gauge",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "1 - (vm_free_disk_space_bytes{job=\"victoriametrics\"} / vm_total_disk_space_bytes{job=\"victoriametrics\"})",
          "legendFormat": "Disk usage",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "OTel Collector Throughput",
      "description": "Data received by the OTel Collector from all receivers (metrics, logs, traces).",
      "type": "timeseries",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))",
          "legendFormat": "Metric points/s",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[5m]))",
          "legendFormat": "Log records/s",
          "refId": "B",
          "datasource": {
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))",
          "legendFormat": "Trace spans/s",
          "refId": "C",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "VictoriaMetrics Ingestion Rate",
      "description": "Rate of rows ingested by VictoriaMetrics, broken down by ingestion type.",
      "type": "timeseries",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      },
      "targets": [
        {
          "expr": "rate(vm_rows_inserted_total[5m])",
          "legendFormat": "{{ type }}",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "VictoriaLogs Ingestion Rate",
      "description": "Log records received by the OTel Collector from the Docker fluentd logging driver.",
      "type": "timeseries",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{receiver=\"fluent_forward\"}[5m]))",
          "legendFormat": "Log ingestion rate",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "VictoriaTraces Export",
      "description": "Trace spans exported to VictoriaTraces and export errors.",
      "type": "timeseries",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Export errors"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": "red"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m]))",
          "legendFormat": "Spans exported/s",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum(rate(vt_http_errors_total{path=\"/insert/opentelemetry/v1/traces\"}[5m]))",
          "legendFormat": "Export errors",
          "refId": "B",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "title": "Query Latency \u2014 VictoriaMetrics",
      "description": "Average request latency for VictoriaMetrics.",
      "type": "timeseries",
      "datasource": {
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      },
      "targets": [
        {
          "expr": "rate(vm_http_request_duration_seconds_sum{job=\"victoriametrics\"}[5m]) / rate(vm_http_request_duration_seconds_count{job=\"victoriametrics\"}[5m])",
          "legendFormat": "{{ path }}",
          "refId": "A",
          "datasource": {
            "uid": "victoriametrics"
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "observability",
    "genie-ai"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
