{
  "_format_version": "3.0",
  "services": [
    {
      "name": "express-api",
      "protocol": "http",
      "host": "${EXPRESS_API_HOST}",
      "port": ${EXPRESS_API_PORT},
      "path": null,
      "connect_timeout": 60000,
      "read_timeout": 60000,
      "write_timeout": 60000,
      "retries": 5,
      "enabled": true
    },
    {
      "name": "document-repository",
      "protocol": "http",
      "host": "${DOC_REPO_HOST}",
      "port": ${DOC_REPO_PORT},
      "path": null,
      "connect_timeout": 60000,
      "read_timeout": 60000,
      "write_timeout": 60000,
      "retries": 5,
      "enabled": true,
      "tags": ["new"]
    }
  ],
  "routes": [
    {
      "name": "api-fallback",
      "service": { "name": "express-api" },
      "paths": ["/api"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 0,
      "protocols": ["http", "https"],
      "plugins": [
        {
          "name": "request-transformer",
          "enabled": true,
          "config": { "add": { "headers": ["X-Kong-Proxy: true"] } }
        },
        {
          "name": "rate-limiting",
          "enabled": true,
          "config": { "minute": 1000, "hour": 10000, "policy": "local", "limit_by": "consumer" }
        },
        {
          "name": "cors",
          "enabled": true,
          "config": {
            "origins": ["${CORS_ALLOWED_ORIGINS}"],
            "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
            "headers": ["Accept", "Accept-Version", "Content-Length", "Content-MD5", "Content-Type", "Date", "X-Auth-Token", "Authorization"],
            "credentials": true,
            "max_age": 3600
          }
        },
        {
          "name": "file-log",
          "enabled": true,
          "config": { "path": "/var/log/kong/api.log", "reopen": true }
        }
      ]
    },
    {
      "name": "auth-route",
      "service": { "name": "express-api" },
      "paths": ["/api/auth"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 1,
      "protocols": ["http", "https"]
    },
    {
      "name": "auth-refresh-route",
      "service": { "name": "express-api" },
      "paths": ["/api/auth/refresh-token"],
      "methods": ["POST"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 100,
      "protocols": ["http", "https"]
    },
    {
      "name": "auth-login-route",
      "service": { "name": "express-api" },
      "paths": ["/api/auth/login"],
      "methods": ["POST"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 100,
      "protocols": ["http", "https"]
    },
    {
      "name": "files-route",
      "service": { "name": "document-repository" },
      "paths": ["/api/files"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 100,
      "protocols": ["http", "https"],
      "tags": ["new"]
    },
    {
      "name": "labels-route",
      "service": { "name": "document-repository" },
      "paths": ["/api/labels"],
      "strip_path": false,
      "preserve_host": true,
      "regex_priority": 100,
      "protocols": ["http", "https"],
      "tags": ["new"]
    }
  ],
  "upstreams": [
    {
      "name": "express-api-servers",
      "algorithm": "round-robin",
      "slots": 10000
    }
  ],
  "targets": [
    {
      "target": "${EXPRESS_API_HOST}:${EXPRESS_API_PORT}",
      "upstream": { "name": "express-api-servers" }
    }
  ]
}
