{
  "name": "gov-chat-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "eslint --max-warnings 999 src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --check \"src/**/*.{js,vue,json,css,scss}\"",
    "format:fix": "prettier --write \"src/**/*.{js,vue,json,css,scss}\"",
    "prepare": "cd ../.. && husky components/gov-chat-frontend/.husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "apexcharts": "^4.5.0",
    "assert": "^2.1.0",
    "axios": "^0.27.2",
    "browserify-zlib": "^0.2.0",
    "buffer-browserify": "^0.2.5",
    "crypto-browserify": "^3.12.1",
    "d3": "^7.9.0",
    "dompurify": "^3.2.6",
    "echarts": "^5.6.0",
    "jsdom": "^26.1.0",
    "jspdf": "^3.0.1",
    "livekit-client": "^2.6.0",
    "marked": "^15.0.12",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "vue": "^3.2.0",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.0.0",
    "vue3-apexcharts": "^1.8.0",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@vue/cli-service": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.23.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix --max-warnings 999",
      "prettier --write"
    ],
    "src/**/*.{json,css,scss}": [
      "prettier --write"
    ]
  }
}
