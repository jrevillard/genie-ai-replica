    "You have unsaved changes. Do you want to discard them and load the selected conversation, or save the current conversation first?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك تغييرات غير محفوظة. هل تريد تجاهلها وتحميل المحادثة المحددة، أم حفظ المحادثة الحالية أولاً؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast ungespeicherte Änderungen. Möchtest du sie verwerfen und die ausgewählte Unterhaltung laden oder die aktuelle Unterhaltung zuerst speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have unsaved changes. Do you want to discard them and load the selected conversation, or save the current conversation first?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes cambios sin guardar. ¿Quieres descartarlos y cargar la conversación seleccionada, o guardar la actual primero?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des modifications non enregistrées. Voulez-vous les ignorer et charger la conversation sélectionnée, ou enregistrer la conversation actuelle d'abord ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memiliki perubahan yang belum disimpan. Apakah Anda ingin membuangnya dan memuat percakapan yang dipilih, atau menyimpan percakapan saat ini terlebih dahulu?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem alterações não salvas. Deseja descartá-las e carregar a conversa selecionada ou salvar a conversa atual primeiro?"
          }
        },
        "ru" : {
          "stringUnit" : {
