# GENIE.AI — Textgen wrapper (extends upstream OPEA image)
# Adds genie_ssl_patch.py for SSL bypass (remote GPU node support).
# Only active when OPEA_SSL_SKIP_VERIFY=1 env var is set.
# The patch is installed via a .pth site-init hook at a build-derived
# site-packages path (install_site_startup.sh) — no hardcoded python3.x path.

ARG UPSTREAM_IMAGE=opea/llm-textgen:1.5
FROM ${UPSTREAM_IMAGE}

# The opea/llm-textgen:1.5 base runs as a non-root USER; the .pth site-init hook
# must write into the interpreter's site-packages, so run the install as root
# then restore the base image's runtime user.
USER root
# Security-patch the pinned OPEA base snapshot (Debian 13.2): pull current
# security updates from the trixie repo. The upstream image's openssl
# (3.5.4-1~deb13u1) lags the repo (3.5.7-1~deb13u2, fixes CVE-2026-31789); the
# distro upgrade touches only apt-managed packages, not the /usr/local Python.
COPY --chmod=0755 genie-ai-overlay/build-patches/install_site_startup.sh /app/install_site_startup.sh
COPY configs/ssl/genie_ssl_patch.py /app/genie_ssl_patch.py
RUN /app/install_site_startup.sh

# The OS packages are refreshed by a separate, bustable layer: the monthly
# rebuild passes --build-arg CACHE_BUST=<timestamp>, and a layer that takes
# that argument is the only one whose cache key changes.
#
# Position: after the expensive layers (what sits above it stays cached — a
# layer's cache key includes its parent), before the writes to package-owned
# paths (a package that moves would restore its own files over ours), and
# still root.
ARG CACHE_BUST=0
RUN CACHE_BUST=$CACHE_BUST apt-get update -y -o Acquire::Retries=5 && \
    apt-get upgrade -y --with-new-pkgs --fix-missing -o Acquire::Retries=5 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
USER user
