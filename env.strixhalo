# GPU Configuration for AMD Strix Halo (Radeon 8060S iGPU, gfx1151, unified memory)
# Usage:
#   docker compose --env-file env.strixhalo \
#     -f docker-compose.yaml -f docker-compose.rocm.yaml \
#     --profile opea --profile gpu-models up -d
#
# Values measured on the reference machine (Ryzen AI MAX+ 395, 91 GB unified
# RAM, GTT aperture 45.8 GiB) — see docs/superpowers/specs/
# 2026-11-11-rocm-gpu-tier-spike-results.md for the measurements behind
# every number. The GTT is carved from system RAM: the GPU-tier claims
# below coexist with other workloads on the host.

# ========= Image pins (ROCm path) =========
# Main + translation LLM: ROCm 10.1 build of vLLM 0.29.x — version parity
# with the NVIDIA pin (vllm/vllm-openai:v0.29.0). Verified serving both
# models with guided JSON in the spike.
VLLM_ROCM_IMAGE=rocm/vllm:rocm10.1.0_ubuntu24.04_py3.14-pytorch_2.13.0_vllm-0.29.0
# TEI: the ROCm image fails on gfx1151 (Instinct-only kernels) — CPU image
# per the spike decision. bge-scale models on 32 cores are ample and claim
# no GTT.
TEI_ROCM_EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3
TEI_ROCM_RERANKING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3

# ========= Main LLM (vllm) — dedicated-host sizing (2026-11-18) =========
# Operator decision 2026-11-18: the GPU is now DEDICATED (the other GENIE
# stack was shut down). Aperture 32 GiB GTT; the radeon desktop (Wayland)
# holds ~1.5 GiB and can grow under load — plan ~29.5 GiB of model claims
# against the 32 GiB aperture. Translation stays gemma-3-1b-it (0.12) and
# the reranker + embedding instances stay 0.05 each per the operator's
# no-translation-upgrade ruling; the freed budget goes to the LLM.
# granite-4.1-8b: 8.79B params → ~17.6 GiB fp16 weights; granite-4 is a
# hybrid mamba/attention architecture so the KV cache per token is small.
# 0.66 claims ~21.1 GiB → ~2.4 GiB KV at a 32768 window. Fleet claims:
# LLM 21.1 + translation 3.8 + reranker 1.6 + embedding 1.6 ≈ 28.1 GiB,
# ~1.4 GiB headroom under the 29.5 planning line. MEASURED at first boot
# (2026-11-18): weights 15.64 GiB, KV cache 14.08 GiB = 92,256 tokens,
# max concurrency 2.82x at 32,768-token requests, engine init 374 s.
# The engine note (vLLM 0.29): full utilization of the 45.84 GiB device
# view would want --kv-cache-memory=20.94 GiB — NOT taken; the operator's
# 32 GB budget line stands. Guided-JSON labeling probe + chat probe both
# pass on this model. (Shared-era history: granite-3.1-2b 0.28/49152
# under the 27 GB coexistence ceiling.)
VLLM_LLM_MODEL_ID=ibm-granite/granite-4.1-8b
VLLM_GPU_UTILIZATION=0.66
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=16
VLLM_DTYPE=half

# ========= Translation LLM (vllm-translation-guardrail) =========
# gemma-3-1b-it (~2 GiB bf16 weights): 0.12 claims ~5.5 GiB — weights
# plus an 8192-window KV cache with margin. Verified in the coexistence
# probe.
VLLM_TRANSLATION_GPU_UTILIZATION=0.12
VLLM_TRANSLATION_MAX_MODEL_LEN=8192
VLLM_TRANSLATION_MAX_NUM_SEQS=16
VLLM_TRANSLATION_DTYPE=auto

# ========= Docling =========
# Dataprep's docling runs CPU-side on the ROCm path (no docling ROCm
# support; the CUDA probe in dataprep would otherwise warn and fall back).
DOCLING_DEVICE=cpu

# ========= TEI CPU footprint =========
# TEI runs the CPU image here (the ROCm build fails on gfx1151 — see the
# spike results). The base compose's batch knobs assume GPU-side TEI;
# on CPU they inflate candle's buffer pools (the reranker measured
# 16.3 GiB RSS at 8192/32). Capping them cuts the footprint ~3x with
# no quality effect — batching depth is throughput, not accuracy.
TEI_RERANKING_MAX_BATCH_TOKENS=2048
TEI_RERANKING_MAX_CONCURRENT_REQUESTS=8
TEI_EMBEDDING_MAX_BATCH_TOKENS=2048
# bge-reranker-v2-m3's max input is 8192 tokens; with a 2048 batch cap TEI
# requires truncation enabled (chunks are ~500 chars — truncation is
# theoretical in the RAG path).
TEI_RERANKING_AUTO_TRUNCATE=true

# ========= Host ports for a shared machine =========
# The reference machine already hosts other stacks on 80/443/8529 — the
# ROCm venues publish on free ports (audit in the spike-results doc).
# NGINX_HTTP_PORT/NGINX_HTTPS_PORT/ARANGO_PORT serve the single-server
# main-stack venue; GPU_HTTP(S)_PORT serve the split GPU-node venue
# (docker-compose.gpu.yaml + its ROCm overlay). Drop or adjust on a
# dedicated ROCm host.
NGINX_HTTP_PORT=8180
NGINX_HTTPS_PORT=8443
ARANGO_PORT=18529
GPU_HTTPS_PORT=18443
GPU_HTTP_PORT=8181

# ========= Model IDs =========
# VLLM_LLM_MODEL_ID is pinned in the Main LLM block above (dedicated-host
# sizing, 2026-11-18). Translation stays on the spike's measured model per
# the operator's no-translation-upgrade ruling.
VLLM_TRANSLATION_MODEL_ID=google/gemma-3-1b-it

# ========= Device group GIDs (distro-specific) =========
# `getent group render video` on the GPU host. Defaults match the
# reference Ubuntu host (render=990, video=44).
RENDER_GID=990
VIDEO_GID=44

# ========= vLLM reranker backend (Task 14) =========
# The TEI ROCm image cannot run on gfx1151 (Instinct-only kernels — see the
# spike results), so the reranker is served by a THIRD vLLM instance on the
# GPU, and the reranker wrapper is switched to it by config. TEI stays the
# default backend everywhere else (RERANKER_BACKEND unset = tei = NVIDIA
# path unchanged). The response normalization and the request-shape switch
# live in the reranker component (genieai_tei_reranker.py).
RERANKER_BACKEND=vllm
# The overlay network name of the vLLM reranker instance (compose service
# `vllm-reranker`); the split GPU-node topology overrides this to the node's
# published address.
RERANKER_VLLM_ENDPOINT=http://vllm-reranker:8000
# The cross-encoder served by the instance. vLLM calls the score field
# `relevance_score` (Cohere shape); the wrapper normalizes it.
VLLM_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_VLLM_MODEL=BAAI/bge-reranker-v2-m3
# ~2.3 GiB of the GTT at 0.05 (568M-param bf16 weights + activation) —
# spike-measured 1.56 GiB touched. Sits inside the dedicated-host budget
# beside granite-4.1-8b (0.66) + gemma (0.12).
VLLM_RERANKER_GPU_UTILIZATION=0.05
VLLM_RERANKER_MAX_MODEL_LEN=8192

# ========= vLLM embedding backend (Task-14 mirror) =========
# Same story as the reranker above: the TEI ROCm image cannot run on gfx1151
# and the CPU TEI embedder saturates ~24 cores under concurrent ingest, so
# embeddings are served by their own vLLM instance on the GPU serving
# bge-large-en-v1.5 as a pooling model (OpenAI shape,
# POST /v1/embeddings {model, input} → data[].embedding — spike-verified).
# Both consumers move together (dataprep embeds the corpus, the retriever
# embeds the queries — a split would mix vector spaces in one collection).
# TEI stays the default backend on every other deployment
# (EMBEDDING_BACKEND unset = tei = NVIDIA path unchanged).
EMBEDDING_BACKEND=vllm
# The overlay network name of the vLLM embedding instance (compose service
# `vllm-embedding`). The split GPU-node topology has NO vllm-embedding
# service — the node's /embed/ route stays TEI (CPU), so split-venue
# embeddings are TEI by design and no node-side override exists.
EMBEDDING_VLLM_ENDPOINT=http://vllm-embedding:8000
