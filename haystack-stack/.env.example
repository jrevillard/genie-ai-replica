# ============================================
# AMINA Environment Configuration — TEAM template
# ============================================
#
# UNICC TESTERS / EVALUATORS:
#   You do NOT need this file. Just run from the repo root:
#     PowerShell: .\start.ps1
#     Bash:       ./start.sh
#   Demo defaults (in haystack-stack/.env.defaults) are used
#   automatically.
#
# TEAM DEVELOPERS (real API keys):
#   1. cp haystack-stack/.env.example haystack-stack/.env
#   2. Fill in real values below
#   3. Run .\start.ps1 from the repo root
#   4. NEVER commit your .env file (gitignored + pre-commit hook)
#
# ============================================

# === API service ports ===
API_HOST=0.0.0.0
API_PORT=8000
DATAPREP_PORT=8001

# === LLM (required for full functionality) ===
GOOGLE_API_KEY=CHANGE_ME_OR_LEAVE_DISABLED
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_DISABLED
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=

# === ArcadeDB ===
ARCADEDB_URL=http://arcadedb:2480
ARCADEDB_DB=genie
ARCADEDB_USER=root
ARCADEDB_PASSWORD=CHANGE_ME
ARCADEDB_ROOT_PASSWORD=CHANGE_ME

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Auth ===
AMINA_ENV=development
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_STRING_AT_LEAST_32_BYTES
JWT_EXPIRY_HOURS=168
OTP_DEV_MODE=true

# === Admin (the API hashes neither today — change defaults) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# === Voice (local containers — no external creds) ===
WHISPER_URL=http://voice-stt:8080
TTS_URL=http://voice-tts:5500
MMS_TTS_URL=http://voice-tts-mnk:5500

# === Translator backend ===
USE_GEMMA_TRANSLATOR=false
GEMMA_BASE_URL=http://vllm-translation-guardrail:9031/v1
GEMMA_MODEL=google/gemma-3-4b-it
GEMMA_API_KEY=not-needed

# === Channels (optional — leave 'disabled' if not in use) ===
TELEGRAM_BOT_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
META_APP_SECRET=CHANGE_ME_OR_LEAVE_DISABLED
META_VERIFY_TOKEN=amina_health_2026
META_PAGE_ACCESS_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
META_APP_ID=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_ACCOUNT_SID=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_AUTH_TOKEN=CHANGE_ME_OR_LEAVE_DISABLED
TWILIO_PHONE_NUMBER=CHANGE_ME_OR_LEAVE_DISABLED

# === DHIS2 (optional) ===
DHIS2_BASE_URL=CHANGE_ME_OR_LEAVE_DISABLED
DHIS2_USERNAME=CHANGE_ME_OR_LEAVE_DISABLED
DHIS2_PASSWORD=CHANGE_ME_OR_LEAVE_DISABLED

# === Superset ===
SUPERSET_SECRET_KEY=CHANGE_ME
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# === Production-blocked dev bypass flags (must be false in prod) ===
CHATQNA_ADMIN_MV_OPEN=false
CARE_TRUST_BODY_ROLE=false
DHIS2_DEV_ADMIN_BYPASS=false

# === Feature flags ===
AMINA_AGENTIC_MODE=assist
AMINA_AGENTIC_FAIL_OPEN=true
# Translation v3.5 / v4.2. Default ON: the NLLB sidecar handles
# Mandinka without provider API keys, so v4 works in demo mode too.
# Set to false if you want the v1 path (legacy translator + corrector).
AMINA_TRANSLATION_V4_ENABLED=true

# === Translation v4.2 (NLLB sidecar) ===
NLLB_API_URL=http://nllb-translate:7860
NLLB_ENABLED=true
NLLB_TIMEOUT_MS=10000
BAMBARA_ADAPTER_ENABLED=true
V4_BACK_TRANSLATION_PREFER_NLLB=true
V4_TELEMETRY_ARCADEDB=true
AMINA_CAREGIVER_PRIVACY_REQUIRED=false

DEMO_MODE=false

# === Abuse Defense (optional; default OFF — system is inert) ===
# The abuse-defense module catches abuse DIRECTED AT AMINA (insults,
# threats, coercion to violate clinical safety) without penalising
# health frustration ("this damn diabetes") or distress (suicidal
# ideation -> always returns crisis support, never escalates).
#
# Default mode is "off" — chat behaviour is byte-identical to before
# this module shipped. To activate progressively:
#   shadow  -> classify + log to JSONL only (no UX change)
#   warn    -> show WARNING_1/2/3 ladder; reset on cool-down decay
#   enforce -> add session_terminate (one-shot) and timed cool-downs
#              (1st: 30 min, 2nd: 24 h, 3rd+: 7 d). Admin-flag JSONL
#              row written when lifetime cool-downs >= threshold.
#
# Safety overrides that ALWAYS apply (regardless of mode):
#   - Emergency keywords (199, ambulance, heart attack, etc.) pass through
#   - Distress signals always return crisis-support copy
#   - is_minor=True users never escalate past WARNING_3
#
# Full docs: docs/compliance/ABUSE_DEFENSE_LOGIC_AND_TEST_RESULTS.md
# Cool-down wiring: docs/compliance/ABUSE_DEFENSE_COOLDOWN.md

# AMINA_ABUSE_DEFENSE_MODE=off          # off | shadow | warn | enforce
# AMINA_ABUSE_COOLDOWN_FIRST=1800       # 1st cool-down: 30 min (s)
# AMINA_ABUSE_COOLDOWN_SECOND=86400     # 2nd cool-down: 24 h  (s)
# AMINA_ABUSE_COOLDOWN_THIRD=604800     # 3rd+ cool-down: 7 d  (s)
# AMINA_ABUSE_COOLDOWN_DECAY=900        # warning ladder decay (15 min)
# AMINA_ABUSE_COERCIVE_FAST_TRACK=true  # coercive abuse skips one warning level
# AMINA_ABUSE_ADMIN_FLAG_THRESHOLD=3    # admin-notified after N lifetime cool-downs

# Phase G.1 — Semantic fallback (sentence-transformers + cosine similarity).
# Catches paraphrased abuse the regex catalog misses ("go bother someone else",
# "you're not even trying", "i'm done with you", etc.). Runs as a fallback
# layer ONLY — never overrides distress, frustration, or regex-detected abuse.
# Health-context guard prevents flipping clean health questions.
# AMINA_ABUSE_SEMANTIC_ENABLED=true        # set false to fall back to regex-only
# AMINA_ABUSE_SEMANTIC_THRESHOLD=0.62      # cosine similarity threshold (0..1)
# AMINA_ABUSE_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
